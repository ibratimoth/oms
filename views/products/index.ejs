<%- include('../layouts/header') %>

  <!-- <script src="https://cdn.jsdelivr.net/npm/bwip-js@3.4.3/dist/bwip-js-min.js"></script> -->
   <script src="/js/bwip-js-min.js"></script>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 non-printable">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-800">Products Inventory</h1>
      <p class="text-sm text-slate-500 mt-1">Manage stock entries, and corporate catalog pricing models.</p>
    </div>
    <div class="flex items-center flex-wrap gap-2">
      <button type="button" onclick="loadAndPrintAllLabels('thermal')"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-900 hover:bg-slate-950 text-white text-sm font-semibold rounded-lg shadow-sm transition duration-150 whitespace-nowrap">
        <i class="fas fa-scroll text-xs"></i> Print All (Thermal Roll)
      </button>

      <a href="/products/create"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-teal hover:bg-brand-tealDark text-white text-sm font-semibold rounded-lg shadow-sm shadow-brand-teal/10 transition duration-150 whitespace-nowrap">
        <i class="fas fa-plus text-xs"></i> Add Product
      </a>
    </div>
  </div>

  <div id="bulkActionBar"
    class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-slate-900 text-white px-6 py-3.5 rounded-xl shadow-xl border border-slate-800 flex items-center gap-6 animate-bounce-short non-printable">
    <div class="text-xs font-semibold tracking-wide">
      <span id="bulkSelectCount" class="bg-brand-teal text-white px-2 py-0.5 rounded-md mr-1.5 font-bold">0</span> items
      selected
    </div>
    <div class="h-4 w-px bg-slate-700"></div>
    <button type="button" onclick="executeBulkDelete()"
      class="inline-flex items-center gap-2 text-xs font-bold text-rose-400 hover:text-rose-300 transition duration-150">
      <i class="fas fa-trash-alt"></i> Delete Selected Entries
    </button>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 mb-6 non-printable">
    <form method="GET" action="/products" class="flex flex-col md:flex-row flex-wrap items-end gap-4">

      <div class="w-full md:w-64 min-w-[200px]">
        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
          <i class="fas fa-barcode text-brand-teal text-xs"></i> Hardware Scan Focus
        </label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-brand-teal">
            <i class="fas fa-camera text-xs"></i>
          </span>
          <input type="text" name="barcode" id="barcodeScanInput"
            value="<%= (typeof query !== 'undefined' && query.barcode) ? query.barcode : '' %>"
            placeholder="Flash item barcode..."
            class="w-full bg-teal-50/40 border border-teal-200 text-slate-700 font-mono rounded-lg pl-9 pr-3 py-1.5 text-sm focus:outline-none focus:border-brand-teal transition duration-150"
            autocomplete="off">
        </div>
      </div>

      <div class="w-full md:flex-1 min-w-[200px]">
        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Search Name</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
            <i class="fas fa-search text-xs"></i>
          </span>
          <input type="text" name="search"
            value="<%= (typeof query !== 'undefined' && query.search) ? query.search : '' %>"
            placeholder="Type product title..."
            class="w-full bg-slate-50 border border-slate-200 text-slate-700 rounded-lg pl-9 pr-3 py-1.5 text-sm focus:outline-none focus:border-brand-teal transition duration-150">
        </div>
      </div>

      <div class="w-full sm:flex-1 md:w-48 min-w-[150px]">
        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Stock Status</label>
        <select name="status"
          class="w-full bg-slate-50 border border-slate-200 text-slate-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-brand-teal transition duration-150">
          <% let selectedStatus = (typeof query !== 'undefined' && query.status) ? query.status : ''; %>
          <option value="" <%= selectedStatus === '' ? 'selected' : '' %>>All Inventory Statuses</option>
          <option value="available" <%= selectedStatus === 'available' ? 'selected' : '' %>>Available (Good Stock)</option>
          <option value="low" <%= selectedStatus === 'low' ? 'selected' : '' %>>Low Stock Alert</option>
        </select>
      </div>

      <div class="w-full sm:flex-1 md:w-52 min-w-[150px]">
        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Max Retail Price (TSh)</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-xs font-semibold text-slate-400">
            TSh
          </span>
          <input type="number" name="maxPrice"
            value="<%= (typeof query !== 'undefined' && query.maxPrice) ? query.maxPrice : '' %>"
            placeholder="Max price ceiling"
            class="w-full bg-slate-50 border border-slate-200 text-slate-700 rounded-lg pl-10 pr-3 py-1.5 text-sm focus:outline-none focus:border-brand-teal transition duration-150">
        </div>
      </div>

      <div class="w-full md:w-auto flex items-center gap-2 shrink-0 pt-2 md:pt-0">
        <button type="submit"
          class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 px-5 py-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-semibold rounded-lg transition duration-150 shadow-sm">
          <i class="fas fa-sliders-h text-xs text-slate-400"></i> Apply Filters
        </button>

        <a href="/products"
          class="inline-flex items-center justify-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-700 text-sm font-semibold rounded-lg border border-slate-200 transition duration-150">
          Clear
        </a>
      </div>

    </form>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6 non-printable">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse whitespace-nowrap">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-slate-400 text-xs font-bold uppercase tracking-wider">
            <th class="py-3.5 px-6 w-10">
              <input type="checkbox" id="masterCheckbox" onclick="toggleAllCheckboxes(this)"
                class="rounded border-slate-300 text-brand-teal focus:ring-brand-teal w-4 h-4 cursor-pointer">
            </th>
            <th class="py-3.5 px-6">Product Name</th>
            <th class="py-3.5 px-6">Tag</th>
            <th class="py-3.5 px-6">Barcode</th>
            <th class="py-3.5 px-6">Stock Status</th>
            <th class="py-3.5 px-6">Cost Price (Buy)</th>
            <th class="py-3.5 px-6">Retail Price (Sell)</th>
            <th class="py-3.5 px-6 text-right">Actions</th>
          </tr>
        </thead>

        <tbody class="text-sm divide-y divide-slate-100">
          <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
              <tr class="hover:bg-slate-50/70 transition duration-150 group">
                <td class="py-4 px-6 w-10">
                  <input type="checkbox" name="product_ids" value="<%= p.id %>" onchange="evaluateRowSelections()"
                    class="product-item-checkbox rounded border-slate-300 text-brand-teal focus:ring-brand-teal w-4 h-4 cursor-pointer">
                </td>
                <td class="py-4 px-6 font-medium text-slate-800">
                  <%= p.name %>
                </td>

                <td class="py-4 px-6">
                  <% if (p.barcode) { %>
                    <div class="flex flex-col gap-1">
                      <canvas class="table-barcode" data-value="<%= p.barcode %>"></canvas>
                    </div>
                  <% } else { %>
                    <span class="text-xs text-slate-400 italic">No Barcode</span>
                  <% } %>
                </td>

                <td class="py-4 px-6">
                  <%= p.barcode %>
                </td>

                <td class="py-4 px-6">
                  <% if (p.quantity_in_stock <= (p.reorder_level || 5)) { %>
                    <span
                      class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-100">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5 animate-pulse"></span>
                      <%= p.quantity_in_stock %> low stock
                    </span>
                  <% } else { %>
                    <span
                      class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                      <%= p.quantity_in_stock %> available
                    </span>
                  <% } %>
                </td>
                <td class="py-4 px-6 text-slate-600 font-mono text-xs">TSh <%= Number(p.buy_price || 0).toLocaleString() %></td>
                <td class="py-4 px-6 font-semibold text-slate-900 font-mono text-xs">TSh <%= Number(p.sell_price || 0).toLocaleString() %></td>
                <td class="py-4 px-6 text-right">
                  <div class="inline-flex items-center gap-2 opacity-90 group-hover:opacity-100 transition duration-150">
                    <% if (p.barcode) { %>
                      <button type="button"
                        onclick="openPrintModal('<%= p.barcode %>', '<%= p.name %>', 'TSh <%= Number(p.sell_price || 0).toLocaleString() %>')"
                        class="inline-flex items-center gap-1.5 bg-white hover:bg-teal-50 text-slate-600 hover:text-brand-teal py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-teal-200 rounded-md shadow-sm transition duration-150">
                        <i class="fas fa-print text-[10px]"></i> Label
                      </button>
                    <% } %>

                    <a href="/products/edit/<%= p.id %>"
                      class="inline-flex items-center gap-1.5 bg-white hover:bg-brand-gold/10 text-slate-600 hover:text-brand-goldHover py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-brand-gold/30 rounded-md shadow-sm transition duration-150">
                      <i class="fas fa-edit text-[10px]"></i> Edit
                    </a>
                    <!-- <a href="/products/delete/<%= p.id %>"
                      class="inline-flex items-center gap-1.5 bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-rose-200 rounded-md shadow-sm transition duration-150"
                      onclick="return confirm('Are you sure?')">
                      <i class="fas fa-trash-alt text-[10px]"></i> Delete
                    </a> -->
                    <a href="#" 
   data-url="/products/delete/<%= p.id %>"
   class="delete-btn inline-flex items-center gap-1.5 bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-rose-200 rounded-md shadow-sm transition duration-150">
   <i class="fa-solid fa-trash-can"></i> Delete
</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-12 text-center">
                <div class="text-slate-300 mb-2"><i class="fas fa-box-open text-4xl"></i></div>
                <p class="text-sm text-slate-400 italic">No products match your filter parameters.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex items-center justify-between">
          <div class="text-xs font-medium text-slate-500">
            Showing Page <span class="text-slate-800 font-bold"><%= currentPage %></span> of <span class="text-slate-800 font-bold"><%= totalPages %></span> pages
          </div>

          <div class="inline-flex items-center gap-1">
            <% if (currentPage > 1) { 
                let prevParams = new URLSearchParams();
                if (query.barcode) prevParams.set('barcode', query.barcode);
                if (query.search) prevParams.set('search', query.search);
                if (query.status) prevParams.set('status', query.status);
                if (query.maxPrice) prevParams.set('maxPrice', query.maxPrice);
                prevParams.set('page', currentPage - 1);
            %>
              <a href="/products?<%= prevParams.toString() %>"
                class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold transition duration-150">
                <i class="fas fa-chevron-left"></i>
              </a>
            <% } else { %>
              <span class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-200 bg-slate-100 text-slate-300 text-xs cursor-not-allowed">
                <i class="fas fa-chevron-left"></i>
              </span>
            <% } %>

            <% for(let i = 1; i <= totalPages; i++) { 
                let pageParams = new URLSearchParams();
                if (query.barcode) pageParams.set('barcode', query.barcode);
                if (query.search) pageParams.set('search', query.search);
                if (query.status) pageParams.set('status', query.status);
                if (query.maxPrice) pageParams.set('maxPrice', query.maxPrice);
                pageParams.set('page', i);
            %>
              <% if (i === currentPage) { %>
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-brand-teal text-white text-xs font-bold shadow-sm shadow-brand-teal/10">
                  <%= i %>
                </span>
              <% } else { %>
                <a href="/products?<%= pageParams.toString() %>"
                  class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-medium transition duration-150">
                  <%= i %>
                </a>
              <% } %>
            <% } %>

            <% if (currentPage < totalPages) { 
                let nextParams = new URLSearchParams();
                if (query.barcode) nextParams.set('barcode', query.barcode);
                if (query.search) nextParams.set('search', query.search);
                if (query.status) nextParams.set('status', query.status);
                if (query.maxPrice) nextParams.set('maxPrice', query.maxPrice);
                nextParams.set('page', currentPage + 1);
            %>
              <a href="/products?<%= nextParams.toString() %>"
                class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold transition duration-150">
                <i class="fas fa-chevron-right"></i>
              </a>
            <% } else { %>
              <span class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-200 bg-slate-100 text-slate-300 text-xs cursor-not-allowed">
                <i class="fas fa-chevron-right"></i>
              </span>
            <% } %>
          </div>
        </div>
    <% } %>
  </div>

  <div id="customPrintModal"
    class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 non-printable">
    <div
      class="bg-white rounded-xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden transform transition-all">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <h3 class="font-bold text-slate-800 flex items-center gap-2">
          <i class="fas fa-print text-brand-teal"></i> Barcode Sticker Label Preview
        </h3>
        <button type="button" onclick="closePrintModal()" class="text-slate-400 hover:text-slate-600 transition">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="p-8 flex justify-center items-center bg-slate-100">
        <div
          class="bg-white shadow-md border border-slate-300 p-4 rounded text-center w-[40mm] min-h-[30mm] flex flex-col items-center justify-center font-mono text-black">
          <div id="modalProductName" class="text-[9px] font-bold uppercase tracking-wide truncate w-full mb-1"></div>
          <canvas id="modalBarcodeCanvas"></canvas>
          <div id="modalProductPrice"
            class="text-[10px] font-bold mt-1 border-t border-dashed border-black pt-1 w-full"></div>
        </div>
      </div>

      <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closePrintModal()"
          class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-200 rounded-lg transition">
          Cancel
        </button>
        <button type="button" onclick="triggerHardwarePrint()"
          class="px-5 py-2 text-xs font-bold text-white bg-brand-teal hover:bg-brand-tealDark rounded-lg shadow transition flex items-center gap-2">
          <i class="fas fa-check"></i> Send to Thermal Printer
        </button>
      </div>
    </div>
  </div>

  <div id="customBulkPrintModal"
    class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 non-printable">
    <div
      class="bg-white rounded-xl shadow-xl border border-slate-200 w-full max-w-4xl overflow-hidden transform transition-all">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <h3 class="font-bold text-slate-800 flex items-center gap-2">
          <i class="fas fa-layer-group text-brand-teal"></i> <span id="bulkModalTitle">Bulk Print Layout Review</span>
        </h3>
        <button type="button" onclick="closeBulkPrintModal()" class="text-slate-400 hover:text-slate-600 transition">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="p-6 bg-slate-100 max-h-[60vh] overflow-y-auto justify-items-center" id="bulkModalStickersContainer">
      </div>

      <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
        <span class="text-xs text-slate-500 font-medium" id="bulkQueueCounterSummary">Total: 0 Items ready</span>
        <div class="flex items-center gap-3">
          <button type="button" onclick="closeBulkPrintModal()"
            class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-200 rounded-lg transition">
            Cancel
          </button>
          <button type="button" id="bulkPrintExecutionBtn" onclick="triggerBulkHardwarePrint()"
            class="px-5 py-2 text-xs font-bold text-white bg-slate-800 hover:bg-slate-900 rounded-lg shadow transition flex items-center gap-2">
            <i class="fas fa-print"></i> Execute Print Run
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="singlePrintProductionContainer" class="production-only-target">
    <div class="single-sticker-page">
      <div id="spProductName"
        style="font-size: 9px; font-weight: bold; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; margin-bottom: 2px;">
      </div>
      <canvas id="spBarcodeCanvas"></canvas>
      <div id="spProductPrice"
        style="font-size: 10px; font-weight: bold; margin-top: 2px; border-top: 1px dashed #000; padding-top: 1px; width: 90%; margin-left: auto; margin-right: auto;">
      </div>
    </div>
  </div>

  <div id="bulkPrintProductionContainer" class="production-only-target"></div>

  <style>
    /* --- PRINT STYLE OVERRIDES --- */
    @media print {
      body * {
        visibility: hidden;
      }

      #bulkPrintProductionContainer,
      #bulkPrintProductionContainer * {
        visibility: visible;
      }

      #bulkPrintProductionContainer {
        position: absolute;
        left: 0;
        top: 0;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        display: block !important;
      }

      body.printing-bulk-thermal {
        margin: 0 !important;
        padding: 0 !important;
      }

      body.printing-bulk-thermal .bulk-sticker-page {
        width: 40mm !important;
        height: 30mm !important;
        max-width: 40mm !important;
        max-height: 30mm !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;

        page-break-after: always !important;
        break-after: page !important;
        box-sizing: border-box !important;
        padding: 1.5mm !important;
        overflow: hidden !important;
      }

      @page {
        size: 40mm 30mm !important;
        margin: 0 !important;
      }
    }
  </style>

  <%- include('../layouts/footer') %>
    <!-- <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> -->
     <script src="/js/sweetalert2.all.min.js"></script>
    <script>
      let currentActiveBarcode = '';
      let currentBulkMode = 'grid';
      let productRows = [];

      <% if (products && products.length > 0) { %>
        <% products.forEach(p => { %>
          <% if (p.barcode) { %>
              productRows.push({
                barcode: `<%= p.barcode %>`,
                name: `<%= p.name %>`,
                price: `TSh <%= Number(p.sell_price || 0).toLocaleString() %>`
              });
          <% } %>
        <% }) %>
      <% } %>

      document.addEventListener("DOMContentLoaded", function () {
        const barcodeInput = document.getElementById("barcodeScanInput");
        if (barcodeInput) {
          barcodeInput.focus();
          if (barcodeInput.value !== '') barcodeInput.select();
        }

        // CHANGED: Implemented bwip-js rendering logic for table listings
        document.querySelectorAll('.table-barcode').forEach(function (canvas) {
          const val = canvas.getAttribute('data-value');
          
          if (val && val.trim() !== '' && val !== 'null') {
            try {
              bwipjs.toCanvas(canvas, {
                bcid:        'code128',       
                text:        val,             
                scaleX:      1,               
                scaleY:      1,               
                height:      8,               
                includetext: true,            
                textxalign:  'center',        
                textsize:    7                
              });
            } catch (e) {
              console.error("Table barcode drawing crash fallback:", e);
            }
          } else {
            canvas.style.display = 'none';
            const parent = canvas.parentElement;
            if (parent && !parent.querySelector('.no-barcode-text')) {
              const fallbackText = document.createElement('span');
              fallbackText.className = 'no-barcode-text text-[10px] text-slate-400 italic';
              fallbackText.innerText = 'No Barcode';
              parent.appendChild(fallbackText);
            }
          }
        });
      });

      function toggleAllCheckboxes(master) {
        const checkboxes = document.querySelectorAll('.product-item-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
        evaluateRowSelections();
      }

      function evaluateRowSelections() {
        const checkboxes = document.querySelectorAll('.product-item-checkbox');
        const checkedBoxes = document.querySelectorAll('.product-item-checkbox:checked');
        const bulkBar = document.getElementById('bulkActionBar');
        const counterDisplay = document.getElementById('bulkSelectCount');
        const masterCheckbox = document.getElementById('masterCheckbox');

        if (checkedBoxes.length === 0) {
          masterCheckbox.checked = false;
          masterCheckbox.indeterminate = false;
        } else if (checkedBoxes.length === checkboxes.length) {
          masterCheckbox.checked = true;
          masterCheckbox.indeterminate = false;
        } else {
          masterCheckbox.checked = false;
          masterCheckbox.indeterminate = true;
        }

        if (checkedBoxes.length > 0) {
          counterDisplay.textContent = checkedBoxes.length;
          bulkBar.classList.remove('hidden');
        } else {
          bulkBar.classList.add('hidden');
        }
      }

      function executeBulkDelete() {
        const checkedBoxes = document.querySelectorAll('.product-item-checkbox:checked');
        if (checkedBoxes.length === 0) return;

        Swal.fire({
          title: 'Are you absolutely sure?',
          text: `You are about to permanently delete ${checkedBoxes.length} selected items from inventory. This action cannot be undone!`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#e11d48',
          cancelButtonColor: '#64748b',
          confirmButtonText: '<i class="fas fa-trash-alt mr-1.5"></i> Yes, delete them!',
          cancelButtonText: 'Cancel',
          background: '#ffffff',
          customClass: {
            popup: 'rounded-xl border border-slate-200 shadow-xl',
            title: 'text-slate-800 font-bold text-lg',
            htmlContainer: 'text-slate-500 text-sm',
            confirmButton: 'px-5 py-2.5 text-xs font-bold text-white rounded-lg transition shadow-sm focus:outline-none focus:ring-2 focus:ring-rose-500/20',
            cancelButton: 'px-4 py-2.5 text-xs font-semibold text-white rounded-lg transition shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500/20'
          },
          buttonsStyling: true
        }).then((result) => {
          if (result.isConfirmed) {
            const idsToDelete = Array.from(checkedBoxes).map(cb => cb.value);
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/products/bulk-delete';

            idsToDelete.forEach(id => {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'productIds';
              input.value = id;
              form.appendChild(input);
            });
            document.body.appendChild(form);
            form.submit();
          }
        });
      }

      function openPrintModal(barcodeValue, productName, productPrice) {
        currentActiveBarcode = barcodeValue;
        document.getElementById('modalProductName').innerText = productName;
        document.getElementById('document.getElementById');
        document.getElementById('modalProductPrice').innerText = productPrice;

        // CHANGED: Replaced JsBarcode calls with 1:1 crisp bwipjs canvas injections
        try {
          bwipjs.toCanvas('modalBarcodeCanvas', {
            bcid:        'code128',
            text:        barcodeValue,
            scaleX:      1.2,
            scaleY:      1.2,
            height:      12,
            includetext: true,
            textxalign:  'center',
            textsize:    8,
            sizetofit:   true
          });
        } catch(e) { console.error(e); }

        document.getElementById('spProductName').innerText = productName;
        document.getElementById('spProductPrice').innerText = productPrice;

        try {
          bwipjs.toCanvas('spBarcodeCanvas', {
            bcid:        'code128',
            text:        barcodeValue,
            scaleX:      1,
            scaleY:      1,
            height:      10,
            includetext: true,
            textxalign:  'center',
            textsize:    8,
            sizetofit:   true
          });
        } catch(e) { console.error(e); }

        document.getElementById('customPrintModal').classList.remove('hidden');
      }

      function closePrintModal() {
        document.getElementById('customPrintModal').classList.add('hidden');
        document.body.classList.remove('printing-single');
      }

      function triggerHardwarePrint() {
        document.body.classList.add('printing-single');
        setTimeout(() => {
          window.print();
          setTimeout(() => { closePrintModal(); }, 200);
        }, 150);
      }

      async function loadAndPrintAllLabels(mode) {
        Swal.fire({
          title: 'Generating Labels...',
          text: 'Compiling all inventory barcodes across all pages.',
          allowOutsideClick: false,
          didOpen: () => { Swal.showLoading(); }
        });
        try {
          const response = await fetch('/products/all-printable');
          const allProducts = await response.json();

          if (!allProducts || allProducts.length === 0) {
            Swal.fire('No Printable Items', 'No products found with barcodes.', 'info');
            return;
          }

          const originalRows = productRows;
          productRows = allProducts.map(p => ({
            name: p.name,
            barcode: p.barcode,
            price: typeof p.sell_price === 'number' ? `TZS ${p.sell_price.toLocaleString()}` : p.sell_price
          }));
          
          Swal.close();
          openBulkPrintModal(mode);
          productRows = originalRows;
        } catch (error) {
          console.error(error);
          Swal.fire('Error', 'Could not load complete item records for printing.', 'error');
        }
      }

      function openBulkPrintModal(mode) {
        if (productRows.length === 0) {
          Swal.fire({
            title: 'No Printable Items',
            text: 'There are no products with registered barcode signatures available in this view to print.',
            icon: 'info',
            confirmButtonColor: '#0f172a',
            confirmButtonText: 'Understood'
          });
          return;
        }

        currentBulkMode = mode;
        const modalContainer = document.getElementById('bulkModalStickersContainer');
        const productionContainer = document.getElementById('bulkPrintProductionContainer');
        const modalTitle = document.getElementById('bulkModalTitle');

        modalContainer.innerHTML = '';
        productionContainer.innerHTML = '';
        
        if (mode === 'grid') {
          modalTitle.innerText = "Bulk Print Sheet Layout Review (A4 Grid Mode)";
          modalContainer.className = "p-6 bg-slate-100 max-h-[60vh] overflow-y-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 justify-items-center";
        } else {
          modalTitle.innerText = "Bulk Print Stream Layout Review (Continuous Thermal Mode)";
          modalContainer.className = "p-6 bg-slate-100 max-h-[60vh] overflow-y-auto flex flex-col items-center gap-4";
        }

        document.getElementById('bulkQueueCounterSummary').innerText = `Total: ${productRows.length} Items ready`;
        
        productRows.forEach((prod, index) => {
          // CHANGED: Updated preview arrays to hold HTML5 <canvas> fields for bwipjs mapping execution
          const previewCard = document.createElement('div');
          previewCard.className = "bg-white shadow border border-slate-300 p-4 rounded text-center w-[40mm] min-h-[30mm] flex flex-col items-center justify-center font-mono text-black shrink-0";
          previewCard.innerHTML = `
            <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; max-w-[36mm]; mb-1; w-full;">${prod.name}</div>
            <canvas id="modalBulkCanvas_${index}"></canvas>
            <div style="font-size: 10px; font-weight: bold; margin-top: 4px; border-t: 1px dashed #000; padding-top: 2px; width: 100%;">${prod.price}</div>
          `;
          modalContainer.appendChild(previewCard);

          try {
            bwipjs.toCanvas(`modalBulkCanvas_${index}`, {
              bcid:        'code128',
              text:        prod.barcode,
              scaleX:      1,
              scaleY:      1,
              height:      10,
              includetext: true,
              textxalign:  'center',
              textsize:    10,
              sizetofit:   true
            });
          } catch(e){ console.error(e); }

          const stickerDiv = document.createElement('div');
          stickerDiv.className = 'bulk-sticker-page';
          stickerDiv.innerHTML = `
            <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; margin-bottom: 2px; color: #000; font-family: monospace;">${prod.name}</div>
            <canvas id="bulkPrintCanvas_${index}"></canvas>
            <div style="font-size: 10px; font-weight: bold; margin-top: 2px; border-top: 1px dashed #000; padding-top: 1px; width: 100%; color: #000; font-family: monospace;">${prod.price}</div>
          `;
          productionContainer.appendChild(stickerDiv);

          // CHANGED: Draws sharp, 1-bit style lines that won't bleed under thermal heat
          try {
            bwipjs.toCanvas(`bulkPrintCanvas_${index}`, {
              bcid:        'code128',
              text:        prod.barcode,
              scaleX:      (mode === 'grid' ? 1.4 : 1), 
              scaleY:      (mode === 'grid' ? 1.4 : 1), 
              height:      10,
              includetext: true,
              textxalign:  'center',
              textsize:    10,
              sizetofit:   true
            });
          } catch(e){ console.error(e); }
        });

        document.getElementById('customBulkPrintModal').classList.remove('hidden');
      }

      function closeBulkPrintModal() {
        document.getElementById('customBulkPrintModal').classList.add('hidden');
        document.body.classList.remove('printing-bulk-grid', 'printing-bulk-thermal');
      }

      function triggerBulkHardwarePrint() {
        if (currentBulkMode === 'grid') {
          document.body.classList.add('printing-bulk-grid');
        } else {
          document.body.classList.add('printing-bulk-thermal');
        }

        setTimeout(() => {
          window.print();
          setTimeout(() => {
            closeBulkPrintModal();
            document.getElementById('bulkPrintProductionContainer').innerHTML = '';
          }, 300);
        }, 150);
      }

      document.addEventListener('DOMContentLoaded', function() {
    // 1. Attach a click event listener to the document wrapper (supports dynamic content)
    document.addEventListener('click', function(event) {
        // Find the closest ancestor matching the selector (handles clicking on nested text or icons)
        const deleteButton = event.target.closest('.delete-btn');
        
        if (deleteButton) {
            // 2. Prevent the link from instantly redirecting
            event.preventDefault();
            
            const deleteUrl = deleteButton.getAttribute('data-url');

            // 3. Fire the SweetAlert2 Modal
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this data!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48', // Tailwind rose-600 to match your hover style
                cancelButtonColor: '#64748b',  // Tailwind slate-500
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                // 4. If the user confirmed, redirect them to the backend endpoint
                if (result.isConfirmed) {
                    window.location.href = deleteUrl;
                }
            });
        }
    });
});
    </script>