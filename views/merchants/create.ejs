<%- include('../layouts/header') %>
<%
  const field = 'w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20';
  const label = 'mb-1.5 block text-sm font-medium text-slate-700';
  const providers = ['Vodacom', 'Tigo', 'Airtel', 'Halotel', 'NMB', 'CRDB'];
%>

<div class="mx-auto max-w-5xl space-y-6">

  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-slate-500">
    <a href="/merchants" class="group inline-flex items-center gap-2 font-medium transition-colors hover:text-brand-teal">
      <i class="fas fa-arrow-left text-xs transition-transform group-hover:-translate-x-0.5"></i>Merchants
    </a>
    <i class="fas fa-chevron-right text-[10px] text-slate-300"></i><span class="text-slate-700">Register</span>
  </nav>

  <% if (typeof error !== 'undefined' && error) { %>
    <div role="alert" class="flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 p-4">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-rose-100 text-rose-600"><i class="fas fa-exclamation-circle"></i></span>
      <div class="min-w-0"><h4 class="text-sm font-semibold text-rose-800">The merchant could not be registered</h4><p class="mt-0.5 text-sm text-rose-700"><%= error %></p></div>
    </div>
  <% } %>

  <div class="grid items-start gap-6 lg:grid-cols-3">

    <!-- ============ Form ============ -->
    <form id="merchantForm" method="POST" action="/merchants" class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white lg:col-span-2">
      <div class="space-y-8 p-6 sm:p-8">

        <div>
          <h2 class="text-xl font-bold tracking-tight text-brand-tealDark">Register a payment account</h2>
          <p class="mt-1 text-sm text-slate-500">Add a Lipa number, till or bank account so cashiers can record payments against it.</p>
        </div>

        <section>
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Account label</h3>
          <div class="mt-4">
            <label for="name" class="<%= label %>">Name</label>
            <input type="text" id="name" name="name" required autocomplete="off" placeholder="e.g. M-Pesa Lipa number, NMB till" class="<%= field %> px-3.5">
            <p class="mt-1.5 text-xs text-slate-500">A short name your cashiers will recognise when choosing where a payment went.</p>
          </div>
        </section>

        <section>
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Provider</h3>
          <div class="mt-4">
            <label for="provider" class="<%= label %>">Network or bank <span class="font-normal text-slate-400">(optional)</span></label>
            <input type="text" id="provider" name="provider" autocomplete="off" placeholder="e.g. Vodacom, NMB, CRDB" class="<%= field %> px-3.5">
            <div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Quick choices for provider">
              <span class="text-sm text-slate-500">Quick pick</span>
              <% providers.forEach(p => { %>
                <button type="button" data-provider="<%= p %>" class="chip rounded-full border border-slate-200 px-3 py-1 text-sm font-medium text-slate-600 transition-colors hover:border-brand-teal/40 hover:text-brand-teal"><%= p %></button>
              <% }) %>
            </div>
          </div>
        </section>

        <section>
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Number</h3>
          <div class="mt-4">
            <label for="account_number" class="<%= label %>">Lipa, till or account number <span class="font-normal text-slate-400">(optional)</span></label>
            <div class="relative">
              <i class="fas fa-hashtag pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
              <input type="text" id="account_number" name="account_number" inputmode="numeric" autocomplete="off" placeholder="e.g. 5543210" class="<%= field %> pl-9 pr-3.5 font-mono">
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Check it carefully. Customers will pay to this number.</p>
          </div>
        </section>
      </div>

      <div class="flex flex-col-reverse items-stretch justify-end gap-3 border-t border-slate-100 bg-slate-50/60 px-6 py-4 sm:flex-row sm:items-center sm:px-8">
        <a href="/merchants" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-center text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50">Cancel</a>
        <button type="submit" id="saveBtn" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-gold px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover disabled:cursor-wait disabled:opacity-70">
          <i class="fas fa-check text-xs"></i><span>Save merchant</span>
        </button>
      </div>
    </form>

    <!-- ============ Live preview ============ -->
    <aside class="space-y-4 lg:sticky lg:top-24">
      <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">
        <div class="h-1 bg-brand-gold"></div>
        <div class="bg-teal-50 px-6 py-4">
          <p class="text-xs font-medium text-brand-teal">Preview</p>
          <p class="mt-0.5 text-sm text-slate-600">This is how it will look.</p>
        </div>

        <div class="p-5">
          <div class="rounded-2xl border border-slate-200 p-5">
            <span id="pvInitial" class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-teal text-lg font-extrabold text-white">?</span>
            <h3 id="pvName" class="mt-4 truncate text-base font-bold text-slate-400">Merchant name</h3>
            <p id="pvProvider" class="mt-0.5 truncate text-sm text-slate-400">Provider not set</p>
            <div class="mt-4 rounded-xl bg-slate-50 px-3.5 py-2.5">
              <p class="text-xs text-slate-500">Account or till number</p>
              <p id="pvNumber" class="truncate font-mono text-sm font-semibold text-slate-400">Not set</p>
            </div>
          </div>

          <p class="mt-4 text-xs font-medium text-slate-500">In the payment list when completing an order</p>
          <p id="pvOption" class="mt-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-400">Merchant name</p>
        </div>
      </section>

      <p class="flex items-start gap-2 rounded-2xl bg-white px-5 py-4 text-sm text-slate-500 ring-1 ring-slate-200/80">
        <i class="fas fa-lightbulb mt-0.5 text-brand-gold"></i>
        <span>You can switch an account on or off later from the merchants list without deleting it.</span>
      </p>
    </aside>
  </div>
</div>

<script>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var name = $('name'), provider = $('provider'), number = $('account_number');

    function set(el, text, fallback) {
      var has = !!text; el.textContent = has ? text : fallback;
      el.classList.toggle('text-slate-400', !has);
      el.classList.toggle('text-slate-900', has && el.id === 'pvName');
      el.classList.toggle('text-slate-500', has && el.id === 'pvProvider');
      el.classList.toggle('text-slate-800', has && (el.id === 'pvNumber' || el.id === 'pvOption'));
    }

    function refresh() {
      var n = name.value.trim(), p = provider.value.trim(), a = number.value.trim();
      $('pvInitial').textContent = (p || n || '?').charAt(0).toUpperCase();
      set($('pvName'), n, 'Merchant name');
      set($('pvProvider'), p, 'Provider not set');
      set($('pvNumber'), a, 'Not set');

      /* Same wording as the payment list on the order pages: Name (Provider - Number) */
      var extra = [p, a].filter(Boolean).join(' - ');
      set($('pvOption'), n ? (extra ? n + ' (' + extra + ')' : n) : '', 'Merchant name');

      document.querySelectorAll('.chip').forEach(function (c) {
        var on = p.toLowerCase() === c.dataset.provider.toLowerCase();
        c.classList.toggle('border-brand-teal', on); c.classList.toggle('bg-brand-teal/10', on); c.classList.toggle('text-brand-tealDark', on);
      });
    }

    [name, provider, number].forEach(function (i) { i.addEventListener('input', refresh); });
    document.querySelectorAll('.chip').forEach(function (c) {
      c.addEventListener('click', function () { provider.value = c.dataset.provider; refresh(); number.focus(); });
    });
    [name, provider, number].forEach(function (i) { i.addEventListener('blur', function () { i.value = i.value.trim(); refresh(); }); });

    $('merchantForm').addEventListener('submit', function () {
      var b = $('saveBtn'); b.disabled = true; b.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i><span>Saving</span>';
    });
    refresh();
  })();
</script>

<%- include('../layouts/footer') %>
