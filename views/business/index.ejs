<%- include('../layouts/header') %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 max-w-5xl bg-rose-50 border border-rose-200 rounded-xl p-4 flex items-start gap-3 shadow-sm animate-fade-in">
      <div class="bg-rose-100 text-rose-600 p-1.5 rounded-lg shrink-0">
        <i class="fas fa-exclamation-circle text-lg"></i>
      </div>
      <div class="flex-1">
        <h4 class="text-sm font-bold text-rose-800">Processing Error Encountered</h4>
        <p class="text-xs text-rose-600 mt-0.5"><%= error %></p>
      </div>
    </div>
  <% } %>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-800">Registered Businesses</h1>
      <p class="text-sm text-slate-500 mt-1">Manage tenant profiles, enterprise hubs, and core business associations.</p>
    </div>
    <div>
      <a href="/business/create"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-teal hover:bg-brand-tealDark text-white text-sm font-semibold rounded-lg shadow-sm shadow-brand-teal/10 transition duration-150 whitespace-nowrap">
        <i class="fas fa-plus text-xs"></i> Register New Shop
      </a>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden max-w-5xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse whitespace-nowrap">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-slate-400 text-xs font-bold uppercase tracking-wider">
            <th class="py-3.5 px-6">Business UUID</th>
            <th class="py-3.5 px-6">Business Name</th>
            <th class="py-3.5 px-6">Registered On</th>
            <th class="py-3.5 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="text-sm divide-y divide-slate-100">
          <% if (typeof businesses !== 'undefined' && businesses.length > 0) { %>
            <% businesses.forEach(b => { %>
              <tr class="hover:bg-slate-50/70 transition duration-150 group">
                <td class="py-4 px-6 font-mono text-xs text-slate-400">
                  <%= b.id %>
                </td>
                <td class="py-4 px-6 font-semibold text-slate-800">
                  <%= b.name %>
                </td>
                <td class="py-4 px-6 text-slate-500 text-xs">
                  <%= new Date(b.createdAt).toLocaleDateString('en-GB') %>
                </td>
                <td class="py-4 px-6 text-right">
                  <div class="inline-flex items-center gap-2">
                    <a href="/business/view/<%= b.id %>"
                      class="inline-flex items-center gap-1.5 bg-white hover:bg-teal-50 text-slate-600 hover:text-brand-teal py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-teal-200 rounded-md shadow-sm transition duration-150">
                      <i class="fas fa-eye text-[10px]"></i> View Info
                    </a>
                    <a href="/business/edit/<%= b.id %>"
                      class="inline-flex items-center gap-1.5 bg-white hover:bg-brand-gold/10 text-slate-600 hover:text-brand-goldHover py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-brand-gold/30 rounded-md shadow-sm transition duration-150">
                      <i class="fas fa-edit text-[10px]"></i> Rename
                    </a>
                    <a href="/business/delete/<%= b.id %>"
                      class="inline-flex items-center gap-1.5 bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 py-1.5 px-3 text-xs font-semibold border border-slate-200 hover:border-rose-200 rounded-md shadow-sm transition duration-150"
                      onclick="return confirm('Deleting this business will remove its ownership references. Proceed?')">
                      <i class="fas fa-trash-alt text-[10px]"></i> Remove
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="py-12 text-center">
                <div class="text-slate-300 mb-2"><i class="fas fa-building text-4xl"></i></div>
                <p class="text-sm text-slate-400 italic">No business entities registered on this server environment.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

<%- include('../layouts/footer') %>