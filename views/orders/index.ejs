<%- include('../layouts/header') %>
<%
  /* ---------- state & helpers ---------- */
  const q       = (typeof query !== 'undefined' && query) ? query : {};
  const rows    = (typeof orders !== 'undefined' && orders) ? orders : [];
  const accts   = (typeof merchants !== 'undefined' && merchants) ? merchants : [];
  const cur     = Number(typeof currentPage !== 'undefined' ? currentPage : 1) || 1;
  const pages   = Number(typeof totalPages  !== 'undefined' ? totalPages  : 1) || 1;
  const status  = q.status || '';
  const money   = (v) => Number(v || 0).toLocaleString('en-US');
  const KEYS    = ['orderNo', 'customer', 'maxAmount', 'status'];

  const build = (overrides, page) => {
    const p = new URLSearchParams();
    KEYS.forEach(k => {
      const v = (k in overrides) ? overrides[k] : q[k];
      if (v) p.set(k, v);
    });
    if (page > 1) p.set('page', page);
    const s = p.toString();
    return '/orders' + (s ? '?' + s : '');
  };

  const chips = [];
  if (q.orderNo)    chips.push({ key: 'orderNo',   text: 'Order #' + q.orderNo });
  if (q.customer)   chips.push({ key: 'customer',  text: 'Customer: ' + q.customer });
  if (q.maxAmount)  chips.push({ key: 'maxAmount', text: 'Up to TSh ' + money(q.maxAmount) });

  const pageList = [...new Set([1, pages, cur - 1, cur, cur + 1])].filter(n => n >= 1 && n <= pages).sort((a, b) => a - b);
  const filtered = chips.length > 0 || status !== '';

  const merchantLabel = (m) => {
    const extra = [m.provider, m.account_number].filter(Boolean).join(' - ');
    return extra ? m.name + ' (' + extra + ')' : m.name;
  };
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const pill = (s) => {
    s = esc(s);
    if (s === 'completed') return '<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold capitalize text-emerald-700 ring-1 ring-inset ring-emerald-600/15"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>' + s + '</span>';
    if (s === 'pending')   return '<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold capitalize text-amber-700 ring-1 ring-inset ring-amber-600/20"><span class="relative flex h-1.5 w-1.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span><span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-500"></span></span>' + s + '</span>';
    return '<span class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-2.5 py-1 text-xs font-semibold capitalize text-sky-700 ring-1 ring-inset ring-sky-600/15"><span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>' + (s || 'unknown') + '</span>';
  };
  const field = 'w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20';
%>

<div class="space-y-6">

  <!-- ============ Actions ============ -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Follow customer orders from creation to payment.</p>
    <a href="/orders/create" class="inline-flex items-center gap-2 rounded-xl bg-brand-gold px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover">
      <i class="fas fa-plus text-xs"></i>New order
    </a>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">

    <!-- Status tabs -->
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5 sm:px-6">
      <div role="tablist" aria-label="Filter by status" class="inline-flex rounded-xl bg-slate-100 p-1">
        <% [['', 'All orders'], ['pending', 'Pending'], ['completed', 'Completed']].forEach(t => { const on = status === t[0]; %>
          <a href="<%= build({ status: t[0] }, 1) %>" role="tab" aria-selected="<%= on %>"
            class="rounded-lg px-4 py-1.5 text-sm font-medium transition-colors <%= on ? 'bg-white text-brand-tealDark shadow-sm' : 'text-slate-600 hover:text-brand-teal' %>"><%= t[1] %></a>
        <% }) %>
      </div>
      <p class="text-sm text-slate-500"><%= rows.length %> shown<%= pages > 1 ? ', page ' + cur + ' of ' + pages : '' %></p>
    </div>

    <!-- Search row -->
    <form method="GET" action="/orders" class="grid gap-3 px-5 py-4 sm:px-6 md:grid-cols-[8rem_1fr_13rem_auto] md:items-end">
      <input type="hidden" name="status" value="<%= status %>">
      <div>
        <label for="orderNo" class="mb-1.5 block text-sm font-medium text-slate-700">Order no.</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400">#</span>
          <input id="orderNo" type="text" name="orderNo" value="<%= q.orderNo || '' %>" placeholder="1001" class="<%= field %> pl-8 pr-3">
        </div>
      </div>
      <div>
        <label for="customer" class="mb-1.5 block text-sm font-medium text-slate-700">Customer</label>
        <div class="relative">
          <i class="fas fa-search pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
          <input id="customer" type="text" name="customer" value="<%= q.customer || '' %>" placeholder="Name or phone number" class="<%= field %> pl-10 pr-3">
        </div>
      </div>
      <div>
        <label for="maxAmount" class="mb-1.5 block text-sm font-medium text-slate-700">Highest amount</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">TSh</span>
          <input id="maxAmount" type="number" min="0" name="maxAmount" value="<%= q.maxAmount || '' %>" placeholder="No limit" class="<%= field %> pl-11 pr-3">
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button type="submit" class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-brand-teal px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-tealDark md:flex-none">
          <i class="fas fa-search text-xs"></i>Search
        </button>
        <% if (filtered) { %><a href="/orders" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50">Clear</a><% } %>
      </div>
    </form>

    <% if (chips.length) { %>
      <div class="flex flex-wrap items-center gap-2 px-5 pb-4 sm:px-6">
        <span class="text-sm text-slate-500">Filtering by</span>
        <% chips.forEach(c => { %>
          <a href="<%= build({ [c.key]: '' }, 1) %>" aria-label="Remove filter <%= c.text %>" class="group inline-flex items-center gap-2 rounded-full bg-brand-teal/10 px-3 py-1 text-sm font-medium text-brand-tealDark transition-colors hover:bg-rose-50 hover:text-rose-700">
            <%= c.text %><i class="fas fa-times text-[10px] opacity-60 group-hover:opacity-100"></i>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Orders table -->
    <div class="overflow-x-auto border-t border-slate-100">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-xs font-medium text-slate-500">
            <th scope="col" class="px-5 py-3 sm:px-6">Order</th>
            <th scope="col" class="hidden px-3 py-3 sm:table-cell">Customer</th>
            <th scope="col" class="px-3 py-3">Amount to pay</th>
            <th scope="col" class="hidden px-3 py-3 md:table-cell">Status</th>
            <th scope="col" class="py-3 pl-3 pr-5 text-right sm:pr-6">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (rows.length) { %>
            <% rows.forEach(o => {
                 const total = Number(o.total_amount || 0), disc = Number(o.discount || 0), final = Number(o.final_amount || o.total_amount || 0);
                 const done = o.status === 'completed';
            %>
              <tr class="transition-colors hover:bg-brand-teal/[0.03]">
                <td class="px-5 py-3.5 sm:px-6">
                  <p class="font-semibold text-slate-800">#<%= o.order_number %></p>
                  <p class="mt-0.5 truncate text-xs text-slate-500 sm:hidden"><%= o.customer_name || 'Walk-in customer' %></p>
                </td>

                <td class="hidden px-3 py-3.5 sm:table-cell">
                  <p class="font-medium text-slate-800"><%= o.customer_name || 'Walk-in customer' %></p>
                  <p class="mt-0.5 text-xs <%= o.customer_phone ? 'font-mono text-slate-500' : 'italic text-slate-400' %>"><%= o.customer_phone || 'No phone number' %></p>
                </td>

                <td class="px-3 py-3.5">
                  <p class="font-bold tabular-nums text-slate-900">TSh <%= money(final) %></p>
                  <% if (disc > 0) { %>
                    <p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs tabular-nums">
                      <span class="text-slate-400 line-through">TSh <%= money(total) %></span>
                      <span class="rounded bg-amber-50 px-1.5 py-0.5 font-semibold text-amber-700">-TSh <%= money(disc) %></span>
                    </p>
                  <% } %>
                  <div class="mt-1.5 md:hidden"><%- pill(o.status) %></div>
                </td>

                <td class="hidden px-3 py-3.5 md:table-cell"><%- pill(o.status) %></td>

                <td class="py-3.5 pl-3 pr-5 text-right sm:pr-6">
                  <div class="inline-flex items-center gap-1">
                    <% if (!done) { %>
                      <button type="button" data-complete data-id="<%= o.id %>" data-number="<%= o.order_number %>" data-customer="<%= o.customer_name || 'Walk-in customer' %>" data-amount="TSh <%= money(final) %>"
                        class="mr-1 inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-emerald-700">
                        <i class="fas fa-check text-[10px]"></i>Complete
                      </button>
                    <% } %>
                    <a href="/orders/view/<%= o.id %>" title="View" aria-label="View order <%= o.order_number %>" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-brand-teal/10 hover:text-brand-teal"><i class="fas fa-eye text-sm"></i></a>
                    <% if (!done) { %>
                      <a href="/orders/edit/<%= o.id %>" title="Edit" aria-label="Edit order <%= o.order_number %>" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-brand-gold/10 hover:text-brand-goldHover"><i class="fas fa-edit text-sm"></i></a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="px-6 py-14 text-center">
              <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-teal/10 text-brand-teal"><i class="fas fa-receipt text-lg"></i></span>
              <% if (filtered) { %>
                <p class="mt-4 text-sm font-semibold text-slate-800">No orders match your search</p>
                <p class="mt-1 text-sm text-slate-500">Try a different order number, name or status.</p>
                <a href="/orders" class="mt-4 inline-flex rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-brand-teal hover:bg-brand-teal/5">Clear all filters</a>
              <% } else { %>
                <p class="mt-4 text-sm font-semibold text-slate-800">No orders yet</p>
                <p class="mt-1 text-sm text-slate-500">Create your first order to start selling.</p>
                <a href="/orders/create" class="mt-4 inline-flex rounded-xl bg-brand-gold px-4 py-2 text-sm font-semibold text-white hover:bg-brand-goldHover">New order</a>
              <% } %>
            </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
      <nav aria-label="Pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 px-5 py-4 sm:px-6">
        <p class="text-sm text-slate-500">Page <span class="font-semibold text-slate-800"><%= cur %></span> of <span class="font-semibold text-slate-800"><%= pages %></span></p>
        <div class="inline-flex items-center gap-1">
          <% if (cur > 1) { %>
            <a href="<%= build({}, cur - 1) %>" aria-label="Previous page" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"><i class="fas fa-chevron-left text-xs"></i></a>
          <% } else { %>
            <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg border border-slate-100 text-slate-300"><i class="fas fa-chevron-left text-xs"></i></span>
          <% } %>
          <% pageList.forEach((n, i) => { %>
            <% if (i > 0 && n - pageList[i - 1] > 1) { %><span class="px-1 text-slate-400">&hellip;</span><% } %>
            <% if (n === cur) { %>
              <span aria-current="page" class="grid h-9 min-w-[2.25rem] place-items-center rounded-lg bg-brand-teal px-2 text-sm font-bold text-white"><%= n %></span>
            <% } else { %>
              <a href="<%= build({}, n) %>" class="grid h-9 min-w-[2.25rem] place-items-center rounded-lg border border-slate-200 px-2 text-sm font-medium text-slate-600 hover:bg-slate-50"><%= n %></a>
            <% } %>
          <% }) %>
          <% if (cur < pages) { %>
            <a href="<%= build({}, cur + 1) %>" aria-label="Next page" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"><i class="fas fa-chevron-right text-xs"></i></a>
          <% } else { %>
            <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg border border-slate-100 text-slate-300"><i class="fas fa-chevron-right text-xs"></i></span>
          <% } %>
        </div>
      </nav>
    <% } %>
  </section>
</div>

<!-- ============ Complete order modal ============ -->
<div id="completeModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
  class="!mt-0 fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm">
  <div class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl">
    <div class="h-1 bg-brand-gold"></div>
    <div class="flex items-start justify-between gap-4 px-6 pt-5">
      <div>
        <h3 id="modalTitle" class="text-lg font-bold text-brand-tealDark">Complete order</h3>
        <p id="modalCustomer" class="mt-0.5 text-sm text-slate-500"></p>
      </div>
      <button type="button" data-close aria-label="Close" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600"><i class="fas fa-times"></i></button>
    </div>

    <form id="completeForm" method="POST" class="px-6 pb-6 pt-4">
      <div class="rounded-xl bg-teal-50 px-4 py-3">
        <p class="text-xs font-medium text-brand-teal">Amount to collect</p>
        <p id="modalAmount" class="mt-0.5 text-2xl font-extrabold tabular-nums text-brand-tealDark"></p>
      </div>

      <fieldset class="mt-5">
        <legend class="mb-2 text-sm font-medium text-slate-700">How was it paid?</legend>
        <div class="grid gap-2">
          <% [['CASH', 'fa-money-bill-wave', 'Cash', 'Paid in hand'],
              ['LIPA_NUMBER', 'fa-mobile-alt', 'Lipa number', 'Mobile money, till or QR'],
              ['CREDIT', 'fa-file-invoice-dollar', 'Credit', 'Customer pays later']].forEach((m, i) => { %>
            <label class="cursor-pointer">
              <input type="radio" name="payment_method" value="<%= m[0] %>" class="peer sr-only" <%= i === 0 ? 'checked' : '' %>>
              <span class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 transition-all peer-checked:border-brand-teal peer-checked:bg-brand-teal/5 peer-checked:ring-2 peer-checked:ring-brand-teal/15 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-gold">
                <span class="grid h-9 w-9 place-items-center rounded-lg bg-slate-100 text-slate-500"><i class="fas <%= m[1] %> text-sm"></i></span>
                <span><span class="block text-sm font-semibold text-slate-800"><%= m[2] %></span><span class="block text-xs text-slate-500"><%= m[3] %></span></span>
              </span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <div id="merchantBox" class="mt-4 hidden">
        <label for="merchantSelect" class="mb-1.5 block text-sm font-medium text-slate-700">Merchant account</label>
        <% if (accts.length) { %>
          <select id="merchantSelect" name="merchant_id" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20">
            <option value="">Select a merchant account</option>
            <% accts.forEach(m => { %><option value="<%= m.id %>"><%= merchantLabel(m) %></option><% }) %>
          </select>
        <% } else { %>
          <p class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
            You have no merchant accounts yet. <a href="/merchants" class="font-semibold underline">Add one</a> before using this payment method.
          </p>
          <input type="hidden" id="merchantSelect" name="merchant_id" value="">
        <% } %>
      </div>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button" data-close class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
        <button type="submit" id="confirmBtn" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60">
          <i class="fas fa-check text-xs"></i><span>Confirm and complete</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById('completeModal'), form = document.getElementById('completeForm'),
        box = document.getElementById('merchantBox'), select = document.getElementById('merchantSelect');

    function syncMerchant() {
      var method = form.querySelector('input[name="payment_method"]:checked').value, needs = method !== 'CASH';
      box.classList.toggle('hidden', !needs);
      if (needs) select.setAttribute('required', 'required');
      else { select.removeAttribute('required'); select.value = ''; }   // cash: no merchant account
      document.getElementById('confirmBtn').disabled = needs && select.type === 'hidden'; // no accounts to pick from
    }

    function open(btn) {
      document.getElementById('modalTitle').textContent = 'Complete order #' + btn.dataset.number;
      document.getElementById('modalCustomer').textContent = btn.dataset.customer;
      document.getElementById('modalAmount').textContent = btn.dataset.amount;
      form.action = '/orders/complete/' + btn.dataset.id;
      form.querySelector('input[value="CASH"]').checked = true;
      document.getElementById('confirmBtn').querySelector('span').textContent = 'Confirm and complete';
      syncMerchant();
      modal.classList.remove('hidden'); modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      form.querySelector('input[name="payment_method"]:checked').focus();
    }
    function close() {
      modal.classList.add('hidden'); modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }

    document.addEventListener('click', function (e) {
      var o = e.target.closest('[data-complete]'); if (o) { open(o); return; }
      if (e.target.closest('[data-close]') || e.target === modal) close();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    form.addEventListener('change', function (e) { if (e.target.name === 'payment_method') syncMerchant(); });
    form.addEventListener('submit', function () {
      var b = document.getElementById('confirmBtn'); b.disabled = true; b.querySelector('span').textContent = 'Saving';
    });
  })();
</script>

<%- include('../layouts/footer') %>
