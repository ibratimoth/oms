<%- include('../layouts/header') %>

<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-800">Debts & Credit Ledger</h1>
    <p class="text-sm text-slate-500 mt-0.5">Manage outstanding customer debts and supplier balances.</p>
  </div>
  <a href="/debts/create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-teal hover:bg-brand-tealDark text-white text-sm font-semibold rounded-lg shadow-sm transition">
    <i class="fas fa-plus text-xs"></i> Record New Entry
  </a>
</div>

<!-- Filter Bar -->
<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 mb-6">
  <form method="GET" action="/debts" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-6 gap-3">
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Search Person</label>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Name..." class="w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-3 text-xs text-slate-800 focus:ring-2 focus:ring-brand-teal/20 focus:border-brand-teal focus:bg-white outline-none">
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Type</label>
      <select name="type" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-3 text-xs text-slate-800 focus:ring-2 focus:ring-brand-teal/20 focus:border-brand-teal focus:bg-white outline-none">
        <option value="">All Types</option>
        <option value="CUSTOMER_DEBT" <%= filters.type === 'CUSTOMER_DEBT' ? 'selected' : '' %>>Customer Debt</option>
        <option value="SUPPLIER_DEBT" <%= filters.type === 'SUPPLIER_DEBT' ? 'selected' : '' %>>Supplier Debt</option>
        <option value="CUSTOMER_CREDIT" <%= filters.type === 'CUSTOMER_CREDIT' ? 'selected' : '' %>>Customer Credit</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Status</label>
      <select name="status" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-3 text-xs text-slate-800 focus:ring-2 focus:ring-brand-teal/20 focus:border-brand-teal focus:bg-white outline-none">
        <option value="">All Statuses</option>
        <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
        <option value="CLEARED" <%= filters.status === 'CLEARED' ? 'selected' : '' %>>Cleared</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Start Date</label>
      <input type="date" name="start_date" value="<%= filters.start_date %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-3 text-xs text-slate-800 focus:ring-2 focus:ring-brand-teal/20 focus:border-brand-teal focus:bg-white outline-none">
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">End Date</label>
      <input type="date" name="end_date" value="<%= filters.end_date %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-3 text-xs text-slate-800 focus:ring-2 focus:ring-brand-teal/20 focus:border-brand-teal focus:bg-white outline-none">
    </div>
    <div class="flex items-end gap-2">
      <button type="submit" class="flex-1 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg transition">Filter</button>
      <a href="/debts" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold rounded-lg transition">Reset</a>
    </div>
  </form>
</div>

<!-- Table -->
<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-600">
      <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-bold text-slate-500">
        <tr>
          <th class="px-4 py-3">Person</th>
          <th class="px-4 py-3">Phone</th>
          <th class="px-4 py-3">Type</th>
          <th class="px-4 py-3">Amount</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Shop</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (debts.length === 0) { %>
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-xs text-slate-400">No debt records found.</td>
          </tr>
        <% } %>
        <% debts.forEach(debt => { %>
          <tr class="hover:bg-slate-50/50 transition">
            <td class="px-4 py-3 font-semibold text-slate-800"><%= debt.person_name %></td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= debt.phone_number || '-' %></td>
            <td class="px-4 py-3 text-xs font-bold">
              <span class="px-2 py-0.5 rounded-full text-[10px] uppercase tracking-wider 
                <%= debt.type === 'CUSTOMER_DEBT' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-blue-50 text-blue-700 border border-blue-200' %>">
                <%= debt.type.replace('_', ' ') %>
              </span>
            </td>
            <td class="px-4 py-3 font-bold text-slate-800 whitespace-nowrap">TSh <%= Number(debt.amount).toLocaleString() %></td>
            <td class="px-4 py-3 text-xs font-bold">
              <span class="px-2 py-0.5 rounded-full text-[10px] uppercase tracking-wider 
                <%= debt.status === 'CLEARED' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200' %>">
                <%= debt.status %>
              </span>
            </td>
            <td class="px-4 py-3 text-xs text-slate-600"><%= debt.Business ? debt.Business.name : '-' %></td>
            <td class="px-4 py-3 text-right space-x-2 whitespace-nowrap">
              <button onclick="handleToggleStatus('/debts/toggle-status/<%= debt.id %>', '<%= debt.status %>')" class="text-xs px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition">
                <%= debt.status === 'PENDING' ? 'Mark Cleared' : 'Reopen' %>
              </button>
              <a href="/debts/edit/<%= debt.id %>" class="text-slate-400 hover:text-brand-teal transition"><i class="fas fa-edit"></i></a>
              <button onclick="handleDelete('/debts/delete/<%= debt.id %>')" class="text-slate-400 hover:text-rose-600 transition"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
    <div class="p-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span>Page <strong><%= pagination.currentPage %></strong> of <strong><%= pagination.totalPages %></strong></span>
      <div class="flex gap-1">
        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
          <a href="/debts?page=<%= i %>&search=<%= filters.search %>&type=<%= filters.type %>&status=<%= filters.status %>&start_date=<%= filters.start_date %>&end_date=<%= filters.end_date %>" 
             class="px-2.5 py-1 rounded-md border <%= pagination.currentPage === i ? 'bg-brand-teal text-white border-brand-teal' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
            <%= i %>
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<!-- SweetAlert2 CDN & Embedded JS -->
 <script src="/js/sweetalert2.all.min.js"></script>

<script>
  function handleToggleStatus(url, currentStatus) {
    const isPending = currentStatus === 'PENDING';
    const actionText = isPending ? 'mark this debt as CLEARED' : 'reopen this debt as PENDING';

    Swal.fire({
      icon: 'question',
      title: 'Update Debt Status?',
      text: `Are you sure you want to ${actionText}?`,
      showCancelButton: true,
      confirmButtonColor: '#0d9488',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, change status',
      cancelButtonText: 'Cancel',
      heightAuto: false // Prevents body padding manipulation & layout shifts
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = url;
      }
    });
  }

  function handleDelete(url) {
    Swal.fire({
      icon: 'warning',
      title: 'Delete Debt Record?',
      text: 'This action cannot be undone. Are you sure?',
      showCancelButton: true,
      confirmButtonColor: '#e11d48',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, delete it',
      cancelButtonText: 'Cancel',
      heightAuto: false // Prevents body padding manipulation & layout shifts
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = url;
      }
    });
  }
</script>

<%- include('../layouts/footer') %>