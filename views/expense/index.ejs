<%- include('../layouts/header') %>
<%
  /* ---------- state & helpers ---------- */
  const f     = (typeof filters !== 'undefined' && filters) ? filters : {};
  const rows  = (typeof expenses !== 'undefined' && expenses) ? expenses : [];
  const pg    = (typeof pagination !== 'undefined' && pagination) ? pagination : { currentPage: 1, totalPages: 1 };
  const cur   = Number(pg.currentPage) || 1, pages = Number(pg.totalPages) || 1;
  const money = (v) => Number(v || 0).toLocaleString('en-US');
  const KEYS  = ['single_date', 'start_date', 'end_date', 'category'];

  const build = (overrides, page) => {
    const p = new URLSearchParams();
    KEYS.forEach(k => { const v = (k in overrides) ? overrides[k] : f[k]; if (v) p.set(k, v); });
    if (page > 1) p.set('page', page);
    const s = p.toString();
    return '/expenses' + (s ? '?' + s : '');
  };

  /* Dates are handled as plain YYYY-MM-DD text so no time zone can shift them */
  const dayKey = (v) => v instanceof Date ? v.toISOString().slice(0, 10) : String(v || '').slice(0, 10);
  const pretty = (key) => {
    const [y, m, d] = key.split('-').map(Number); const dt = new Date(y, (m || 1) - 1, d || 1);
    return isNaN(dt) ? key : dt.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  };

  /* Group the entries by day, keeping the order they arrived in */
  const groups = [];
  rows.forEach(e => {
    const k = dayKey(e.expense_date); let g = groups[groups.length - 1];
    if (!g || g.key !== k) { g = { key: k, items: [], total: 0 }; groups.push(g); }
    g.items.push(e); g.total += Number(e.amount || 0);
  });

  const total = rows.reduce((s, e) => s + Number(e.amount || 0), 0);
  const byCat = {};
  rows.forEach(e => { const c = e.category || 'Uncategorised'; byCat[c] = (byCat[c] || 0) + Number(e.amount || 0); });
  const cats = Object.keys(byCat).map(c => ({ name: c, sum: byCat[c] })).sort((a, b) => b.sum - a.sum);
  const topCats = cats.slice(0, 5), maxCat = topCats.length ? topCats[0].sum : 0;

  const chips = [];
  if (f.single_date) chips.push({ key: 'single_date', text: 'On ' + f.single_date });
  if (f.start_date)  chips.push({ key: 'start_date',  text: 'From ' + f.start_date });
  if (f.end_date)    chips.push({ key: 'end_date',    text: 'To ' + f.end_date });
  if (f.category)    chips.push({ key: 'category',    text: 'Category: ' + f.category });
  const filtered = chips.length > 0;
  const singleMode = !!f.single_date;

  const pageList = [...new Set([1, pages, cur - 1, cur, cur + 1])].filter(n => n >= 1 && n <= pages).sort((a, b) => a - b);
  const field = 'w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20';
%>

<div class="space-y-6">

  <!-- ============ Actions ============ -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="max-w-xl text-sm text-slate-500">Everything the business spends, grouped by day so it is easy to check.</p>
    <a href="/expenses/create" class="inline-flex items-center gap-2 rounded-xl bg-brand-gold px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover">
      <i class="fas fa-plus text-xs"></i>Record expense
    </a>
  </div>

  <!-- ============ Summary ============ -->
  <section aria-label="Spending summary" class="grid overflow-hidden rounded-2xl border border-slate-200 bg-white lg:grid-cols-5">
    <div class="relative bg-teal-50 p-6 lg:col-span-2">
      <span class="absolute inset-x-0 top-0 h-1 bg-brand-gold"></span>
      <p class="text-sm font-semibold text-brand-teal">Total spent</p>
      <p class="mt-2 flex flex-wrap items-baseline gap-x-2 tabular-nums text-brand-tealDark"><span class="text-lg font-semibold opacity-70">TSh</span><span class="text-4xl font-extrabold tracking-tight"><%= money(total) %></span></p>
      <p class="mt-2 text-sm text-slate-600"><%= rows.length %> <%= rows.length === 1 ? 'expense' : 'expenses' %><%= pages > 1 ? ' on this page' : '' %><%= filtered ? ' matching your filters' : '' %></p>
    </div>

    <div class="p-6 lg:col-span-3">
      <p class="text-sm font-semibold text-slate-800">Where it went</p>
      <% if (topCats.length) { %>
        <ul class="mt-4 space-y-3">
          <% topCats.forEach(c => { const w = maxCat ? Math.max(4, Math.round((c.sum / maxCat) * 100)) : 0; %>
            <li>
              <div class="flex items-baseline justify-between gap-3 text-sm"><span class="truncate font-medium text-slate-700"><%= c.name %></span><span class="shrink-0 font-semibold tabular-nums text-slate-900">TSh <%= money(c.sum) %></span></div>
              <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-brand-teal" style="width: <%= w %>%"></div></div>
            </li>
          <% }) %>
        </ul>
        <% if (cats.length > 5) { %><p class="mt-3 text-xs text-slate-500">and <%= cats.length - 5 %> more <%= cats.length - 5 === 1 ? 'category' : 'categories' %></p><% } %>
      <% } else { %>
        <p class="mt-3 text-sm text-slate-500">Nothing to show yet. Spending will be broken down by category here.</p>
      <% } %>
    </div>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">

    <!-- ============ Filters ============ -->
    <form id="filterForm" method="GET" action="/expenses" class="space-y-4 px-5 pt-5 sm:px-6">

      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-1 text-sm text-slate-500">Quick pick</span>
        <% [['today', 'Today'], ['yesterday', 'Yesterday'], ['week', 'This week'], ['month', 'This month'], ['lastMonth', 'Last month']].forEach(c => { %>
          <button type="button" data-range="<%= c[0] %>" class="range-chip rounded-full border border-slate-200 px-3 py-1 text-sm font-medium text-slate-600 transition-colors hover:border-brand-teal/40 hover:text-brand-teal"><%= c[1] %></button>
        <% }) %>
      </div>

      <div class="grid gap-3 md:grid-cols-[auto_1fr_1fr_1fr_auto] md:items-end">
        <div>
          <span class="mb-1.5 block text-sm font-medium text-slate-700">Dates</span>
          <div role="group" aria-label="Date filter type" class="inline-flex rounded-xl bg-slate-100 p-1">
            <button type="button" data-mode="range" aria-pressed="<%= !singleMode %>" class="mode-btn rounded-lg px-3.5 py-1.5 text-sm font-medium transition-colors">Range</button>
            <button type="button" data-mode="single" aria-pressed="<%= singleMode %>" class="mode-btn rounded-lg px-3.5 py-1.5 text-sm font-medium transition-colors">One day</button>
          </div>
        </div>

        <div data-for="range" class="<%= singleMode ? 'hidden' : '' %>">
          <label for="start_date" class="mb-1.5 block text-sm font-medium text-slate-700">From</label>
          <input id="start_date" type="date" name="start_date" value="<%= f.start_date || '' %>" <%= singleMode ? 'disabled' : '' %> class="<%= field %> px-3">
        </div>
        <div data-for="range" class="<%= singleMode ? 'hidden' : '' %>">
          <label for="end_date" class="mb-1.5 block text-sm font-medium text-slate-700">To</label>
          <input id="end_date" type="date" name="end_date" value="<%= f.end_date || '' %>" min="<%= f.start_date || '' %>" <%= singleMode ? 'disabled' : '' %> class="<%= field %> px-3">
        </div>
        <div data-for="single" class="md:col-span-2 <%= singleMode ? '' : 'hidden' %>">
          <label for="single_date" class="mb-1.5 block text-sm font-medium text-slate-700">Day</label>
          <input id="single_date" type="date" name="single_date" value="<%= f.single_date || '' %>" <%= singleMode ? '' : 'disabled' %> class="<%= field %> px-3">
        </div>

        <div>
          <label for="category" class="mb-1.5 block text-sm font-medium text-slate-700">Category</label>
          <input id="category" type="text" name="category" value="<%= f.category || '' %>" list="categoryList" autocomplete="off" placeholder="e.g. Rent, Supplies" class="<%= field %> px-3">
          <datalist id="categoryList"><% cats.forEach(c => { %><option value="<%= c.name %>"><% }) %></datalist>
        </div>

        <div class="flex items-center gap-2">
          <button type="submit" class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-brand-teal px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-tealDark md:flex-none"><i class="fas fa-search text-xs"></i>Search</button>
          <% if (filtered) { %><a href="/expenses" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50">Reset</a><% } %>
        </div>
      </div>
    </form>

    <% if (chips.length) { %>
      <div class="flex flex-wrap items-center gap-2 px-5 pt-4 sm:px-6">
        <span class="text-sm text-slate-500">Filtering by</span>
        <% chips.forEach(c => { %>
          <a href="<%= build({ [c.key]: '' }, 1) %>" aria-label="Remove filter <%= c.text %>" class="group inline-flex items-center gap-2 rounded-full bg-brand-teal/10 px-3 py-1 text-sm font-medium text-brand-tealDark transition-colors hover:bg-rose-50 hover:text-rose-700"><%= c.text %><i class="fas fa-times text-[10px] opacity-60 group-hover:opacity-100"></i></a>
        <% }) %>
      </div>
    <% } %>

    <!-- ============ Expenses by day ============ -->
    <div class="mt-5 overflow-x-auto border-t border-slate-100">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-xs font-medium text-slate-500">
            <th scope="col" class="px-5 py-3 sm:px-6">Category</th>
            <th scope="col" class="hidden px-3 py-3 md:table-cell">Description</th>
            <th scope="col" class="hidden px-3 py-3 lg:table-cell">Shop</th>
            <th scope="col" class="px-3 py-3 text-right">Amount</th>
            <th scope="col" class="py-3 pl-3 pr-5 text-right sm:pr-6">Actions</th>
          </tr>
        </thead>

        <% if (groups.length) { %>
          <% groups.forEach(g => { %>
            <tbody class="divide-y divide-slate-100">
              <tr class="bg-slate-50/80">
                <th colspan="3" scope="colgroup" class="px-5 py-2.5 text-left text-sm font-semibold text-brand-tealDark sm:px-6"><i class="far fa-calendar mr-2 text-xs text-brand-gold"></i><%= pretty(g.key) %></th>
                <td colspan="2" class="px-5 py-2.5 text-right text-sm text-slate-500 sm:px-6">Day total <span class="ml-1 font-bold tabular-nums text-slate-800">TSh <%= money(g.total) %></span></td>
              </tr>
              <% g.items.forEach(e => { %>
                <tr class="transition-colors hover:bg-brand-teal/[0.03]">
                  <td class="px-5 py-3.5 sm:px-6">
                    <div class="flex items-center gap-3">
                      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-teal/10 text-sm font-bold text-brand-teal"><%= String(e.category || '?').trim().charAt(0).toUpperCase() %></span>
                      <div class="min-w-0">
                        <p class="truncate font-semibold text-slate-800"><%= e.category || 'Uncategorised' %></p>
                        <p class="mt-0.5 truncate text-xs text-slate-500 md:hidden"><%= e.description || 'No description' %></p>
                      </div>
                    </div>
                  </td>
                  <td class="hidden max-w-xs px-3 py-3.5 md:table-cell"><p class="truncate text-slate-600" title="<%= e.description || '' %>"><%= e.description || '-' %></p></td>
                  <td class="hidden px-3 py-3.5 text-slate-600 lg:table-cell"><%= e.Business ? e.Business.name : '-' %></td>
                  <td class="whitespace-nowrap px-3 py-3.5 text-right font-bold tabular-nums text-rose-600">TSh <%= money(e.amount) %></td>
                  <td class="py-3.5 pl-3 pr-5 text-right sm:pr-6">
                    <div class="inline-flex items-center gap-1">
                      <a href="/expenses/edit/<%= e.id %>" title="Edit" aria-label="Edit <%= e.category %> expense" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-brand-gold/10 hover:text-brand-goldHover"><i class="fas fa-edit text-sm"></i></a>
                      <button type="button" data-delete data-url="/expenses/delete/<%= e.id %>" data-label="<%= e.category %>, TSh <%= money(e.amount) %>" title="Delete" aria-label="Delete <%= e.category %> expense" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-rose-50 hover:text-rose-600"><i class="fas fa-trash-alt text-sm"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          <% }) %>
        <% } else { %>
          <tbody><tr><td colspan="5" class="px-6 py-14 text-center">
            <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-teal/10 text-brand-teal"><i class="fas fa-wallet text-lg"></i></span>
            <% if (filtered) { %>
              <p class="mt-4 text-sm font-semibold text-slate-800">No expenses match these filters</p>
              <p class="mt-1 text-sm text-slate-500">Try a wider date range or a different category.</p>
              <a href="/expenses" class="mt-4 inline-flex rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-brand-teal hover:bg-brand-teal/5">Reset filters</a>
            <% } else { %>
              <p class="mt-4 text-sm font-semibold text-slate-800">No expenses recorded yet</p>
              <p class="mt-1 text-sm text-slate-500">Record rent, supplies and other costs to see where money goes.</p>
              <a href="/expenses/create" class="mt-4 inline-flex rounded-xl bg-brand-gold px-4 py-2 text-sm font-semibold text-white hover:bg-brand-goldHover">Record expense</a>
            <% } %>
          </td></tr></tbody>
        <% } %>
      </table>
    </div>

    <% if (pages > 1) { %>
      <nav aria-label="Pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 px-5 py-4 sm:px-6">
        <p class="text-sm text-slate-500">Page <span class="font-semibold text-slate-800"><%= cur %></span> of <span class="font-semibold text-slate-800"><%= pages %></span></p>
        <div class="inline-flex items-center gap-1">
          <% if (cur > 1) { %>
            <a href="<%= build({}, cur - 1) %>" aria-label="Previous page" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"><i class="fas fa-chevron-left text-xs"></i></a>
          <% } else { %>
            <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg border border-slate-100 text-slate-300"><i class="fas fa-chevron-left text-xs"></i></span>
          <% } %>
          <% pageList.forEach((n, i) => { %>
            <% if (i > 0 && n - pageList[i - 1] > 1) { %><span class="px-1 text-slate-400">&hellip;</span><% } %>
            <% if (n === cur) { %>
              <span aria-current="page" class="grid h-9 min-w-[2.25rem] place-items-center rounded-lg bg-brand-teal px-2 text-sm font-bold text-white"><%= n %></span>
            <% } else { %>
              <a href="<%= build({}, n) %>" class="grid h-9 min-w-[2.25rem] place-items-center rounded-lg border border-slate-200 px-2 text-sm font-medium text-slate-600 hover:bg-slate-50"><%= n %></a>
            <% } %>
          <% }) %>
          <% if (cur < pages) { %>
            <a href="<%= build({}, cur + 1) %>" aria-label="Next page" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"><i class="fas fa-chevron-right text-xs"></i></a>
          <% } else { %>
            <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg border border-slate-100 text-slate-300"><i class="fas fa-chevron-right text-xs"></i></span>
          <% } %>
        </div>
      </nav>
    <% } %>
  </section>
</div>

<script>
  /* Wrapped in a function so it cannot clash with the footer's Toast and Dialog */
  (function () {
    var form = document.getElementById('filterForm'),
        startEl = document.getElementById('start_date'), endEl = document.getElementById('end_date'), dayEl = document.getElementById('single_date');

    /* ---------- Range or one day ---------- */
    function setMode(mode) {
      var single = mode === 'single';
      document.querySelectorAll('[data-for="range"]').forEach(function (n) { n.classList.toggle('hidden', single); });
      document.querySelectorAll('[data-for="single"]').forEach(function (n) { n.classList.toggle('hidden', !single); });
      startEl.disabled = single; endEl.disabled = single; dayEl.disabled = !single;   // a disabled field is not sent with the form
      document.querySelectorAll('.mode-btn').forEach(function (b) {
        var on = b.dataset.mode === mode; b.setAttribute('aria-pressed', on);
        b.classList.toggle('bg-white', on); b.classList.toggle('text-brand-tealDark', on); b.classList.toggle('shadow-sm', on); b.classList.toggle('text-slate-600', !on);
      });
    }
    document.querySelectorAll('.mode-btn').forEach(function (b) { b.addEventListener('click', function () { setMode(b.dataset.mode); }); });
    setMode(dayEl.disabled ? 'range' : 'single');

    startEl.addEventListener('change', function () { endEl.min = startEl.value; if (endEl.value && endEl.value < startEl.value) endEl.value = startEl.value; });

    /* ---------- Quick picks ---------- */
    function ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
    function pick(key) {
      var t = new Date(), s = new Date(t), e = new Date(t);
      if (key === 'today')     return { single: ymd(t) };
      if (key === 'yesterday') { s.setDate(t.getDate() - 1); return { single: ymd(s) }; }
      if (key === 'week')      s.setDate(t.getDate() - ((t.getDay() + 6) % 7));                       // Monday to today
      if (key === 'month')     s = new Date(t.getFullYear(), t.getMonth(), 1);
      if (key === 'lastMonth') { s = new Date(t.getFullYear(), t.getMonth() - 1, 1); e = new Date(t.getFullYear(), t.getMonth(), 0); }
      return { from: ymd(s), to: ymd(e) };
    }
    document.querySelectorAll('.range-chip').forEach(function (chip) {
      var r = pick(chip.dataset.range);
      var active = r.single ? (!dayEl.disabled && dayEl.value === r.single) : (!startEl.disabled && startEl.value === r.from && endEl.value === r.to);
      if (active) { chip.classList.add('border-brand-teal', 'bg-brand-teal/10', 'text-brand-tealDark'); }
      chip.addEventListener('click', function () {
        if (r.single) { setMode('single'); dayEl.value = r.single; startEl.value = ''; endEl.value = ''; }
        else { setMode('range'); startEl.value = r.from; endEl.value = r.to; dayEl.value = ''; }
        form.submit();
      });
    });

    /* ---------- Delete ---------- */
    var DANGER = {
      popup: 'rounded-2xl border border-slate-200 shadow-2xl p-6', title: 'text-lg font-bold text-slate-800', htmlContainer: 'text-sm text-slate-500', actions: 'gap-2 mt-4',
      confirmButton: 'rounded-xl bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-400',
      cancelButton: 'rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50'
    };
    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-delete]'); if (!b) return;
      var url = b.dataset.url;
      Swal.fire({
        icon: 'warning', iconColor: '#e11d48', showCancelButton: true, reverseButtons: true, buttonsStyling: false, customClass: DANGER,
        title: 'Delete this expense?', text: b.dataset.label + ' will be removed permanently. This cannot be undone.',
        confirmButtonText: 'Yes, delete', cancelButtonText: 'Keep it'
      }).then(function (r) { if (r.isConfirmed) window.location.href = url; });
    });
  })();
</script>

<%- include('../layouts/footer') %>
