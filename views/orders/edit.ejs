<%- include('../layouts/header') %>
<%
  const list = (typeof products !== 'undefined' && products) ? products : [];
  const data = list.map(p => ({
    id: p.id, name: p.name, barcode: p.barcode ? String(p.barcode) : '',
    stock: Number(p.quantity_in_stock || 0), reorder: p.reorder_level || 5,
    price: (p.sell_price === undefined || p.sell_price === null) ? null : Number(p.sell_price)
  }));
  const hasPrices = data.some(d => d.price !== null);

  const existing = ((order && order.OrderItems) ? order.OrderItems : []).map(i => ({
    id: i.product_id, name: i.Product ? i.Product.name : 'Unknown item', qty: Number(i.quantity || 0), price: Number(i.unit_price || 0)
  }));
  const orderTotal = Number(order.total_amount || 0);
  const done = order.status === 'completed';

  let err = '';
  if (typeof messages !== 'undefined' && messages && messages.error && messages.error.length > 0) err = [].concat(messages.error).join(' ');
  else if (typeof error !== 'undefined' && error && error.length > 0) err = [].concat(error).join(' ');

  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const statusPill = (s) => {
    s = esc(s);
    if (s === 'pending') return '<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold capitalize text-amber-700 ring-1 ring-inset ring-amber-600/20"><span class="h-2 w-2 rounded-full bg-amber-500"></span>' + s + '</span>';
    if (s === 'completed') return '<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold capitalize text-emerald-700 ring-1 ring-inset ring-emerald-600/15"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>' + s + '</span>';
    return '<span class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1 text-sm font-semibold capitalize text-sky-700 ring-1 ring-inset ring-sky-600/15"><span class="h-2 w-2 rounded-full bg-sky-500"></span>' + (s || 'unknown') + '</span>';
  };
  const field = 'w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20';
%>

<div class="space-y-5 pb-20 lg:pb-0">

  <!-- ============ Header ============ -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-slate-500">
        <a href="/orders" class="group inline-flex items-center gap-2 font-medium transition-colors hover:text-brand-teal"><i class="fas fa-arrow-left text-xs transition-transform group-hover:-translate-x-0.5"></i>Orders</a>
        <i class="fas fa-chevron-right text-[10px] text-slate-300"></i><span class="text-slate-700">Edit</span>
      </nav>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h2 class="text-2xl font-bold tracking-tight text-brand-tealDark">Edit order #<%= order.order_number %></h2>
        <%- statusPill(order.status) %>
      </div>
    </div>
    <a href="/orders/view/<%= order.id %>" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-teal/40 hover:text-brand-teal"><i class="fas fa-eye text-xs"></i>View details</a>
  </div>

  <% if (done) { %>
    <div role="status" class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800"><i class="fas fa-exclamation-triangle mt-0.5"></i><p>This order is already completed. Changes may not be accepted.</p></div>
  <% } %>
  <% if (err) { %>
    <div role="alert" class="flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 p-4">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-rose-100 text-rose-600"><i class="fas fa-exclamation-circle"></i></span>
      <div class="min-w-0"><h4 class="text-sm font-semibold text-rose-800">The changes could not be saved</h4><p class="mt-0.5 text-sm text-rose-700"><%= err %></p></div>
    </div>
  <% } %>

  <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_23rem]">

    <!-- ============ Catalog ============ -->
    <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">
      <div class="border-b border-slate-100 p-5">
        <div class="flex flex-wrap items-center gap-3">
          <div class="relative min-w-[16rem] flex-1">
            <i class="fas fa-search pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-teal"></i>
            <input type="text" id="scanInput" autocomplete="off" aria-label="Scan a barcode or search products by name" placeholder="Scan a barcode or search by name"
              class="<%= field %> border-teal-200 bg-teal-50/50 py-3 pl-11 pr-12">
            <button type="button" id="clearSearch" aria-label="Clear search" class="absolute right-2 top-1/2 hidden h-8 w-8 -translate-y-1/2 place-items-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600"><i class="fas fa-times text-sm"></i></button>
            <kbd id="slashHint" class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-semibold text-slate-400 sm:block" title="Press / to search">/</kbd>
          </div>
          <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-600">
            <input type="checkbox" id="inStockOnly" class="h-4 w-4 rounded border-slate-300 text-brand-teal focus:ring-brand-teal">In stock only
          </label>
        </div>
        <p id="gridCount" class="mt-3 text-sm text-slate-500" aria-live="polite"></p>
      </div>

      <div id="grid" class="grid max-h-[34rem] grid-cols-2 gap-3 overflow-y-auto bg-slate-50/60 p-5 sm:grid-cols-3 xl:grid-cols-4"></div>
      <div id="gridEmpty" class="hidden px-6 py-14 text-center">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-teal/10 text-brand-teal"><i class="fas fa-search text-lg"></i></span>
        <p id="emptyTitle" class="mt-4 text-sm font-semibold text-slate-800">No products match</p>
        <p class="mt-1 text-sm text-slate-500">Check the spelling, try fewer words, or search by barcode.</p>
        <button type="button" id="emptyClear" class="mt-4 rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-brand-teal hover:bg-brand-teal/5">Clear search</button>
      </div>
    </section>

    <!-- ============ Ticket ============ -->
    <form id="orderForm" method="POST" action="/orders/edit/<%= order.id %>" novalidate class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white lg:sticky lg:top-24">
      <div id="ticket" class="h-1 bg-brand-gold"></div>

      <div class="flex items-center justify-between bg-teal-50 px-5 py-4">
        <h3 class="text-[15px] font-bold text-brand-tealDark">Order #<%= order.order_number %></h3>
        <span id="ticketCount" class="rounded-full bg-brand-teal px-2.5 py-0.5 text-xs font-bold text-white">0 items</span>
      </div>

      <div class="space-y-3 border-b border-slate-100 p-5">
        <div>
          <label for="customer_name" class="mb-1.5 block text-sm font-medium text-slate-700">Customer name</label>
          <input type="text" id="customer_name" name="customer_name" value="<%= order.customer_name || '' %>" data-original="<%= order.customer_name || '' %>" required autocomplete="off" placeholder="e.g. John Doe" class="<%= field %> px-3.5">
        </div>
        <div>
          <label for="customer_phone" class="mb-1.5 block text-sm font-medium text-slate-700">Phone <span class="font-normal text-slate-400">(optional)</span></label>
          <input type="text" id="customer_phone" name="customer_phone" value="<%= order.customer_phone || '' %>" data-original="<%= order.customer_phone || '' %>" inputmode="tel" autocomplete="off" placeholder="e.g. 0712345678" class="<%= field %> px-3.5">
        </div>
      </div>

      <div id="ticketEmpty" class="hidden px-6 py-10 text-center">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-teal/10 text-brand-teal"><i class="fas fa-shopping-basket text-lg"></i></span>
        <p class="mt-3 text-sm font-semibold text-slate-800">This order has no items</p>
        <p class="mx-auto mt-1 max-w-[16rem] text-sm text-slate-500">An order needs at least one item. Tap a product to add it.</p>
      </div>
      <ul id="cart" class="hidden max-h-80 divide-y divide-slate-100 overflow-y-auto"></ul>

      <section id="changesBox" class="mx-5 mb-5 mt-1 hidden rounded-xl border border-brand-gold/30 bg-amber-50/60 p-4">
        <h4 class="flex items-center gap-2 text-sm font-semibold text-amber-800"><i class="fas fa-pen text-xs"></i>What will change</h4>
        <ul id="changeList" class="mt-2 space-y-1.5 text-sm text-slate-700"></ul>
      </section>

      <div class="border-t border-slate-100 bg-slate-50/60 p-5">
        <p id="sumWarn" class="mb-3 hidden items-start gap-2 rounded-xl bg-amber-50 px-3.5 py-2.5 text-sm font-medium text-amber-800" role="status"></p>
        <% if (hasPrices) { %>
          <dl class="space-y-1.5 text-sm tabular-nums">
            <div class="flex items-center justify-between"><dt class="text-slate-500">Original total</dt><dd class="font-medium text-slate-700">TSh <%= orderTotal.toLocaleString('en-US') %></dd></div>
            <div class="flex items-baseline justify-between"><dt class="font-semibold text-slate-800">New total (estimate)</dt><dd class="text-brand-tealDark"><span class="text-xs font-semibold opacity-70">TSh</span> <span id="sumTotal" class="text-xl font-extrabold tracking-tight">0</span></dd></div>
            <div id="sumDeltaRow" class="hidden items-center justify-between"><dt class="text-slate-500">Difference</dt><dd id="sumDelta" class="font-semibold"></dd></div>
          </dl>
        <% } %>

        <p class="mt-4 flex items-center gap-2 text-sm text-slate-500"><span id="dirtyDot" class="h-2 w-2 rounded-full bg-slate-300"></span><span id="dirtyText">No changes yet</span></p>
        <button type="submit" id="submitBtn" disabled class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-gold px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none">
          <i class="fas fa-check text-xs"></i><span>Save changes</span>
        </button>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <button type="button" id="discardBtn" disabled class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">Discard changes</button>
          <a href="/orders" class="rounded-xl px-3 py-2 text-center text-sm font-medium text-slate-500 hover:bg-slate-100">Back to orders</a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Mobile ticket bar -->
<div id="mobileBar" class="!mt-0 fixed inset-x-0 bottom-0 z-30 flex items-center justify-between gap-3 border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur lg:hidden">
  <p class="text-sm font-semibold text-brand-tealDark"><span id="mobileCount">0 items</span><span id="mobileDirty" class="ml-2 hidden rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Unsaved</span></p>
  <a href="#ticket" class="rounded-xl bg-brand-teal px-4 py-2 text-sm font-semibold text-white">Review and save</a>
</div>

<script type="application/json" id="productData"><%- JSON.stringify(data).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="originalData"><%- JSON.stringify(existing).replace(/</g, '\\u003c') %></script>

<style>
  .tile { text-align: left; }
  .tile:focus-visible { outline: 2px solid #D49A17; outline-offset: 2px; }
  .tile.pulse { animation: tilePulse .5s ease; }
  @keyframes tilePulse { 0% { transform: scale(.96); } 60% { transform: scale(1.02); } 100% { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .tile.pulse { animation: none; } }
</style>

<script>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var PRODUCTS = JSON.parse($('productData').textContent), ORIGINAL = JSON.parse($('originalData').textContent);
    var HAS_PRICES = <%= hasPrices ? 'true' : 'false' %>, ORIGINAL_TOTAL = <%= orderTotal %>, LIMIT = 60;
    var money = function (v) { return Number(v || 0).toLocaleString('en-US'); };
    function toast(icon, title) { if (typeof Toast !== 'undefined') Toast.fire({ icon: icon, title: title, timer: 1600 }); }
    function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; }

    var byId = {}; PRODUCTS.forEach(function (p) { byId[String(p.id)] = p; });
    var scan = $('scanInput'), grid = $('grid'), cart = $('cart'), lines = [], tiles = {}, submitting = false;
    function find(id) { for (var i = 0; i < lines.length; i++) if (String(lines[i].p.id) === String(id)) return lines[i]; return null; }

    /* =====================================================
       Catalog search: every word must match the name or barcode; best matches first
       ===================================================== */
    function tokens(q) { return q.toLowerCase().split(/\s+/).filter(Boolean); }
    function rank(p, toks) {
      var name = p.name.toLowerCase(), code = (p.barcode || '').toLowerCase(), worst = 0;
      for (var i = 0; i < toks.length; i++) {
        var t = toks[i], s;
        if (code === t) s = 0; else if (name.indexOf(t) === 0) s = 1; else if (name.indexOf(' ' + t) > -1) s = 2;
        else if (name.indexOf(t) > -1) s = 3; else if (code.indexOf(t) > -1) s = 4; else return -1;
        if (s > worst) worst = s;
      }
      return worst;
    }
    function matching() {
      var toks = tokens(scan.value), only = $('inStockOnly').checked, out = [];
      PRODUCTS.forEach(function (p) {
        if (only && p.stock <= 0) return;
        if (!toks.length) { out.push({ p: p, s: 0 }); return; }
        var s = rank(p, toks); if (s >= 0) out.push({ p: p, s: s });
      });
      if (toks.length) out.sort(function (x, y) { return x.s - y.s || x.p.name.localeCompare(y.p.name); });
      return out.map(function (r) { return r.p; });
    }
    function highlight(parent, text, toks) {
      if (!toks.length) { parent.textContent = text; return; }
      var re = new RegExp('(' + toks.map(function (t) { return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }).join('|') + ')', 'ig');
      text.split(re).forEach(function (part, i) {
        if (i % 2) parent.appendChild(el('mark', 'rounded bg-amber-200/70 px-0.5 text-inherit', part));
        else if (part) parent.appendChild(document.createTextNode(part));
      });
    }
    function badge(tile, qty) { var b = tile.querySelector('[data-badge]'); b.textContent = qty ? '\u00d7' + qty : ''; b.classList.toggle('hidden', !qty); tile.classList.toggle('ring-2', !!qty); tile.classList.toggle('ring-brand-teal', !!qty); }

    function renderGrid() {
      var q = scan.value.trim(), toks = tokens(q), all = matching(), shown = all.slice(0, LIMIT); grid.textContent = ''; tiles = {};
      shown.forEach(function (p) {
        var out = p.stock <= 0, low = !out && p.stock <= p.reorder;
        var t = el('button', 'tile relative flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-3.5 transition-all hover:-translate-y-0.5 hover:border-brand-teal/50 hover:shadow-md ' + (out ? 'opacity-60' : ''));
        t.type = 'button'; t.setAttribute('aria-label', 'Add ' + p.name);
        var b = el('span', 'absolute -right-2 -top-2 hidden rounded-full bg-brand-teal px-2 py-0.5 text-xs font-bold text-white shadow'); b.setAttribute('data-badge', ''); t.appendChild(b);
        var nm = el('span', 'line-clamp-2 min-h-[2.5rem] text-sm font-semibold leading-snug text-slate-800'); highlight(nm, p.name, toks); t.appendChild(nm);
        var codeHit = toks.length && p.barcode && toks.some(function (x) { return p.barcode.toLowerCase().indexOf(x) > -1; });
        if (codeHit) { var bc = el('span', 'mt-1 block font-mono text-[11px] text-slate-500'); highlight(bc, p.barcode, toks); t.appendChild(bc); }
        var foot = el('span', 'mt-3 flex items-center justify-between gap-2');
        foot.appendChild(el('span', 'text-sm font-bold tabular-nums text-brand-tealDark', HAS_PRICES && p.price !== null ? 'TSh ' + money(p.price) : ''));
        foot.appendChild(el('span', 'rounded-full px-2 py-0.5 text-[11px] font-semibold ' + (out ? 'bg-rose-50 text-rose-700' : low ? 'bg-amber-50 text-amber-700' : 'bg-slate-100 text-slate-600'), out ? 'Out' : p.stock + ' left'));
        t.appendChild(foot);
        t.addEventListener('click', function () { addLine(p, 1); t.classList.remove('pulse'); void t.offsetWidth; t.classList.add('pulse'); });
        grid.appendChild(t); tiles[p.id] = t;
        var l = find(p.id); if (l) badge(t, l.qty);
      });
      $('gridEmpty').classList.toggle('hidden', all.length > 0); grid.classList.toggle('hidden', all.length === 0);
      $('clearSearch').classList.toggle('hidden', !scan.value); $('clearSearch').classList.toggle('grid', !!scan.value); $('slashHint').classList.toggle('hidden', !!scan.value);
      $('emptyTitle').textContent = q ? 'No products match "' + q + '"' : 'No products to show';
      $('emptyClear').classList.toggle('hidden', !q && !$('inStockOnly').checked);
      var noun = q ? (all.length === 1 ? 'result' : 'results') : (all.length === 1 ? 'product' : 'products');
      $('gridCount').textContent = (all.length > LIMIT ? 'Showing ' + LIMIT + ' of ' + all.length + ' ' + noun : all.length + ' ' + noun) + (q ? ' for "' + q + '"' : '') + (all.length > LIMIT ? '. Type more to narrow the list.' : '');
    }
    function focusTile(i) { var t = grid.children[i]; if (t) { t.focus(); t.scrollIntoView({ block: 'nearest' }); } }
    var raf; scan.addEventListener('input', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(renderGrid); });
    $('inStockOnly').addEventListener('change', renderGrid);
    $('clearSearch').addEventListener('click', function () { scan.value = ''; renderGrid(); scan.focus(); });
    $('emptyClear').addEventListener('click', function () { scan.value = ''; $('inStockOnly').checked = false; renderGrid(); scan.focus(); });
    scan.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); focusTile(0); return; }
      if (e.key === 'Escape') { if (scan.value) { scan.value = ''; renderGrid(); } return; }
      if (e.key !== 'Enter') return;
      e.preventDefault();
      var code = scan.value.trim(); if (!code) return;
      var exact = PRODUCTS.filter(function (p) { return p.barcode && p.barcode === code; })[0], m = matching(), hit = exact || (m.length === 1 ? m[0] : null);
      if (hit) { addLine(hit, 1); toast('success', 'Added ' + hit.name); scan.value = ''; renderGrid(); }
      else if (m.length > 1) { toast('info', m.length + ' products match. Choose one with the arrow keys.'); focusTile(0); }
      else { toast('error', 'No product found for "' + code + '"'); scan.select(); }
    });
    grid.addEventListener('keydown', function (e) {
      var t = e.target.closest('.tile'); if (!t) return;
      if (e.key === 'Escape') { scan.focus(); return; }
      var kids = Array.prototype.slice.call(grid.children), i = kids.indexOf(t);
      var cols = kids.filter(function (k) { return k.offsetTop === kids[0].offsetTop; }).length || 1;
      var next = { ArrowRight: i + 1, ArrowLeft: i - 1, ArrowDown: i + cols, ArrowUp: i - cols }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      if (next < 0) { scan.focus(); return; }
      focusTile(Math.min(next, kids.length - 1));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
      if (/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) return;
      e.preventDefault(); scan.focus(); scan.select();
    });

    /* =====================================================
       Ticket
       ===================================================== */
    function stockNote(l) {
      var p = l.p, base = l.orig || 0;
      // Only warn about quantity ABOVE what the order already had, so untouched lines never raise a false alarm
      if (l.qty > base && l.qty > p.stock) return { t: p.stock <= 0 ? 'Out of stock' : 'Only ' + p.stock + ' in stock', c: 'text-rose-600', bad: true };
      if (p.stock > 0 && p.stock <= p.reorder) return { t: 'Low stock: ' + p.stock + ' left', c: 'text-amber-600', bad: false };
      return { t: '', c: '', bad: false };
    }
    function updateLine(l) {
      var n = stockNote(l); l.noteEl.textContent = n.t; l.noteEl.className = 'text-xs font-medium ' + n.c; l.noteEl.classList.toggle('hidden', !n.t);
      var was = l.orig !== null && l.qty !== l.orig; l.wasEl.textContent = was ? 'Was ' + l.orig : ''; l.wasEl.classList.toggle('hidden', !was);
      if (l.totalEl) l.totalEl.textContent = 'TSh ' + money(l.price * l.qty);
      l.qtyEl.value = l.qty;
      if (tiles[l.p.id]) badge(tiles[l.p.id], l.qty);
    }

    function diff() {
      var out = [];
      ORIGINAL.forEach(function (o) {
        var l = find(o.id);
        if (!l) out.push({ k: 'removed', name: o.name, from: o.qty });
        else if (l.qty !== o.qty) out.push({ k: 'qty', name: l.p.name, from: o.qty, to: l.qty });
      });
      lines.forEach(function (l) { if (l.orig === null) out.push({ k: 'added', name: l.p.name, to: l.qty }); });
      [['customer_name', 'Customer name'], ['customer_phone', 'Phone']].forEach(function (f) {
        var i = $(f[0]), was = (i.getAttribute('data-original') || '').trim(), now = i.value.trim();
        if (was !== now) out.push({ k: 'field', name: f[1], from: was || 'empty', to: now || 'empty' });
      });
      return out;
    }

    function refresh() {
      var units = 0, total = 0, bad = 0;
      lines.forEach(function (l, i) {
        units += l.qty; total += l.price * l.qty; if (stockNote(l).bad) bad++;
        l.idEl.name = 'items[' + i + '][product_id]'; l.qtyEl.name = 'items[' + i + '][quantity]';
      });
      var label = lines.length + (lines.length === 1 ? ' item' : ' items');
      $('ticketCount').textContent = label; $('mobileCount').textContent = label + ', ' + units + ' units';
      $('ticketEmpty').classList.toggle('hidden', lines.length > 0); cart.classList.toggle('hidden', !lines.length);

      var w = $('sumWarn');
      if (bad) { w.className = 'mb-3 flex items-start gap-2 rounded-xl bg-amber-50 px-3.5 py-2.5 text-sm font-medium text-amber-800'; w.innerHTML = '<i class="fas fa-exclamation-triangle mt-0.5 text-xs"></i><span></span>'; w.lastChild.textContent = bad + (bad === 1 ? ' item asks' : ' items ask') + ' for more than is in stock.'; }
      else w.className = 'mb-3 hidden';

      var ch = diff(), dirty = ch.length > 0, list = $('changeList'); list.textContent = '';
      ch.forEach(function (c) {
        var li = el('li', 'flex flex-wrap items-center gap-x-2');
        if (c.k === 'added') { li.appendChild(el('span', 'font-semibold text-emerald-700', '+ Added')); li.appendChild(el('span', '', c.name + ' \u00d7 ' + c.to)); }
        else if (c.k === 'removed') { li.appendChild(el('span', 'font-semibold text-rose-600', '\u2212 Removed')); li.appendChild(el('span', '', c.name + ' (was ' + c.from + ')')); }
        else if (c.k === 'qty') { li.appendChild(el('span', 'font-medium', c.name + ':')); li.appendChild(el('span', 'text-slate-500 line-through', c.from)); li.appendChild(el('i', 'fas fa-arrow-right text-[10px] text-slate-400')); li.appendChild(el('span', 'font-semibold text-brand-tealDark', c.to)); }
        else { li.appendChild(el('span', 'font-medium', c.name + ':')); li.appendChild(el('span', 'text-slate-500 line-through', c.from)); li.appendChild(el('i', 'fas fa-arrow-right text-[10px] text-slate-400')); li.appendChild(el('span', 'font-semibold text-brand-tealDark', c.to)); }
        list.appendChild(li);
      });
      $('changesBox').classList.toggle('hidden', !dirty);

      if (HAS_PRICES) {
        $('sumTotal').textContent = money(total);
        var d = total - ORIGINAL_TOTAL, row = $('sumDeltaRow'); row.classList.toggle('hidden', !dirty || d === 0); row.classList.toggle('flex', dirty && d !== 0);
        $('sumDelta').textContent = (d > 0 ? '+' : '\u2212') + 'TSh ' + money(Math.abs(d)); $('sumDelta').className = 'font-semibold ' + (d > 0 ? 'text-amber-700' : 'text-emerald-700');
      }
      $('dirtyDot').className = 'h-2 w-2 rounded-full ' + (dirty ? 'bg-brand-gold' : 'bg-slate-300');
      $('dirtyText').textContent = dirty ? ch.length + (ch.length === 1 ? ' unsaved change' : ' unsaved changes') : 'No changes yet';
      $('mobileDirty').classList.toggle('hidden', !dirty);
      $('submitBtn').disabled = !dirty || !lines.length; $('discardBtn').disabled = !dirty;
      return dirty;
    }

    function addLine(p, qty, o) {
      o = o || {};
      var ex = find(p.id); if (ex) { ex.qty += qty; updateLine(ex); refresh(); return; }
      var l = { p: p, qty: qty, orig: o.orig === undefined ? null : o.orig, price: o.price !== undefined ? o.price : (p.price || 0) };
      var li = el('li', 'px-5 py-3.5');

      var top = el('div', 'flex items-start justify-between gap-3');
      top.appendChild(el('p', 'min-w-0 text-sm font-semibold leading-snug text-slate-800', p.name));
      var rm = el('button', 'grid h-7 w-7 shrink-0 place-items-center rounded-md text-slate-400 transition-colors hover:bg-rose-50 hover:text-rose-600'); rm.type = 'button'; rm.setAttribute('aria-label', 'Remove ' + p.name); rm.innerHTML = '<i class="fas fa-times text-xs"></i>'; top.appendChild(rm);

      var row = el('div', 'mt-2 flex items-center justify-between gap-3');
      var step = el('div', 'flex overflow-hidden rounded-lg border border-slate-200 bg-white');
      var dec = el('button', 'px-2.5 py-1 text-slate-500 hover:bg-slate-100', '\u2212'); dec.type = 'button'; dec.setAttribute('aria-label', 'Fewer ' + p.name);
      var inc = el('button', 'px-2.5 py-1 text-slate-500 hover:bg-slate-100', '+'); inc.type = 'button'; inc.setAttribute('aria-label', 'More ' + p.name);
      l.qtyEl = el('input', 'w-12 border-x border-slate-200 text-center text-sm font-semibold tabular-nums focus:bg-brand-teal/5 focus:outline-none'); l.qtyEl.type = 'number'; l.qtyEl.min = 1; l.qtyEl.setAttribute('aria-label', 'Quantity of ' + p.name);
      step.appendChild(dec); step.appendChild(l.qtyEl); step.appendChild(inc); row.appendChild(step);
      if (HAS_PRICES) { l.totalEl = el('p', 'text-sm font-bold tabular-nums text-slate-900'); row.appendChild(l.totalEl); }

      var notes = el('div', 'mt-1.5 flex flex-wrap items-center gap-x-3');
      l.wasEl = el('p', 'hidden rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600'); l.noteEl = el('p', 'text-xs');
      notes.appendChild(l.wasEl); notes.appendChild(l.noteEl);
      l.idEl = el('input'); l.idEl.type = 'hidden'; l.idEl.value = p.id;
      li.appendChild(top); li.appendChild(row); li.appendChild(notes); li.appendChild(l.idEl);
      lines.push(l); cart.appendChild(li); l.li = li;

      dec.addEventListener('click', function () { l.qty = Math.max(1, l.qty - 1); updateLine(l); refresh(); });
      inc.addEventListener('click', function () { l.qty += 1; updateLine(l); refresh(); });
      l.qtyEl.addEventListener('input', function () { var v = parseInt(l.qtyEl.value, 10); if (v >= 1) { l.qty = v; updateLine(l); refresh(); } });
      l.qtyEl.addEventListener('blur', function () { l.qtyEl.value = l.qty; });
      rm.addEventListener('click', function () { lines.splice(lines.indexOf(l), 1); li.remove(); if (tiles[p.id]) badge(tiles[p.id], 0); refresh(); scan.focus(); });
      updateLine(l); refresh();
    }

    function loadOriginal() {
      ORIGINAL.forEach(function (o) {
        var p = byId[String(o.id)] || { id: o.id, name: o.name, barcode: '', stock: 0, reorder: 5, price: null };   // keep lines whose product is no longer listed
        addLine(p, o.qty, { orig: o.qty, price: o.price });
      });
    }

    $('discardBtn').addEventListener('click', function () {
      lines.slice().forEach(function (l) { l.li.remove(); if (tiles[l.p.id]) badge(tiles[l.p.id], 0); });
      lines = []; ['customer_name', 'customer_phone'].forEach(function (id) { $(id).value = $(id).getAttribute('data-original') || ''; });
      loadOriginal(); refresh(); renderGrid();
    });
    ['customer_name', 'customer_phone'].forEach(function (id) { $(id).addEventListener('input', refresh); });
    $('orderForm').addEventListener('keydown', function (e) { if (e.key === 'Enter' && e.target.type === 'number') e.preventDefault(); });
    $('orderForm').addEventListener('submit', function (e) {
      if (!lines.length) { e.preventDefault(); toast('warning', 'An order needs at least one item'); return; }
      var n = $('customer_name'); if (!n.value.trim()) { e.preventDefault(); n.focus(); toast('warning', 'Please enter the customer name'); return; }
      submitting = true; var b = $('submitBtn'); b.disabled = true; b.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i><span>Saving</span>';
    });
    window.addEventListener('beforeunload', function (e) { if (!submitting && diff().length) { e.preventDefault(); e.returnValue = ''; } });

    loadOriginal(); renderGrid(); refresh();
  })();
</script>

