<%- include('../layouts/header') %>
<%
  const shops = (typeof businesses !== 'undefined' && businesses) ? businesses : [];
  const field = 'w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20';
  const label = 'mb-1.5 block text-sm font-medium text-slate-700';
  const types = [
    { v: 'CUSTOMER_DEBT',   icon: 'fa-arrow-down', title: 'Customer debt',   text: 'A customer owes the shop' },
    { v: 'SUPPLIER_DEBT',   icon: 'fa-arrow-up',   title: 'Supplier debt',   text: 'The shop owes a supplier' },
    { v: 'CUSTOMER_CREDIT', icon: 'fa-wallet',     title: 'Customer credit', text: 'A customer has credit with the shop' }
  ];
%>

<div class="mx-auto max-w-5xl space-y-6">

  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-slate-500">
    <a href="/debts" class="group inline-flex items-center gap-2 font-medium transition-colors hover:text-brand-teal"><i class="fas fa-arrow-left text-xs transition-transform group-hover:-translate-x-0.5"></i>Debts and ledger</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-300"></i><span class="text-slate-700">New entry</span>
  </nav>

  <% if (typeof error !== 'undefined' && error) { %>
    <div role="alert" class="flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 p-4">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-rose-100 text-rose-600"><i class="fas fa-exclamation-circle"></i></span>
      <div class="min-w-0"><h4 class="text-sm font-semibold text-rose-800">The entry could not be saved</h4><p class="mt-0.5 text-sm text-rose-700"><%= error %></p></div>
    </div>
  <% } %>

  <div class="grid items-start gap-6 lg:grid-cols-3">

    <!-- ============ Form ============ -->
    <form id="debtForm" method="POST" action="/debts/create" class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white lg:col-span-2">
      <div class="space-y-8 p-6 sm:p-8">

        <div>
          <h2 class="text-xl font-bold tracking-tight text-brand-tealDark">Record a debt or credit</h2>
          <p class="mt-1 text-sm text-slate-500">Start by choosing what kind of entry this is.</p>
        </div>

        <!-- Type -->
        <fieldset>
          <legend class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>What happened?</legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            <% types.forEach((t, i) => { %>
              <label class="cursor-pointer">
                <input type="radio" name="type" value="<%= t.v %>" required class="peer sr-only" <%= i === 0 ? 'checked' : '' %>>
                <span class="flex h-full flex-col gap-3 rounded-xl border border-slate-200 p-4 transition-all peer-checked:border-brand-teal peer-checked:bg-brand-teal/5 peer-checked:ring-2 peer-checked:ring-brand-teal/15 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-gold">
                  <span class="grid h-9 w-9 place-items-center rounded-lg bg-slate-100 text-slate-500"><i class="fas <%= t.icon %> text-sm"></i></span>
                  <span><span class="block text-sm font-semibold text-slate-800"><%= t.title %></span><span class="mt-0.5 block text-xs leading-snug text-slate-500"><%= t.text %></span></span>
                </span>
              </label>
            <% }) %>
          </div>
        </fieldset>

        <!-- Person -->
        <section>
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span><span id="personHeading">Customer</span></h3>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="person_name" class="<%= label %>"><span id="personLabel">Customer name</span></label>
              <input type="text" id="person_name" name="person_name" required autocomplete="off" placeholder="e.g. John Doe" class="<%= field %> px-3.5">
            </div>
            <div>
              <label for="phone_number" class="<%= label %>">Phone <span class="font-normal text-slate-400">(optional)</span></label>
              <input type="text" id="phone_number" name="phone_number" inputmode="tel" autocomplete="off" placeholder="07xxxxxxxx" class="<%= field %> px-3.5">
            </div>
          </div>
        </section>

        <!-- Amount -->
        <section>
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Amount</h3>
          <div class="mt-4">
            <label for="amount" class="<%= label %>">Amount in TSh</label>
            <div class="relative">
              <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm font-semibold text-slate-400">TSh</span>
              <input type="number" id="amount" name="amount" step="0.01" min="0.01" required inputmode="decimal" placeholder="0" class="<%= field %> py-3.5 pl-14 pr-4 text-xl font-bold tabular-nums">
            </div>
            <p id="amountWords" class="mt-1.5 h-5 text-sm font-medium text-brand-teal"></p>
          </div>
        </section>

        <!-- Details -->
        <section>
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Details</h3>
          <div class="mt-4 space-y-5">
            <div>
              <label for="notes" class="<%= label %>">Notes <span class="font-normal text-slate-400">(optional)</span></label>
              <textarea id="notes" name="notes" rows="3" maxlength="500" placeholder="What is this for? Any agreement or due date worth remembering?" class="<%= field %> px-3.5"></textarea>
              <p class="mt-1 text-right text-xs text-slate-400"><span id="notesCount">0</span>/500</p>
            </div>
            <div>
              <label for="business_id" class="<%= label %>">Shop</label>
              <% if (shops.length === 1) { %>
                <p class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-100 px-3.5 py-2.5 text-sm font-medium text-slate-700"><i class="fas fa-store text-xs text-brand-teal"></i><%= shops[0].name %></p>
                <input type="hidden" name="business_id" value="<%= shops[0].id %>">
              <% } else { %>
                <select id="business_id" name="business_id" class="<%= field %> px-3.5">
                  <% shops.forEach(b => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
                </select>
              <% } %>
            </div>
          </div>
        </section>
      </div>

      <div class="flex flex-col-reverse items-stretch justify-end gap-3 border-t border-slate-100 bg-slate-50/60 px-6 py-4 sm:flex-row sm:items-center sm:px-8">
        <a href="/debts" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-center text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50">Cancel</a>
        <button type="submit" id="saveBtn" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-gold px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover disabled:cursor-wait disabled:opacity-70">
          <i class="fas fa-check text-xs"></i><span>Save entry</span>
        </button>
      </div>
    </form>

    <!-- ============ Plain-language summary ============ -->
    <aside class="lg:sticky lg:top-24">
      <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">
        <div class="h-1 bg-brand-gold"></div>
        <div class="bg-teal-50 px-6 py-4"><p class="text-xs font-medium text-brand-teal">Summary</p><p class="mt-0.5 text-sm text-slate-600">Check this before you save.</p></div>
        <div class="p-6">
          <div class="flex items-start gap-3">
            <span id="sumIcon" class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-teal/10 text-brand-teal"><i id="sumIconI" class="fas fa-arrow-down"></i></span>
            <div class="min-w-0">
              <p id="sumKind" class="text-sm font-semibold text-brand-tealDark">Customer debt</p>
              <p id="sumSentence" class="mt-1 text-sm leading-relaxed text-slate-400">Fill in the name and amount to see a summary.</p>
            </div>
          </div>

          <dl class="mt-5 space-y-3 border-t border-slate-100 pt-4 text-sm">
            <div class="flex items-center justify-between gap-3"><dt class="text-slate-500">Amount</dt><dd id="sumAmount" class="font-bold tabular-nums text-slate-800">-</dd></div>
            <div class="flex items-center justify-between gap-3"><dt class="text-slate-500">Phone</dt><dd id="sumPhone" class="truncate font-mono text-slate-700">-</dd></div>
            <div class="flex items-center justify-between gap-3"><dt class="text-slate-500">Status</dt><dd><span class="rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-600/15">Pending</span></dd></div>
          </dl>
        </div>
        <p class="border-t border-slate-100 px-6 py-4 text-xs leading-relaxed text-slate-500">New entries start as pending. You can mark them as cleared from the ledger once they are settled.</p>
      </section>
    </aside>
  </div>
</div>

<script>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var form = $('debtForm'), nameEl = $('person_name'), phoneEl = $('phone_number'), amountEl = $('amount'), notes = $('notes');

    var KINDS = {
      CUSTOMER_DEBT:   { title: 'Customer debt',   icon: 'fa-arrow-down', person: 'Customer', place: 'e.g. John Doe', tile: 'bg-brand-teal/10 text-brand-teal',
                         say: function (n, a) { return n + ' owes the shop ' + a + '.'; } },
      SUPPLIER_DEBT:   { title: 'Supplier debt',   icon: 'fa-arrow-up',   person: 'Supplier', place: 'e.g. Mwanza Wholesalers', tile: 'bg-amber-50 text-amber-600',
                         say: function (n, a) { return 'The shop owes ' + n + ' ' + a + '.'; } },
      CUSTOMER_CREDIT: { title: 'Customer credit', icon: 'fa-wallet',     person: 'Customer', place: 'e.g. Amina Said', tile: 'bg-sky-50 text-sky-600',
                         say: function (n, a) { return n + ' has ' + a + ' of credit with the shop.'; } }
    };
    function kind() { return KINDS[form.querySelector('input[name="type"]:checked').value]; }
    function money(v) { return 'TSh ' + Number(v).toLocaleString('en-US', { maximumFractionDigits: 2 }); }

    function refresh() {
      var k = kind(), n = nameEl.value.trim(), amt = parseFloat(amountEl.value), hasAmt = isFinite(amt) && amt > 0, p = phoneEl.value.trim();

      $('personHeading').textContent = k.person; $('personLabel').textContent = k.person + ' name'; nameEl.placeholder = k.place;
      $('sumKind').textContent = k.title; $('sumIconI').className = 'fas ' + k.icon; $('sumIcon').className = 'grid h-11 w-11 shrink-0 place-items-center rounded-xl ' + k.tile;

      $('amountWords').textContent = hasAmt ? money(amt) : '';
      $('sumAmount').textContent = hasAmt ? money(amt) : '-'; $('sumPhone').textContent = p || '-';

      var s = $('sumSentence');
      if (n && hasAmt) { s.textContent = k.say(n, money(amt)); s.className = 'mt-1 text-sm font-medium leading-relaxed text-slate-800'; }
      else { s.textContent = 'Fill in the name and amount to see a summary.'; s.className = 'mt-1 text-sm leading-relaxed text-slate-400'; }
      $('notesCount').textContent = notes.value.length;
    }

    form.addEventListener('input', refresh); form.addEventListener('change', refresh);
    [nameEl, phoneEl].forEach(function (i) { i.addEventListener('blur', function () { i.value = i.value.trim(); refresh(); }); });

    form.addEventListener('submit', function (e) {
      var amt = parseFloat(amountEl.value);
      if (!(amt > 0)) { e.preventDefault(); amountEl.focus(); if (typeof Toast !== 'undefined') Toast.fire({ icon: 'warning', title: 'Enter an amount greater than zero', timer: 1800 }); return; }
      var b = $('saveBtn'); b.disabled = true; b.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i><span>Saving</span>';
    });
    refresh();
  })();
</script>

<%- include('../layouts/footer') %>
