<%- include('layouts/header') %>

<div class="max-w-2xl mx-auto my-12 p-8 bg-white border border-slate-200 shadow-sm rounded-xl text-center">
  <div class="w-16 h-16 bg-rose-50 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-4 border border-rose-100">
    <i class="fas fa-exclamation-triangle text-2xl"></i>
  </div>
  
  <h1 class="text-xl font-bold text-slate-800">Application Error Encountered</h1>
  
  <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto">
    <%= typeof message !== 'undefined' ? message : 'An unexpected processing disruption occurred inside the core services.' %>
  </p>

  <div class="mt-6 flex items-center justify-center gap-3">
    <a href="/dashboard" class="px-4 py-2 text-xs font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg border border-slate-200 transition">
      Dashboard Hub
    </a>
    <button onclick="window.history.back()" class="px-4 py-2 text-xs font-bold uppercase tracking-wider bg-brand-teal hover:bg-brand-tealDark text-white rounded-lg shadow-sm transition">
      Return Back
    </button>
  </div>
</div>

<%- include('layouts/footer') %>