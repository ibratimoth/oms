<%- include('../layouts/header') %>
<%
  /* ---------- helpers & derived values (same controller data as the other dashboard versions) ---------- */
  const L      = locals;
  const num    = (v) => Number(v || 0);
  const money  = (v) => num(v).toLocaleString('en-US');
  const pct    = (a, b) => b > 0 ? Math.max(0, Math.min(100, Math.round((a / b) * 100))) : 0;
  const admin  = typeof userRole !== 'undefined' && (userRole === 'superadmin' || userRole === 'admin');
  const who    = (typeof username !== 'undefined' && username) ? username : '';

  const net = num(L.netFinancialPosition), cash = num(L.cashInHand), rec = num(L.debtsOwedToYou), pay = num(L.debtsYouOwe);
  const sales = num(L.totalSales), profit = num(L.totalProfit);
  const margin = sales > 0 ? Math.round((profit / sales) * 1000) / 10 : 0;
  const ordersAll = num(L.totalOrders), ordersDone = num(L.completedOrders), ordersPend = num(L.pendingOrders);
  const donePct = pct(ordersDone, ordersAll), CIRC = 263.9;
  const lowList = L.lowStockProducts || [], orders = L.recentOrders || [];

  /* Sales trend: last 30 days, oldest to newest */
  const key = (v) => v instanceof Date ? v.toISOString().slice(0, 10) : String(v);
  const series = (L.dailySales || []).map(d => ({ date: key(d.dataValues.date), sales: num(d.dataValues.sales) }))
    .sort((a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : 0).slice(-30);
  const W = 640, H = 230, PL = 6, PR = 6, PT = 18, PB = 30, cw = W - PL - PR, ch = H - PT - PB;
  const maxS = series.reduce((m, d) => Math.max(m, d.sales), 0);
  const pts = series.map((d, i) => ({
    x: series.length > 1 ? PL + (i * cw) / (series.length - 1) : PL + cw / 2,
    y: PT + (1 - (maxS ? d.sales / maxS : 0)) * ch, date: d.date, sales: d.sales
  }));
  let line = '', area = '';
  if (pts.length > 1) {
    line = 'M' + pts[0].x.toFixed(1) + ' ' + pts[0].y.toFixed(1);
    for (let i = 1; i < pts.length; i++) { const a = pts[i - 1], b = pts[i], mx = ((a.x + b.x) / 2).toFixed(1); line += ' C' + mx + ' ' + a.y.toFixed(1) + ' ' + mx + ' ' + b.y.toFixed(1) + ' ' + b.x.toFixed(1) + ' ' + b.y.toFixed(1); }
    area = line + ' L' + pts[pts.length - 1].x.toFixed(1) + ' ' + (PT + ch) + ' L' + pts[0].x.toFixed(1) + ' ' + (PT + ch) + ' Z';
  }
  const best = pts.reduce((m, p) => (!m || p.sales > m.sales) ? p : m, null);
  const periodTotal = series.reduce((s, d) => s + d.sales, 0), avgDay = series.length ? Math.round(periodTotal / series.length) : 0;
  const shortDay = (k) => { const [y, m, d] = k.split('-').map(Number); const dt = new Date(y, (m || 1) - 1, d || 1); return isNaN(dt) ? k : dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); };

  /* Balance columns */
  const barMax = Math.max(Math.abs(cash), rec, pay, 1);
  const bar = (v) => Math.max(6, Math.round((Math.max(0, v) / barMax) * 100));

  /* Margin gauge (half circle, length = pi * 50) */
  const GAUGE = 157.08, gaugeDash = (Math.max(0, Math.min(100, margin)) / 100 * GAUGE).toFixed(1);

  const statusDot = (s) => ({ completed: 'bg-emerald-500', pending: 'bg-amber-400', cancelled: 'bg-rose-500' }[String(s || '').toLowerCase()] || 'bg-slate-400');

  const attention = [
    { label: 'Pending orders', value: ordersPend, text: ordersPend === 1 ? 'order waiting' : 'orders waiting', href: '/orders?status=pending', icon: 'fa-clock', on: ordersPend > 0, tone: 'bg-amber-50 text-amber-600', clear: 'No orders waiting' },
    { label: 'Low stock', value: lowList.length, text: lowList.length === 1 ? 'product to restock' : 'products to restock', href: '/products?status=low', icon: 'fa-box', on: lowList.length > 0, tone: 'bg-rose-50 text-rose-600', clear: 'Everything is stocked' },
    { label: 'Owed to you', value: 'TSh ' + money(rec), money: true, text: 'from customers', href: '/debts?type=CUSTOMER_DEBT&status=PENDING', icon: 'fa-arrow-down', on: rec > 0, tone: 'bg-brand-teal/10 text-brand-teal', clear: 'Nobody owes you' },
    { label: 'You owe', value: 'TSh ' + money(pay), money: true, text: 'to suppliers', href: '/debts?type=SUPPLIER_DEBT&status=PENDING', icon: 'fa-arrow-up', on: pay > 0, tone: 'bg-amber-50 text-amber-600', clear: 'No debts to pay' }
  ];
%>

<div id="dash" class="space-y-5">

  <!-- ============ Briefing ============ -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p id="todayLabel" class="text-sm font-medium text-slate-500"></p>
      <h2 class="mt-0.5 text-2xl font-bold tracking-tight text-brand-tealDark"><span id="greeting">Welcome</span><%= who ? ', ' + who : '' %></h2>
      <p class="mt-2 text-[15px] leading-relaxed text-slate-600">
        You hold <strong class="amt font-semibold text-slate-900">TSh <%= money(cash) %></strong> in cash and customers owe you <strong class="amt font-semibold text-slate-900">TSh <%= money(rec) %></strong>.
        <% if (ordersPend || lowList.length) { %>
          <%= ordersPend ? ordersPend + (ordersPend === 1 ? ' order is' : ' orders are') + ' waiting' : '' %><%= ordersPend && lowList.length ? ' and ' : '' %><%= lowList.length ? lowList.length + (lowList.length === 1 ? ' product needs' : ' products need') + ' restocking' : '' %>.
        <% } else { %>Nothing needs your attention right now.<% } %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button id="privacyToggle" type="button" aria-pressed="false" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-brand-teal/40 hover:text-brand-teal"><i class="far fa-eye text-xs"></i><span>Hide amounts</span></button>
      <a href="/products/create" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-brand-teal/40 hover:text-brand-teal"><i class="fas fa-box text-xs"></i>Add product</a>
      <a href="/orders/create" class="inline-flex items-center gap-2 rounded-xl bg-brand-gold px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover"><i class="fas fa-plus text-xs"></i>New order</a>
    </div>
  </div>

  <!-- ============ Bento grid ============ -->
  <div class="grid gap-4 lg:grid-cols-12">

    <!-- Sales trend -->
    <section class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white lg:col-span-8">
      <div class="flex flex-wrap items-start justify-between gap-4 px-6 pt-6">
        <div>
          <p class="text-sm font-semibold text-brand-teal">Total sales</p>
          <p class="mt-1 flex items-baseline gap-2 tabular-nums text-brand-tealDark"><span class="text-base font-semibold opacity-70">TSh</span><span class="amt text-4xl font-extrabold tracking-tight"><%= money(sales) %></span></p>
        </div>
        <% if (series.length) { %>
          <dl class="flex gap-6 text-sm">
            <div><dt class="text-slate-500">Daily average</dt><dd class="amt mt-0.5 font-bold tabular-nums text-slate-800">TSh <%= money(avgDay) %></dd></div>
            <% if (best) { %><div><dt class="text-slate-500">Best day</dt><dd class="mt-0.5 font-bold text-slate-800"><%= shortDay(best.date) %></dd></div><% } %>
          </dl>
        <% } %>
      </div>

      <% if (series.length) { %>
        <div id="chartBox" class="relative mt-2 px-2 pb-3">
          <svg id="trend" viewBox="0 0 <%= W %> <%= H %>" class="h-auto w-full touch-none" role="img" aria-label="Daily sales for the last <%= series.length %> days">
            <defs><linearGradient id="areaFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1A6B78" stop-opacity=".28"/><stop offset="100%" stop-color="#1A6B78" stop-opacity="0"/></linearGradient></defs>
            <% [0, .5, 1].forEach(t => { %><line x1="<%= PL %>" x2="<%= W - PR %>" y1="<%= (PT + t * ch).toFixed(1) %>" y2="<%= (PT + t * ch).toFixed(1) %>" stroke="#E2E8F0" stroke-dasharray="3 5"/><% }) %>
            <% if (area) { %>
              <path d="<%= area %>" fill="url(#areaFill)"/>
              <path d="<%= line %>" fill="none" stroke="#1A6B78" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <% } %>
            <% if (best) { %><circle cx="<%= best.x.toFixed(1) %>" cy="<%= best.y.toFixed(1) %>" r="5" fill="#D49A17" stroke="#fff" stroke-width="2"/><% } %>
            <g id="hoverMark" class="hidden"><line id="hoverLine" y1="<%= PT %>" y2="<%= PT + ch %>" stroke="#124E58" stroke-opacity=".35"/><circle id="hoverDot" r="5" fill="#124E58" stroke="#fff" stroke-width="2"/></g>
            <text x="<%= PL %>" y="<%= H - 8 %>" font-size="12" fill="#64748B"><%= shortDay(series[0].date) %></text>
            <% if (series.length > 1) { %><text x="<%= W - PR %>" y="<%= H - 8 %>" font-size="12" fill="#64748B" text-anchor="end"><%= shortDay(series[series.length - 1].date) %></text><% } %>
          </svg>
          <div id="tip" class="pointer-events-none absolute z-10 hidden -translate-x-1/2 whitespace-nowrap rounded-lg bg-brand-tealDark px-3 py-1.5 text-xs text-white shadow-lg"><span id="tipDate" class="text-teal-200"></span><br><span id="tipAmt" class="amt font-bold"></span></div>
        </div>
        <script type="application/json" id="trendData"><%- JSON.stringify({ w: W, pts: pts }).replace(/</g, '\\u003c') %></script>
      <% } else { %>
        <div class="px-6 pb-10 pt-8 text-center"><span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-slate-100 text-slate-400"><i class="fas fa-chart-line text-lg"></i></span><p class="mt-3 text-sm font-medium text-slate-700">No sales recorded yet</p><p class="mt-1 text-sm text-slate-500">Your sales trend will appear after the first completed order.</p></div>
      <% } %>
    </section>

    <!-- Net position -->
    <section class="relative overflow-hidden rounded-3xl bg-brand-tealDark p-6 text-white shadow-lg shadow-brand-tealDark/15 lg:col-span-4">
      <span class="absolute inset-x-0 top-0 h-1 bg-brand-gold"></span>
      <p class="text-sm font-medium text-teal-200">Net financial position</p>
      <p class="mt-2 flex flex-wrap items-baseline gap-x-2 tabular-nums"><span class="text-lg font-semibold text-brand-gold">TSh</span><span class="amt text-4xl font-extrabold tracking-tight <%= net < 0 ? 'text-rose-200' : '' %>"><%= money(net) %></span></p>

      <div class="mt-6 flex h-28 items-end gap-3" role="img" aria-label="Cash <%= money(cash) %>, owed to you <%= money(rec) %>, you owe <%= money(pay) %>">
        <div class="flex flex-1 flex-col justify-end"><div class="rounded-t-lg bg-emerald-300" style="height: <%= bar(cash) %>%"></div></div>
        <div class="flex flex-1 flex-col justify-end"><div class="rounded-t-lg bg-teal-200" style="height: <%= bar(rec) %>%"></div></div>
        <div class="flex flex-1 flex-col justify-end"><div class="rounded-t-lg bg-brand-gold" style="height: <%= bar(pay) %>%"></div></div>
      </div>
      <div class="mt-2 grid grid-cols-3 gap-3 text-xs">
        <div><p class="text-teal-200">Cash</p><p class="amt mt-0.5 truncate font-semibold tabular-nums"><%= money(cash) %></p></div>
        <div><p class="text-teal-200">Owed to you</p><p class="amt mt-0.5 truncate font-semibold tabular-nums"><%= money(rec) %></p></div>
        <div><p class="text-brand-gold">You owe</p><p class="amt mt-0.5 truncate font-semibold tabular-nums"><%= money(pay) %></p></div>
      </div>
      <p class="mt-4 border-t border-white/10 pt-3 text-xs leading-relaxed text-teal-200/80">Cash plus what you are owed, minus what you owe.<% if (net < 0) { %> <span class="font-medium text-rose-200">You owe more than you hold right now.</span><% } %></p>
    </section>

    <!-- Orders ring -->
    <section class="rounded-3xl border border-slate-200/80 bg-white p-6 lg:col-span-4">
      <div class="flex items-center justify-between"><h3 class="text-[15px] font-semibold text-slate-800">Orders</h3><a href="/orders" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">View all</a></div>
      <div class="mt-5 flex items-center gap-5">
        <div class="relative h-28 w-28 shrink-0" role="img" aria-label="<%= donePct %> percent of orders completed">
          <svg viewBox="0 0 100 100" class="h-full w-full -rotate-90"><circle cx="50" cy="50" r="42" fill="none" stroke-width="10" class="stroke-amber-100"/><circle cx="50" cy="50" r="42" fill="none" stroke-width="10" stroke-linecap="round" class="stroke-emerald-500" stroke-dasharray="<%= (donePct / 100 * CIRC).toFixed(1) %> <%= CIRC %>"/></svg>
          <div class="absolute inset-0 grid place-items-center text-center"><div><p class="text-2xl font-extrabold tabular-nums text-brand-tealDark"><%= donePct %>%</p><p class="-mt-0.5 text-[11px] text-slate-500">completed</p></div></div>
        </div>
        <dl class="flex-1 space-y-2.5 text-sm">
          <div class="flex items-center justify-between"><dt class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>Completed</dt><dd class="font-semibold tabular-nums text-slate-800"><%= ordersDone %></dd></div>
          <div class="flex items-center justify-between"><dt class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>Pending</dt><dd class="font-semibold tabular-nums text-slate-800"><%= ordersPend %></dd></div>
          <div class="flex items-center justify-between border-t border-slate-100 pt-2.5"><dt class="text-slate-600">Total</dt><dd class="font-semibold tabular-nums text-slate-800"><%= ordersAll %></dd></div>
        </dl>
      </div>
      <p class="mt-5 flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600"><span><i class="fas fa-box mr-2 text-xs text-brand-teal"></i>Products in catalog</span><a href="/products" class="font-semibold tabular-nums text-brand-teal hover:text-brand-tealDark"><%= L.totalProducts %></a></p>
    </section>

    <!-- Needs attention -->
    <section class="rounded-3xl border border-slate-200/80 bg-white p-6 lg:col-span-4">
      <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Needs your attention</h3>
      <ul class="mt-4 space-y-2">
        <% attention.forEach(a => { %>
          <li>
            <a href="<%= a.href %>" class="group flex items-center gap-3 rounded-2xl border border-slate-200 p-3 transition-colors hover:border-brand-teal/40 hover:bg-brand-teal/[0.03]">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl <%= a.on ? a.tone : 'bg-emerald-50 text-emerald-600' %>"><i class="fas <%= a.on ? a.icon : 'fa-check' %>"></i></span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs text-slate-500"><%= a.label %></span>
                <% if (a.on) { %><span class="block truncate text-sm font-bold tabular-nums text-slate-800"><span class="<%= a.money ? 'amt' : '' %>"><%= a.value %></span> <span class="font-normal text-slate-500"><%= a.money ? '' : a.text %></span></span>
                <% } else { %><span class="block text-sm font-semibold text-emerald-700"><%= a.clear %></span><% } %>
              </span>
              <i class="fas fa-chevron-right text-xs text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-teal"></i>
            </a>
          </li>
        <% }) %>
      </ul>
    </section>

    <!-- Profit and costs -->
    <section class="rounded-3xl border border-slate-200/80 bg-white p-6 lg:col-span-4">
      <div class="flex items-center justify-between"><h3 class="text-[15px] font-semibold text-slate-800"><%= admin ? 'Profit and costs' : 'Spending' %></h3><a href="/analytics" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">Analytics</a></div>
      <% if (admin) { %>
        <div class="mt-4 flex items-center gap-5">
          <div class="relative h-[4.5rem] w-32 shrink-0" role="img" aria-label="Profit margin <%= margin %> percent">
            <svg viewBox="0 0 120 66" class="h-full w-full"><path d="M10 60 A50 50 0 0 1 110 60" fill="none" stroke-width="10" stroke-linecap="round" class="stroke-slate-100"/><path d="M10 60 A50 50 0 0 1 110 60" fill="none" stroke-width="10" stroke-linecap="round" class="stroke-emerald-500" stroke-dasharray="<%= gaugeDash %> <%= GAUGE %>"/></svg>
            <div class="absolute inset-x-0 bottom-0 text-center"><p class="text-xl font-extrabold tabular-nums leading-none text-brand-tealDark"><%= margin %>%</p></div>
          </div>
          <div class="min-w-0"><p class="text-xs text-slate-500">Gross profit</p><p class="amt truncate text-xl font-extrabold tabular-nums text-emerald-700">TSh <%= money(profit) %></p><p class="text-xs text-slate-500">margin on sales</p></div>
        </div>
      <% } %>
      <dl class="<%= admin ? 'mt-4 border-t border-slate-100 pt-2' : 'mt-3' %> divide-y divide-slate-100 text-sm tabular-nums">
        <div class="flex items-center justify-between py-2.5"><dt class="text-slate-600">Total expenses</dt><dd class="amt font-semibold text-rose-600">TSh <%= money(L.totalExpenses) %></dd></div>
        <% if (admin) { %>
          <div class="flex items-center justify-between py-2.5"><dt class="text-slate-600">Cost of goods sold</dt><dd class="amt font-semibold text-amber-700">TSh <%= money(L.totalSoldProductsCost) %></dd></div>
          <div class="flex items-center justify-between py-2.5"><dt class="text-slate-600">Stock value at cost</dt><dd class="amt font-semibold text-brand-teal">TSh <%= money(L.totalRegisteredProductsCost) %></dd></div>
        <% } %>
      </dl>
    </section>

    <!-- Recent orders timeline -->
    <section class="rounded-3xl border border-slate-200/80 bg-white p-6 lg:col-span-7">
      <div class="flex items-center justify-between"><h3 class="text-[15px] font-semibold text-slate-800">Recent orders</h3><a href="/orders" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">View all</a></div>
      <% if (orders.length) { %>
        <ol class="mt-5">
          <% orders.forEach((o, i) => { %>
            <li class="relative flex items-start gap-4 <%= i < orders.length - 1 ? 'pb-5' : '' %>">
              <% if (i < orders.length - 1) { %><span class="absolute left-[0.4rem] top-4 h-full w-px bg-slate-200"></span><% } %>
              <span class="relative mt-1.5 h-3.5 w-3.5 shrink-0 rounded-full ring-4 ring-white <%= statusDot(o.status) %>"></span>
              <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                <div class="min-w-0"><p class="font-semibold text-slate-800">#<%= o.order_number %></p><p class="text-xs capitalize text-slate-500"><%= o.status %></p></div>
                <p class="amt shrink-0 text-sm font-bold tabular-nums text-slate-900">TSh <%= money(o.total_amount) %></p>
              </div>
            </li>
          <% }) %>
        </ol>
      <% } else { %>
        <div class="px-6 py-10 text-center"><span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-slate-100 text-slate-400"><i class="fas fa-shopping-cart"></i></span><p class="mt-3 text-sm font-medium text-slate-700">No orders yet</p><p class="mt-1 text-sm text-slate-500">New orders will show up here.</p></div>
      <% } %>
    </section>

    <!-- Low stock -->
    <section class="rounded-3xl border border-slate-200/80 bg-white p-6 lg:col-span-5">
      <div class="flex items-center justify-between"><h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800">Low stock<% if (lowList.length) { %><span class="rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700"><%= lowList.length %></span><% } %></h3><a href="/products?status=low" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">Restock</a></div>
      <% if (lowList.length) { %>
        <ul class="mt-4 max-h-72 divide-y divide-slate-100 overflow-y-auto">
          <% lowList.forEach(p => { const left = num(p.quantity_in_stock); %>
            <li class="flex items-center justify-between gap-3 py-3 text-sm">
              <span class="flex min-w-0 items-center gap-3"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg <%= left === 0 ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>"><i class="fas fa-box text-xs"></i></span><span class="truncate font-medium text-slate-700"><%= p.name %></span></span>
              <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold <%= left === 0 ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700' %>"><%= left === 0 ? 'Out of stock' : left + ' left' %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="px-6 py-10 text-center"><span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-50 text-emerald-600"><i class="fas fa-check"></i></span><p class="mt-3 text-sm font-medium text-slate-700">Everything is well stocked</p></div>
      <% } %>
    </section>
  </div>
</div>

<style>
  #dash.privacy .amt { filter: blur(9px); user-select: none; }
  .amt { transition: filter .2s ease; }
</style>

<script>
  (function () {
    var now = new Date(), h = now.getHours();
    document.getElementById('greeting').textContent = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
    document.getElementById('todayLabel').textContent = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

    /* Hide / show amounts, remembered on this device (shared with the other pages) */
    var dash = document.getElementById('dash'), btn = document.getElementById('privacyToggle'), KEY = 'dv_hide_amounts';
    function apply(on) {
      dash.classList.toggle('privacy', on); btn.setAttribute('aria-pressed', on);
      btn.querySelector('span').textContent = on ? 'Show amounts' : 'Hide amounts'; btn.querySelector('i').className = (on ? 'far fa-eye-slash' : 'far fa-eye') + ' text-xs';
    }
    var saved = false; try { saved = localStorage.getItem(KEY) === '1'; } catch (e) {}
    apply(saved);
    btn.addEventListener('click', function () { var on = !dash.classList.contains('privacy'); apply(on); try { localStorage.setItem(KEY, on ? '1' : '0'); } catch (e) {} });

    /* Sales trend: hover or touch to read a day */
    var dataEl = document.getElementById('trendData'); if (!dataEl) return;
    var data = JSON.parse(dataEl.textContent), pts = data.pts, svg = document.getElementById('trend'), box = document.getElementById('chartBox');
    var mark = document.getElementById('hoverMark'), line = document.getElementById('hoverLine'), dot = document.getElementById('hoverDot'), tip = document.getElementById('tip');

    function show(clientX) {
      var r = svg.getBoundingClientRect(), x = (clientX - r.left) * (data.w / r.width), best = pts[0];
      pts.forEach(function (p) { if (Math.abs(p.x - x) < Math.abs(best.x - x)) best = p; });
      line.setAttribute('x1', best.x); line.setAttribute('x2', best.x); dot.setAttribute('cx', best.x); dot.setAttribute('cy', best.y); mark.classList.remove('hidden');
      var d = best.date.split('-').map(Number), label = new Date(d[0], d[1] - 1, d[2]).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
      document.getElementById('tipDate').textContent = label; document.getElementById('tipAmt').textContent = 'TSh ' + Number(best.sales).toLocaleString('en-US');
      tip.classList.remove('hidden');
      var bx = box.getBoundingClientRect(), left = (best.x / data.w) * r.width + (r.left - bx.left), top = (best.y / 230) * r.height - 54;
      tip.style.left = Math.min(Math.max(left, 50), bx.width - 50) + 'px'; tip.style.top = Math.max(top, 0) + 'px';
    }
    function hide() { mark.classList.add('hidden'); tip.classList.add('hidden'); }
    svg.addEventListener('mousemove', function (e) { show(e.clientX); });
    svg.addEventListener('mouseleave', hide);
    svg.addEventListener('touchstart', function (e) { show(e.touches[0].clientX); }, { passive: true });
    svg.addEventListener('touchmove', function (e) { show(e.touches[0].clientX); }, { passive: true });
    svg.addEventListener('touchend', hide);
  })();
</script>

