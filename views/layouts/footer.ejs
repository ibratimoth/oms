      </div><!-- /page padding wrapper (opened in layout-header) -->
    </main>

    <footer role="contentinfo"
      class="mt-auto flex flex-col items-center justify-between gap-2 border-t border-slate-200/70 bg-white/70 px-4 py-4 text-xs text-slate-500 backdrop-blur sm:flex-row sm:px-8">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-brand-teal text-[10px] font-bold leading-none tracking-tight text-white">D<span class="text-brand-gold">V</span></span>
        <p>&copy; 2026 <span class="font-semibold text-brand-tealDark">Delle Ventures</span>. All rights reserved.</p>
      </div>
      <p class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Order Management Portal
        <span class="hidden text-slate-300 sm:inline">|</span>
        <span class="hidden sm:inline">You are signed out automatically after 3 minutes of inactivity</span>
      </p>
    </footer>

  </div><!-- /content column (opened in layout-header) -->
</div><!-- /app shell (opened in layout-header) -->

<style>
  .swal2-timer-progress-bar { background: #D49A17 !important; }
  .swal2-popup { font-family: inherit; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<!-- SweetAlert2 was loaded twice (CDN + local). One copy is enough; the local file works offline. -->
<script src="/js/sweetalert2.all.min.js"></script>

<script>
  /* ============================================================
     Shared SweetAlert2 styles (brand colours)
     ============================================================ */
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 2500,
    timerProgressBar: true,
    customClass: { popup: 'rounded-xl shadow-lg' }
  });

  const Dialog = Swal.mixin({
    buttonsStyling: false,
    reverseButtons: true,
    customClass: {
      popup: 'rounded-2xl border border-slate-200 shadow-2xl p-6',
      title: 'text-lg font-bold text-brand-tealDark',
      htmlContainer: 'text-sm text-slate-500',
      actions: 'gap-2 mt-4',
      confirmButton: 'rounded-xl bg-brand-teal px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-tealDark focus:outline-none focus:ring-2 focus:ring-brand-gold',
      cancelButton: 'rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-gold'
    }
  });

  /* ============================================================
     Order form: quantity stepper (used by inline onclick)
     ============================================================ */
  function changeQty(btn, delta) {
    const input = btn.parentNode.querySelector('.qty-input');
    input.value = Math.max(1, (parseInt(input.value, 10) || 1) + delta);
  }

  $(document).ready(function () {

    /* ---------- Barcode scanner focus ---------- */
    const $scanner = $('#barcodeScannerInput');
    $scanner.focus();

    $(document).on('click', function (e) {
      if (!$(e.target).closest('input, select, textarea, .select2-container, button, a').length) {
        $scanner.focus();
      }
    });

    /* ---------- Select2 + low stock warning ---------- */
    $('.product-select').select2();

    $(document).on('change', '.product-select', function () {
      const $opt = $(this).find(':selected');
      const stock = $opt.data('stock');
      const reorder = $opt.data('reorder') || 5;
      const $row = $(this).closest('.item-row');
      let $warning = $row.find('.stock-warning');

      if (!$warning.length) {
        $warning = $('<p class="stock-warning col-span-12 mt-1 flex items-center gap-1.5 text-xs font-semibold text-amber-600"></p>').appendTo($row);
      }
      $warning.html(stock !== undefined && stock <= reorder
        ? '<i class="fas fa-exclamation-triangle"></i> Low stock: ' + stock + ' left'
        : '');
    });

    /* ---------- Order rows ---------- */
    // Unique, ever-increasing index: removing a row never causes two rows to share an items[n] name.
    let rowIndex = $('.item-row').length;

    function addProductRow(productId = null, qty = 1) {
      const container = document.getElementById('items');
      const template = document.getElementById('productOptionsTemplate');
      if (!container || !template) return;

      const i = rowIndex++;
      const row = document.createElement('div');
      row.className = 'grid grid-cols-12 items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-sm item-row';
      row.innerHTML = `
        <div class="col-span-12 md:col-span-6">
          <select name="items[${i}][product_id]" aria-label="Product"
            class="product-select w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal/20">
            ${template.innerHTML}
          </select>
        </div>

        <div class="col-span-8 md:col-span-4">
          <div class="flex overflow-hidden rounded-lg border border-slate-200 bg-white">
            <button type="button" aria-label="Decrease quantity" onclick="changeQty(this, -1)"
              class="px-3.5 py-2 text-sm font-bold text-slate-500 transition-colors hover:bg-slate-100 hover:text-brand-tealDark">&minus;</button>
            <input type="number" min="1" name="items[${i}][quantity]" value="${qty}" aria-label="Quantity"
              class="qty-input w-full border-x border-slate-200 text-center text-sm font-semibold text-slate-800 focus:bg-brand-teal/5 focus:outline-none">
            <button type="button" aria-label="Increase quantity" onclick="changeQty(this, 1)"
              class="px-3.5 py-2 text-sm font-bold text-slate-500 transition-colors hover:bg-slate-100 hover:text-brand-tealDark">+</button>
          </div>
        </div>

        <div class="col-span-4 text-right md:col-span-2">
          <button type="button"
            class="btn-remove inline-flex items-center justify-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-400 transition-colors hover:bg-rose-50 hover:text-rose-600">
            <i class="fas fa-trash-alt pointer-events-none text-xs"></i><span>Remove</span>
          </button>
        </div>`;

      container.appendChild(row);

      const $select = $(row).find('.product-select');
      $select.select2();
      if (productId) $select.val(productId);
      $select.trigger('change');
    }

    $('#addRow').on('click', function () { addProductRow(); });

    $(document).on('click', '.btn-remove', function () {
      if ($('.item-row').length > 1) {
        $(this).closest('.item-row').remove();
        return;
      }
      Dialog.fire({
        title: 'Order needs at least one item',
        text: 'Choose a different product on this line instead of removing it.',
        icon: 'info',
        iconColor: '#1A6B78',
        confirmButtonText: 'Got it'
      });
    });

    /* ---------- Barcode processing ---------- */
    $scanner.on('keydown keypress', function (e) {
      if (e.key !== 'Enter' && e.keyCode !== 13) return;
      e.preventDefault();
      e.stopPropagation();

      const code = $scanner.val().trim();
      if (!code) return false;

      let matchedId = null, matchedName = '';
      $('#productOptionsTemplate option').each(function () {
        if (String($(this).data('barcode') || '').trim() === code) {
          matchedId = $(this).val();
          matchedName = $(this).text().trim();
          return false;
        }
      });

      if (matchedId) {
        let inCart = false;
        $('.item-row').each(function () {
          if ($(this).find('.product-select').val() === matchedId) {
            const $qty = $(this).find('.qty-input');
            $qty.val((parseInt($qty.val(), 10) || 0) + 1);
            inCart = true;
            return false;
          }
        });

        if (!inCart) {
          const $first = $('.item-row').first();
          const untouched = $('.item-row').length === 1 &&
            $first.find('.product-select').val() == $('#productOptionsTemplate option:first').val() &&
            $first.find('.qty-input').val() == 1;

          if (untouched) $first.find('.product-select').val(matchedId).trigger('change');
          else addProductRow(matchedId, 1);
        }
        Toast.fire({ icon: 'success', title: 'Added ' + matchedName, timer: 1200 });
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Barcode not found',
          text: '"' + code + '" is not registered.'
        });
      }

      // Clear now, and again shortly after to swallow any trailing scanner characters
      $scanner.val('');
      setTimeout(function () { $scanner.val('').focus(); }, 30);
      return false;
    });

    // Stop an Enter from the scanner from submitting the invoice form
    $('#invoiceForm').on('submit', function (e) {
      if (document.activeElement && document.activeElement.id === 'barcodeScannerInput') {
        e.preventDefault();
        return false;
      }
    });

    /* ---------- Bulk order template download ---------- */
    $('#downloadTemplateBtn').on('click', function (e) {
      e.preventDefault();
      downloadSheet('Orders Template', 'bulk_order_template.xlsx', [
        { customer_name: 'John Doe',   customer_phone: '0712345678', barcode: '690123456789', quantity: 2 },
        { customer_name: 'Jane Smith', customer_phone: '0789123456', barcode: '690987654321', quantity: 5 }
      ]);
    });
  });

  /* ============================================================
     Product import (single / bulk tabs + Excel template)
     ============================================================ */
  function switchMode(mode) {
    const singleTab = document.getElementById('tabSingleBtn');
    const bulkTab = document.getElementById('tabBulkBtn');
    const singleForm = document.getElementById('formSingleMode');
    const bulkForm = document.getElementById('formBulkMode');
    if (!singleTab || !bulkTab || !singleForm || !bulkForm) return;

    const base = 'border-b-2 px-5 py-2.5 text-sm transition-all duration-150 focus:outline-none ';
    const idle = base + 'border-transparent font-medium text-slate-500 hover:text-slate-700';

    singleTab.className = mode === 'single' ? base + 'border-brand-teal font-semibold text-brand-teal' : idle;
    bulkTab.className   = mode === 'bulk'   ? base + 'border-emerald-500 font-semibold text-emerald-600' : idle;
    singleForm.classList.toggle('hidden', mode !== 'single');
    bulkForm.classList.toggle('hidden', mode !== 'bulk');
  }

  function updateFileNameLabel(input) {
    const display = document.getElementById('fileNameDisplay');
    if (!display) return;
    display.textContent = '';
    if (input.files && input.files[0]) {
      const span = document.createElement('span');
      span.className = 'font-semibold text-emerald-600';
      span.innerHTML = '<i class="fas fa-check-circle mr-1"></i>';
      span.appendChild(document.createTextNode(input.files[0].name)); // text node: file names are never parsed as HTML
      display.appendChild(span);
    } else {
      display.textContent = 'No spreadsheet selected (.xlsx or .xls only)';
    }
  }

  function downloadSheet(sheetName, fileName, rows) {
    if (typeof XLSX === 'undefined') {
      Toast.fire({ icon: 'error', title: 'Excel library not loaded. Check your connection.' });
      return;
    }
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), sheetName);
    XLSX.writeFile(wb, fileName);
  }

  function downloadExcelTemplate() {
    downloadSheet('Products Template', 'products_bulk_import_template.xlsx', [
      { 'Product Name': 'Bic Evolution Pencil HB', 'Cost Price': 300,  'Selling Price': 500,  'Initial Stock': 100, 'Low Stock Limit': 10 },
      { 'Product Name': 'A4 Counter Book 2-Quire', 'Cost Price': 2500, 'Selling Price': 3500, 'Initial Stock': 50,  'Low Stock Limit': 5 }
    ]);
  }

  /* ============================================================
     Inactivity sign-out
     ============================================================ */
  (function () {
    const IDLE_TIME = 3 * 60 * 1000; // 3 minutes of no activity
    const COUNTDOWN = 20;            // seconds to answer the warning
    let idleTimer, warningOpen = false;

    function startIdleTimer() {
      clearTimeout(idleTimer);
      idleTimer = setTimeout(showWarning, IDLE_TIME);
    }

    function showWarning() {
      warningOpen = true;
      let ticker;

      Dialog.fire({
        title: 'Still there?',
        html: 'For your security you will be signed out in <b class="text-brand-teal">' + COUNTDOWN + '</b> seconds.',
        icon: 'warning',
        iconColor: '#D49A17',
        timer: COUNTDOWN * 1000,
        timerProgressBar: true,
        showCancelButton: true,
        confirmButtonText: 'Stay signed in',
        cancelButtonText: 'Sign out now',
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: function () {
          const b = Swal.getHtmlContainer().querySelector('b');
          ticker = setInterval(function () {
            if (b) b.textContent = Math.ceil(Swal.getTimerLeft() / 1000);
          }, 250);
        },
        willClose: function () { clearInterval(ticker); }
      }).then(function (result) {
        warningOpen = false;
        if (result.isConfirmed) startIdleTimer();
        else window.location.href = '/logout'; // "Sign out now" or the countdown ran out
      });
    }

    // Activity only resets the timer while the warning is NOT showing
    ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function (evt) {
      window.addEventListener(evt, function () { if (!warningOpen) startIdleTimer(); }, { passive: true });
    });

    startIdleTimer();
  })();
</script>
</body>
</html>
