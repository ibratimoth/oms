<%
  /* ---------- derived values ---------- */
  const money  = (v) => Number(v || 0).toLocaleString('en-US');
  const items  = (order.OrderItems && order.OrderItems.length) ? order.OrderItems : [];
  const total  = Number(order.total_amount || 0);
  const disc   = Number(order.discount || 0);
  const grand  = Number(order.final_amount || (total - disc) || total);
  const units  = items.reduce((s, i) => s + Number(i.quantity || 0), 0);
  const placed = new Date(order.createdAt || Date.now());
  const isoDate = isNaN(placed) ? '' : placed.toISOString();

  /* Payment status shown as a stamp. Outlined, so it also prints clearly in black and white. */
  let stamp = { text: 'Payment pending', cls: 'border-amber-500 text-amber-700' };
  if (order.status === 'completed') stamp = order.payment_method === 'CREDIT'
    ? { text: 'On credit', cls: 'border-sky-600 text-sky-700' }
    : { text: 'Paid', cls: 'border-emerald-600 text-emerald-700' };
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/jpeg" href="/images/delleventures.jpeg">
  <title>Invoice #<%= order.order_number %> · Delle Ventures</title>

  <link rel="stylesheet" href="/css/all.min.css">
  <script src="/js/tailwindcss.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { brand: { teal: '#1A6B78', tealDark: '#124E58', gold: '#D49A17', goldHover: '#B88211' } }
        }
      }
    }
  </script>

  <style>
    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    :focus-visible { outline: 2px solid #D49A17; outline-offset: 2px; }
    @page { size: A4; margin: 12mm; }

    @media print {
      body { background: #fff !important; }
      .no-print { display: none !important; }
      .sheet { max-width: none !important; margin: 0 !important; padding: 0 !important; border: 0 !important; box-shadow: none !important; border-radius: 0 !important; }
      thead { display: table-header-group; }
      tr, .keep-together { break-inside: avoid; page-break-inside: avoid; }
    }
  </style>
</head>

<body class="min-h-screen bg-slate-100 font-sans text-slate-800 antialiased">

  <!-- ============ Screen-only toolbar ============ -->
  <div class="no-print sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-[210mm] flex-wrap items-center justify-between gap-3 px-4 py-3">
      <div class="flex items-center gap-2">
        <a href="/orders" class="group inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-brand-teal/40 hover:text-brand-teal">
          <i class="fas fa-arrow-left text-xs transition-transform group-hover:-translate-x-0.5"></i>Orders
        </a>
        <a href="/orders/view/<%= order.id %>" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-brand-teal/40 hover:text-brand-teal">
          <i class="fas fa-eye text-xs"></i>Order details
        </a>
      </div>
      <div class="flex items-center gap-3">
        <span class="hidden text-sm text-slate-500 sm:inline">Choose "Save as PDF" in the print window to keep a copy.</span>
        <button type="button" id="printBtn" class="inline-flex items-center gap-2 rounded-xl bg-brand-teal px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-tealDark">
          <i class="fas fa-print text-xs"></i>Print invoice
        </button>
      </div>
    </div>
  </div>

  <!-- ============ Invoice sheet ============ -->
  <main class="px-4 py-8 print:p-0">
    <article class="sheet mx-auto max-w-[210mm] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="h-2 bg-brand-teal"></div>
      <div class="h-0.5 bg-brand-gold"></div>

      <div class="p-8 sm:p-10">

        <!-- Letterhead -->
        <header class="flex flex-wrap items-start justify-between gap-6">
          <div class="flex items-center gap-4">
            <img src="/images/delleventures.jpeg" alt="Delle Ventures logo" class="h-16 w-16 rounded-xl border border-slate-200 bg-white object-contain p-1">
            <div>
              <h1 class="text-2xl font-extrabold tracking-tight text-brand-tealDark">Delle <span class="text-brand-gold">Ventures</span></h1>
              <p class="mt-0.5 text-sm text-slate-500">Dodoma, Tanzania</p>
            </div>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-3xl font-extrabold uppercase tracking-[0.2em] text-brand-teal">Invoice</p>
            <p class="mt-1 font-mono text-lg font-bold text-slate-800">#<%= order.order_number %></p>
          </div>
        </header>

        <!-- Details -->
        <section class="keep-together mt-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded-xl bg-slate-50 px-5 py-4 sm:col-span-1">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Invoice to</p>
            <p class="mt-2 text-base font-bold text-slate-900"><%= order.customer_name || 'Walk-in customer' %></p>
            <% if (order.customer_phone) { %>
              <p class="mt-1 font-mono text-sm text-slate-600"><i class="fas fa-phone mr-1.5 text-[10px] text-slate-400"></i><%= order.customer_phone %></p>
            <% } else { %>
              <p class="mt-1 text-sm italic text-slate-400">No phone number</p>
            <% } %>
          </div>

          <div class="rounded-xl bg-slate-50 px-5 py-4 sm:col-span-1">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Invoice details</p>
            <dl class="mt-2 space-y-1 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-slate-500">Date</dt><dd class="font-semibold text-slate-800"><% if (isoDate) { %><time data-dt datetime="<%= isoDate %>"><%= isoDate.substr(0, 10) %></time><% } else { %>-<% } %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-slate-500">Order no.</dt><dd class="font-mono font-semibold text-slate-800">#<%= order.order_number %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-slate-500">Items</dt><dd class="font-semibold text-slate-800"><%= units %> <%= units === 1 ? 'unit' : 'units' %></dd></div>
            </dl>
          </div>

          <div class="flex items-center justify-center rounded-xl border border-dashed border-slate-200 px-5 py-4 sm:col-span-1">
            <span class="rotate-[-4deg] rounded-lg border-2 px-4 py-2 text-center text-base font-extrabold uppercase tracking-widest <%= stamp.cls %>"><%= stamp.text %></span>
          </div>
        </section>

        <!-- Items -->
        <section class="mt-8 overflow-hidden rounded-xl border border-slate-200">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b-2 border-brand-teal bg-teal-50 text-xs font-bold uppercase tracking-wider text-brand-tealDark">
                <th class="w-10 px-4 py-3 text-center">#</th>
                <th class="px-4 py-3">Product</th>
                <th class="w-16 px-4 py-3 text-center">Qty</th>
                <th class="w-32 px-4 py-3 text-right">Unit price (TSh)</th>
                <th class="w-36 px-4 py-3 text-right">Amount (TSh)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (items.length) { %>
                <% items.forEach((i, idx) => { %>
                  <tr>
                    <td class="px-4 py-3.5 text-center font-mono text-xs text-slate-400"><%= idx + 1 %></td>
                    <td class="px-4 py-3.5 font-semibold text-slate-800"><%= i.Product ? i.Product.name : i.product_id %></td>
                    <td class="px-4 py-3.5 text-center font-semibold tabular-nums text-slate-700"><%= i.quantity %></td>
                    <td class="px-4 py-3.5 text-right tabular-nums text-slate-600"><%= money(i.unit_price) %></td>
                    <td class="px-4 py-3.5 text-right font-bold tabular-nums text-slate-900"><%= money(i.subtotal) %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500">This order has no items.</td></tr>
              <% } %>
            </tbody>
          </table>
        </section>

        <!-- Totals -->
        <section class="keep-together mt-6 flex justify-end">
          <dl class="w-full space-y-2 text-sm tabular-nums sm:w-80">
            <div class="flex justify-between text-slate-600"><dt>Subtotal</dt><dd class="font-medium text-slate-800">TSh <%= money(total) %></dd></div>
            <% if (disc > 0) { %>
              <div class="flex justify-between text-slate-600"><dt>Discount</dt><dd class="font-semibold text-amber-700">-TSh <%= money(disc) %></dd></div>
            <% } %>
            <div class="flex justify-between border-b border-slate-200 pb-3 text-slate-600"><dt>VAT / Tax (0%)</dt><dd class="font-medium text-slate-800">TSh 0</dd></div>
            <div class="flex items-baseline justify-between rounded-xl bg-teal-50 px-4 py-3.5">
              <dt class="text-sm font-bold uppercase tracking-wider text-brand-tealDark">Total due</dt>
              <dd class="text-2xl font-extrabold tracking-tight text-brand-tealDark"><span class="text-sm font-semibold text-brand-gold">TSh</span> <%= money(grand) %></dd>
            </div>
          </dl>
        </section>

        <!-- Footer -->
        <footer class="keep-together mt-14 border-t border-dashed border-slate-300 pt-6 text-center">
          <p class="text-sm text-slate-600">Thank you for doing business with <span class="font-semibold text-brand-tealDark">Delle Ventures</span>.</p>
          <p class="mt-1 text-xs text-slate-400">This is a system-generated document and is valid without a signature.</p>
          <p class="mt-3 break-all font-mono text-[10px] text-slate-300">Ref <%= order.id %></p>
        </footer>
      </div>

      <div class="h-1.5 bg-brand-teal"></div>
    </article>
  </main>

  <script>
    /* Date and time in the viewer's own time zone */
    document.querySelectorAll('time[data-dt]').forEach(function (t) {
      var d = new Date(t.getAttribute('datetime')); if (isNaN(d)) return;
      t.textContent = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    });

    document.getElementById('printBtn').addEventListener('click', function () { window.print(); });

    /* Open the print window by itself, but only once styles, logo and fonts are ready.
       Add ?print=0 to the address to preview the invoice without it. */
    window.addEventListener('load', function () {
      if (/[?&]print=0/.test(location.search)) return;
      var ready = Array.prototype.map.call(document.images, function (img) { return img.decode ? img.decode().catch(function () {}) : Promise.resolve(); });
      Promise.all(ready)
        .then(function () { return document.fonts && document.fonts.ready; })
        .then(function () { setTimeout(function () { window.print(); }, 400); });
    });
  </script>
</body>
</html>
