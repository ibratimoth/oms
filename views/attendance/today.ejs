<%- include('../layouts/header') %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 max-w-5xl bg-rose-50 border border-rose-200 rounded-xl p-4 flex items-start gap-3 shadow-sm animate-fade-in">
      <div class="bg-rose-100 text-rose-600 p-1.5 rounded-lg shrink-0">
        <i class="fas fa-exclamation-circle text-lg"></i>
      </div>
      <div class="flex-1">
        <h4 class="text-sm font-bold text-rose-800">Processing Error Encountered</h4>
        <p class="text-xs text-rose-600 mt-0.5"><%= error %></p>
      </div>
    </div>
  <% } %>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-800">Today's Attendance</h1>
      <p class="text-sm text-slate-500 mt-1">Track staff arrivals, departures, and active shift logs for today.</p>
    </div>
    <div class="flex items-center gap-3">
      <!-- Sign In Button -->
      <form action="/attendance/sign-in" method="POST">
        <button type="submit"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-teal hover:bg-brand-tealDark text-white text-sm font-semibold rounded-lg shadow-sm transition duration-150 whitespace-nowrap">
          <i class="fas fa-sign-in-alt text-xs"></i> Sign In
        </button>
      </form>
      <!-- Sign Out Button -->
      <form action="/attendance/sign-out" method="POST">
        <button type="submit"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white hover:bg-rose-50 text-rose-600 text-sm font-semibold border border-rose-200 rounded-lg shadow-sm transition duration-150 whitespace-nowrap">
          <i class="fas fa-sign-out-alt text-xs"></i> Sign Out
        </button>
      </form>
      <!-- Link to Report View -->
      <a href="/attendance/report"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-lg transition duration-150 whitespace-nowrap">
        <i class="fas fa-calendar-alt text-xs"></i> View History
      </a>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden max-w-5xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse whitespace-nowrap">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-slate-400 text-xs font-bold uppercase tracking-wider">
            <th class="py-3.5 px-6">Staff Member</th>
            <th class="py-3.5 px-6">Role</th>
            <th class="py-3.5 px-6">Sign In Time</th>
            <th class="py-3.5 px-6">Sign Out Time</th>
            <th class="py-3.5 px-6 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="text-sm divide-y divide-slate-100">
          <% if (typeof attendances !== 'undefined' && attendances.length > 0) { %>
            <% attendances.forEach(att => { %>
              <tr class="hover:bg-slate-50/70 transition duration-150 group">
                <td class="py-4 px-6 font-semibold text-slate-800">
                  <%= att.User ? att.User.full_name : 'Unknown User' %>
                  <span class="block font-normal text-xs text-slate-400"><%= att.User ? att.User.username : '' %></span>
                </td>
                <td class="py-4 px-6 text-slate-600 capitalize text-xs">
                  <span class="px-2 py-1 bg-slate-100 rounded-md font-medium"><%= att.User ? att.User.role : 'N/A' %></span>
                </td>
                <td class="py-4 px-6 text-slate-600 text-xs">
                  <i class="far fa-clock text-slate-400 mr-1"></i> <%= new Date(att.sign_in).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td class="py-4 px-6 text-slate-600 text-xs">
                  <% if (att.sign_out) { %>
                    <i class="far fa-clock text-slate-400 mr-1"></i> <%= new Date(att.sign_out).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                  <% } else { %>
                    <span class="text-slate-400 italic">Not signed out</span>
                  <% } %>
                </td>
                <td class="py-4 px-6 text-right">
                  <% if (att.sign_out) { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">Completed</span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200">Active Shift</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-12 text-center">
                <div class="text-slate-300 mb-2"><i class="fas fa-clipboard-user text-4xl"></i></div>
                <p class="text-sm text-slate-400 italic">No attendance records found for today.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

<%- include('../layouts/footer') %>