<%- include('../layouts/header') %>
<script src="/js/bwip-js-min.js"></script>
<%
  /* ---------- state & helpers ---------- */
  const q        = (typeof query !== 'undefined' && query) ? query : {};
  const items    = (typeof products !== 'undefined' && products) ? products : [];
  const cur      = Number(typeof currentPage !== 'undefined' ? currentPage : 1) || 1;
  const pages    = Number(typeof totalPages  !== 'undefined' ? totalPages  : 1) || 1;
  const status   = q.status || '';
  const fmt      = (v) => Number(v || 0).toLocaleString('en-US');
  const KEYS     = ['barcode', 'search', 'status', 'maxPrice'];

  const build = (skip, page) => {
    const p = new URLSearchParams();
    KEYS.forEach(k => { if (k !== skip && q[k]) p.set(k, q[k]); });
    if (page > 1) p.set('page', page);
    const s = p.toString();
    return '/products' + (s ? '?' + s : '');
  };

  const chips = [];
  if (q.search)   chips.push({ key: 'search',   text: 'Name: ' + q.search });
  if (q.barcode)  chips.push({ key: 'barcode',  text: 'Barcode: ' + q.barcode });
  if (status)     chips.push({ key: 'status',   text: status === 'low' ? 'Low stock only' : 'Well stocked only' });
  if (q.maxPrice) chips.push({ key: 'maxPrice', text: 'Up to TSh ' + fmt(q.maxPrice) });

  const pageList = [...new Set([1, pages, cur - 1, cur, cur + 1])].filter(n => n >= 1 && n <= pages).sort((a, b) => a - b);

  const input = 'w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20';
%>

<div id="productsPage" class="space-y-6">

  <!-- ============ Actions ============ -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Manage prices, stock levels and barcode labels.</p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-action="print-all"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-teal/40 hover:text-brand-teal">
        <i class="fas fa-print text-xs"></i>Print all labels
      </button>
      <a href="/products/create" class="inline-flex items-center gap-2 rounded-xl bg-brand-gold px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover">
        <i class="fas fa-plus text-xs"></i>Add product
      </a>
    </div>
  </div>

  <!-- ============ Filters ============ -->
  <section class="rounded-2xl border border-slate-200/80 bg-white p-5">
    <form id="filterForm" method="GET" action="/products" class="space-y-4">

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="barcodeScanInput" class="mb-1.5 flex items-center gap-1.5 text-sm font-medium text-slate-700">
            <i class="fas fa-barcode text-xs text-brand-teal"></i>Scan a barcode
          </label>
          <div class="relative">
            <i class="fas fa-camera pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-brand-teal"></i>
            <input type="text" id="barcodeScanInput" name="barcode" value="<%= q.barcode || '' %>" autocomplete="off" placeholder="Point the scanner here"
              class="<%= input %> border-teal-200 bg-teal-50/50 pl-10 pr-3 font-mono">
          </div>
        </div>
        <div>
          <label for="searchInput" class="mb-1.5 block text-sm font-medium text-slate-700">Search by name</label>
          <div class="relative">
            <i class="fas fa-search pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
            <input type="text" id="searchInput" name="search" value="<%= q.search || '' %>" placeholder="Type a product name"
              class="<%= input %> pl-10 pr-3">
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-end gap-4">
        <fieldset>
          <legend class="mb-1.5 text-sm font-medium text-slate-700">Stock</legend>
          <div class="inline-flex rounded-xl bg-slate-100 p-1">
            <% [['', 'All'], ['available', 'Well stocked'], ['low', 'Low stock']].forEach(o => { %>
              <label class="cursor-pointer">
                <input type="radio" name="status" value="<%= o[0] %>" class="peer sr-only" <%= status === o[0] ? 'checked' : '' %>>
                <span class="block rounded-lg px-3.5 py-1.5 text-sm font-medium text-slate-600 transition-colors peer-checked:bg-white peer-checked:text-brand-tealDark peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-brand-gold"><%= o[1] %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>

        <div class="w-full sm:w-56">
          <label for="maxPrice" class="mb-1.5 block text-sm font-medium text-slate-700">Highest selling price</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">TSh</span>
            <input type="number" min="0" id="maxPrice" name="maxPrice" value="<%= q.maxPrice || '' %>" placeholder="No limit" class="<%= input %> pl-11 pr-3">
          </div>
        </div>

        <div class="flex items-center gap-2 sm:ml-auto">
          <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-brand-teal px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-tealDark">
            <i class="fas fa-sliders-h text-xs"></i>Apply
          </button>
          <% if (chips.length) { %><a href="/products" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50">Clear all</a><% } %>
        </div>
      </div>
    </form>

    <% if (chips.length) { %>
      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
        <span class="text-sm text-slate-500">Filtering by</span>
        <% chips.forEach(c => { %>
          <a href="<%= build(c.key, 1) %>" class="group inline-flex items-center gap-2 rounded-full bg-brand-teal/10 px-3 py-1 text-sm font-medium text-brand-tealDark transition-colors hover:bg-rose-50 hover:text-rose-700" aria-label="Remove filter <%= c.text %>">
            <%= c.text %><i class="fas fa-times text-[10px] opacity-60 group-hover:opacity-100"></i>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- ============ Product list ============ -->
  <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">
    <div class="flex items-center justify-between px-5 py-4 sm:px-6">
      <h3 class="text-[15px] font-semibold text-slate-800">Products</h3>
      <p class="text-sm text-slate-500"><%= items.length %> shown<%= pages > 1 ? ', page ' + cur + ' of ' + pages : '' %></p>
    </div>

    <div class="overflow-x-auto border-t border-slate-100">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-xs font-medium text-slate-500">
            <th scope="col" class="w-12 py-3 pl-5 pr-2 sm:pl-6">
              <input type="checkbox" id="selectAll" aria-label="Select all products on this page"
                class="h-4 w-4 cursor-pointer rounded border-slate-300 text-brand-teal focus:ring-brand-teal">
            </th>
            <th scope="col" class="px-3 py-3">Product</th>
            <th scope="col" class="px-3 py-3">Stock</th>
            <th scope="col" class="hidden px-3 py-3 lg:table-cell">Cost price</th>
            <th scope="col" class="hidden px-3 py-3 sm:table-cell">Selling price</th>
            <th scope="col" class="py-3 pl-3 pr-5 text-right sm:pr-6">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          <% if (items.length) { %>
            <% items.forEach(p => {
                 const qty = Number(p.quantity_in_stock || 0), reorder = p.reorder_level || 5;
                 const out = qty <= 0, low = !out && qty <= reorder;
                 const sell = Number(p.sell_price || 0), buy = Number(p.buy_price || 0);
                 const margin = sell > 0 ? Math.round(((sell - buy) / sell) * 100) : null;
            %>
              <tr class="product-row transition-colors hover:bg-brand-teal/[0.03]"
                  data-name="<%= p.name %>" data-barcode="<%= p.barcode || '' %>" data-price="TSh <%= fmt(sell) %>">
                <td class="py-3.5 pl-5 pr-2 sm:pl-6">
                  <input type="checkbox" name="product_ids" value="<%= p.id %>" aria-label="Select <%= p.name %>"
                    class="row-check h-4 w-4 cursor-pointer rounded border-slate-300 text-brand-teal focus:ring-brand-teal">
                </td>

                <td class="px-3 py-3.5">
                  <p class="font-semibold text-slate-800"><%= p.name %></p>
                  <p class="mt-0.5 flex items-center gap-2 text-xs">
                    <% if (p.barcode) { %><span class="font-mono text-slate-500"><%= p.barcode %></span><% } else { %><span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-500">No barcode</span><% } %>
                    <span class="font-semibold tabular-nums text-slate-700 sm:hidden">TSh <%= fmt(sell) %></span>
                  </p>
                </td>

                <td class="px-3 py-3.5">
                  <div class="flex items-center gap-2.5">
                    <span class="min-w-[2rem] text-base font-bold tabular-nums <%= out ? 'text-rose-600' : low ? 'text-amber-600' : 'text-slate-800' %>"><%= qty %></span>
                    <% if (out) { %>
                      <span class="rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-600/15">Out of stock</span>
                    <% } else if (low) { %>
                      <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/20">Low</span>
                    <% } else { %>
                      <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/15">In stock</span>
                    <% } %>
                  </div>
                </td>

                <td class="hidden px-3 py-3.5 tabular-nums text-slate-600 lg:table-cell">TSh <%= fmt(buy) %></td>

                <td class="hidden px-3 py-3.5 sm:table-cell">
                  <p class="font-semibold tabular-nums text-slate-900">TSh <%= fmt(sell) %></p>
                  <% if (margin !== null) { %><p class="text-xs <%= margin < 0 ? 'text-rose-600' : 'text-slate-500' %>"><%= margin %>% margin</p><% } %>
                </td>

                <td class="py-3.5 pl-3 pr-5 text-right sm:pr-6">
                  <div class="inline-flex items-center gap-1">
                    <% if (p.barcode) { %>
                      <button type="button" data-action="label" title="Print label" aria-label="Print label for <%= p.name %>"
                        class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-brand-teal/10 hover:text-brand-teal"><i class="fas fa-print text-sm"></i></button>
                    <% } %>
                    <a href="/products/edit/<%= p.id %>" title="Edit" aria-label="Edit <%= p.name %>"
                      class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-brand-gold/10 hover:text-brand-goldHover"><i class="fas fa-edit text-sm"></i></a>
                    <button type="button" data-action="delete" data-url="/products/delete/<%= p.id %>" data-name="<%= p.name %>" title="Delete" aria-label="Delete <%= p.name %>"
                      class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-rose-50 hover:text-rose-600"><i class="fas fa-trash-alt text-sm"></i></button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="px-6 py-14 text-center">
              <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-teal/10 text-brand-teal"><i class="fas fa-box-open text-lg"></i></span>
              <% if (chips.length) { %>
                <p class="mt-4 text-sm font-semibold text-slate-800">No products match these filters</p>
                <p class="mt-1 text-sm text-slate-500">Try removing a filter or searching a shorter name.</p>
                <a href="/products" class="mt-4 inline-flex rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-brand-teal hover:bg-brand-teal/5">Clear all filters</a>
              <% } else { %>
                <p class="mt-4 text-sm font-semibold text-slate-800">No products yet</p>
                <p class="mt-1 text-sm text-slate-500">Add your first product to start tracking stock.</p>
                <a href="/products/create" class="mt-4 inline-flex rounded-xl bg-brand-gold px-4 py-2 text-sm font-semibold text-white hover:bg-brand-goldHover">Add product</a>
              <% } %>
            </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
      <nav aria-label="Pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 px-5 py-4 sm:px-6">
        <p class="text-sm text-slate-500">Page <span class="font-semibold text-slate-800"><%= cur %></span> of <span class="font-semibold text-slate-800"><%= pages %></span></p>
        <div class="inline-flex items-center gap-1">
          <% if (cur > 1) { %>
            <a href="<%= build(null, cur - 1) %>" aria-label="Previous page" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"><i class="fas fa-chevron-left text-xs"></i></a>
          <% } else { %>
            <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg border border-slate-100 text-slate-300"><i class="fas fa-chevron-left text-xs"></i></span>
          <% } %>

          <% pageList.forEach((n, i) => { %>
            <% if (i > 0 && n - pageList[i - 1] > 1) { %><span class="px-1 text-slate-400">&hellip;</span><% } %>
            <% if (n === cur) { %>
              <span aria-current="page" class="grid h-9 min-w-[2.25rem] place-items-center rounded-lg bg-brand-teal px-2 text-sm font-bold text-white"><%= n %></span>
            <% } else { %>
              <a href="<%= build(null, n) %>" class="grid h-9 min-w-[2.25rem] place-items-center rounded-lg border border-slate-200 px-2 text-sm font-medium text-slate-600 hover:bg-slate-50"><%= n %></a>
            <% } %>
          <% }) %>

          <% if (cur < pages) { %>
            <a href="<%= build(null, cur + 1) %>" aria-label="Next page" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"><i class="fas fa-chevron-right text-xs"></i></a>
          <% } else { %>
            <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg border border-slate-100 text-slate-300"><i class="fas fa-chevron-right text-xs"></i></span>
          <% } %>
        </div>
      </nav>
    <% } %>
  </section>
</div>

<!-- ============ Floating selection bar ============ -->
<div id="bulkBar" role="region" aria-label="Selected products"
  class="!mt-0 fixed bottom-5 left-1/2 z-40 hidden w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 items-center gap-3 rounded-2xl bg-brand-tealDark px-4 py-3 text-white shadow-2xl shadow-black/30 ring-1 ring-white/10 sm:w-auto">
  <p class="flex items-center gap-2 text-sm font-semibold">
    <span id="bulkCount" class="grid h-7 min-w-[1.75rem] place-items-center rounded-lg bg-brand-gold px-1.5 text-xs font-bold">0</span>selected
  </p>
  <span class="h-5 w-px bg-white/20"></span>
  <button type="button" data-action="print-selected" class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-sm font-medium text-teal-50 transition-colors hover:bg-white/10"><i class="fas fa-print text-xs"></i>Print labels</button>
  <button type="button" data-action="bulk-delete" class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-sm font-medium text-rose-300 transition-colors hover:bg-rose-500/15"><i class="fas fa-trash-alt text-xs"></i>Delete</button>
  <button type="button" data-action="clear-selection" aria-label="Clear selection" class="ml-auto grid h-8 w-8 place-items-center rounded-lg text-teal-200 hover:bg-white/10"><i class="fas fa-times"></i></button>
</div>

<!-- ============ Label modal (single, selected and all) ============ -->
<div id="labelModal" role="dialog" aria-modal="true" aria-labelledby="labelTitle"
  class="!mt-0 fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm">
  <div class="flex max-h-[90vh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
      <h3 id="labelTitle" class="flex items-center gap-2 text-base font-bold text-brand-tealDark"><i class="fas fa-print text-brand-teal"></i><span>Print labels</span></h3>
      <button type="button" data-action="close-labels" aria-label="Close" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600"><i class="fas fa-times"></i></button>
    </div>

    <div id="labelPreview" class="flex flex-1 flex-wrap items-start justify-center gap-4 overflow-y-auto bg-slate-100 p-6"></div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 bg-white px-6 py-4">
      <div class="flex items-center gap-4">
        <p id="labelSummary" class="text-sm text-slate-500"></p>
        <div id="copiesWrap" class="hidden items-center gap-2">
          <label for="copies" class="text-sm font-medium text-slate-700">Copies</label>
          <div class="flex overflow-hidden rounded-lg border border-slate-200">
            <button type="button" data-action="copies-dec" aria-label="Fewer copies" class="px-3 py-1.5 text-slate-500 hover:bg-slate-100">&minus;</button>
            <input id="copies" type="number" min="1" max="200" value="1" class="w-14 border-x border-slate-200 text-center text-sm font-semibold focus:outline-none">
            <button type="button" data-action="copies-inc" aria-label="More copies" class="px-3 py-1.5 text-slate-500 hover:bg-slate-100">+</button>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" data-action="close-labels" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50">Cancel</button>
        <button type="button" data-action="print-now" class="inline-flex items-center gap-2 rounded-xl bg-brand-teal px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-tealDark"><i class="fas fa-check text-xs"></i><span id="printBtnText">Print</span></button>
      </div>
    </div>
  </div>
</div>

<style>
  .row-selected { background: rgba(26, 107, 120, .07); }

  /* Label (sticker) look, shared by the preview and the printout */
  .sticker { width: 40mm; box-sizing: border-box; padding: 1.5mm; display: flex; flex-direction: column; align-items: center; justify-content: center;
             text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: #000; background: #fff; }
  .sticker canvas { max-width: 100%; height: auto; }
  .st-name { width: 100%; margin-bottom: 2px; font-size: 9px; font-weight: 700; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .st-price { width: 90%; margin-top: 2px; padding-top: 1px; border-top: 1px dashed #000; font-size: 10px; font-weight: 700; }
  .sticker--preview { min-height: 30mm; padding: 3mm; border: 1px solid #cbd5e1; border-radius: 4px; box-shadow: 0 1px 3px rgba(0,0,0,.12); }

  #printSheet { display: none; }
  @media print {
    body.is-printing > *:not(#printSheet) { display: none !important; }
    body.is-printing #printSheet { display: block !important; }
    #printSheet .sticker { height: 30mm; overflow: hidden; page-break-after: always; break-after: page; }
    #printSheet .sticker:last-child { page-break-after: auto; break-after: auto; }
    @page { size: 40mm 30mm; margin: 0; }
  }
</style>

<script>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var MAX_PREVIEW = 24, queue = [], single = false;

    /* ---------- barcode + sticker helpers (names are inserted as text, never as HTML) ---------- */
    function drawBarcode(canvas, text) {
      try {
        bwipjs.toCanvas(canvas, { bcid: 'code128', text: String(text), scaleX: 1, scaleY: 1, height: 10, includetext: true, textxalign: 'center', textsize: 8 });
      } catch (e) {
        console.error('Barcode failed for', text, e);
        var fb = document.createElement('div'); fb.textContent = text; fb.style.fontSize = '10px';
        canvas.replaceWith(fb);
      }
    }
    function buildSticker(item, cls) {
      var box = document.createElement('div'); box.className = cls;
      var name = document.createElement('div'); name.className = 'st-name'; name.textContent = item.name;
      var canvas = document.createElement('canvas');
      var price = document.createElement('div'); price.className = 'st-price'; price.textContent = item.price;
      box.appendChild(name); box.appendChild(canvas); box.appendChild(price);
      drawBarcode(canvas, item.barcode);
      return box;
    }
    function fromRow(tr) { return { name: tr.dataset.name, barcode: tr.dataset.barcode, price: tr.dataset.price }; }
    function say(opts) { (typeof Dialog !== 'undefined' ? Dialog : Swal).fire(opts); }

    /* ---------- label modal ---------- */
    function copies() { var n = parseInt($('copies').value, 10); return Math.min(200, Math.max(1, isNaN(n) ? 1 : n)); }
    function updateSummary() {
      var total = queue.length * (single ? copies() : 1);
      $('labelSummary').textContent = total + (total === 1 ? ' label' : ' labels') + ' ready' + (queue.length > MAX_PREVIEW ? ' (preview shows the first ' + MAX_PREVIEW + ')' : '');
      $('printBtnText').textContent = 'Print ' + total + (total === 1 ? ' label' : ' labels');
    }
    function openLabels(items, opts) {
      items = items.filter(function (i) { return i.barcode; });
      if (!items.length) { say({ title: 'Nothing to print', text: 'None of these products has a barcode yet.', icon: 'info', iconColor: '#1A6B78', confirmButtonText: 'Got it' }); return; }
      queue = items; single = !!opts.single;
      $('labelTitle').lastElementChild.textContent = opts.title;
      $('copiesWrap').classList.toggle('hidden', !single); $('copiesWrap').classList.toggle('flex', single);
      $('copies').value = 1;
      var box = $('labelPreview'); box.textContent = '';
      queue.slice(0, MAX_PREVIEW).forEach(function (i) { box.appendChild(buildSticker(i, 'sticker sticker--preview')); });
      updateSummary();
      $('labelModal').classList.remove('hidden'); $('labelModal').classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }
    function closeLabels() {
      $('labelModal').classList.add('hidden'); $('labelModal').classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }
    function printNow() {
      var n = single ? copies() : 1, sheet = document.createElement('div'); sheet.id = 'printSheet';
      queue.forEach(function (it) { for (var i = 0; i < n; i++) sheet.appendChild(buildSticker(it, 'sticker')); });
      document.body.appendChild(sheet);
      document.body.classList.add('is-printing');
      function cleanup() {
        window.removeEventListener('afterprint', cleanup);
        document.body.classList.remove('is-printing'); sheet.remove(); closeLabels();
      }
      window.addEventListener('afterprint', cleanup);
      setTimeout(function () { window.print(); }, 150);
    }

    function printAll() {
      say({ title: 'Preparing labels', text: 'Collecting every product that has a barcode.', allowOutsideClick: false, showConfirmButton: false, didOpen: function () { Swal.showLoading(); } });
      fetch('/products/all-printable', { credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (all) {
          Swal.close();
          openLabels((all || []).map(function (p) {
            return { name: p.name, barcode: p.barcode, price: 'TSh ' + Number(p.sell_price || 0).toLocaleString('en-US') };
          }), { title: 'Print all labels' });
        })
        .catch(function (e) { console.error(e); say({ title: 'Could not load labels', text: 'Please check your connection and try again.', icon: 'error', confirmButtonText: 'OK' }); });
    }

    /* ---------- selection ---------- */
    function checked() { return Array.prototype.slice.call(document.querySelectorAll('.row-check:checked')); }
    function syncSelection() {
      var all = document.querySelectorAll('.row-check'), on = checked(), master = $('selectAll'), bar = $('bulkBar');
      all.forEach(function (cb) { cb.closest('tr').classList.toggle('row-selected', cb.checked); });
      if (master) { master.checked = on.length > 0 && on.length === all.length; master.indeterminate = on.length > 0 && on.length < all.length; }
      $('bulkCount').textContent = on.length;
      bar.classList.toggle('hidden', on.length === 0); bar.classList.toggle('flex', on.length > 0);
    }

    /* ---------- deleting (red confirmation) ---------- */
    var DANGER = {
      popup: 'rounded-2xl border border-slate-200 shadow-2xl p-6', title: 'text-lg font-bold text-slate-800', htmlContainer: 'text-sm text-slate-500', actions: 'gap-2 mt-4',
      confirmButton: 'rounded-xl bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-400',
      cancelButton: 'rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50'
    };
    function confirmDelete(title, text, yes) {
      Swal.fire({ title: title, text: text, icon: 'warning', iconColor: '#e11d48', showCancelButton: true, reverseButtons: true, buttonsStyling: false,
                  confirmButtonText: 'Yes, delete', cancelButtonText: 'Keep it', customClass: DANGER }).then(function (r) { if (r.isConfirmed) yes(); });
    }
    function bulkDelete() {
      var boxes = checked(); if (!boxes.length) return;
      confirmDelete('Delete ' + boxes.length + (boxes.length === 1 ? ' product?' : ' products?'), 'They will be removed from your inventory permanently. This cannot be undone.', function () {
        var form = document.createElement('form'); form.method = 'POST'; form.action = '/products/bulk-delete';
        boxes.forEach(function (cb) { var i = document.createElement('input'); i.type = 'hidden'; i.name = 'productIds'; i.value = cb.value; form.appendChild(i); });
        document.body.appendChild(form); form.submit();
      });
    }

    /* ---------- events ---------- */
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-action]'); if (!btn) return;
      var tr = btn.closest('tr'), a = btn.dataset.action;
      if (a === 'label')           openLabels([fromRow(tr)], { single: true, title: 'Print label' });
      else if (a === 'print-all')  printAll();
      else if (a === 'print-selected') openLabels(checked().map(function (cb) { return fromRow(cb.closest('tr')); }), { title: 'Print selected labels' });
      else if (a === 'bulk-delete') bulkDelete();
      else if (a === 'clear-selection') { document.querySelectorAll('.row-check').forEach(function (c) { c.checked = false; }); syncSelection(); }
      else if (a === 'close-labels') closeLabels();
      else if (a === 'print-now')  printNow();
      else if (a === 'copies-dec') { $('copies').value = Math.max(1, copies() - 1); updateSummary(); }
      else if (a === 'copies-inc') { $('copies').value = Math.min(200, copies() + 1); updateSummary(); }
      else if (a === 'delete') {
        var url = btn.dataset.url;
        confirmDelete('Delete this product?', '"' + btn.dataset.name + '" will be removed permanently. This cannot be undone.', function () { window.location.href = url; });
      }
    });

    document.addEventListener('change', function (e) {
      if (e.target.id === 'selectAll') { document.querySelectorAll('.row-check').forEach(function (c) { c.checked = e.target.checked; }); syncSelection(); }
      else if (e.target.classList.contains('row-check')) syncSelection();
      else if (e.target.name === 'status') $('filterForm').submit();
    });
    document.addEventListener('input', function (e) { if (e.target.id === 'copies') updateSummary(); });
    $('labelModal').addEventListener('click', function (e) { if (e.target === this) closeLabels(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLabels(); });

    /* Keep the scanner ready */
    document.addEventListener('DOMContentLoaded', function () {
      var scan = $('barcodeScanInput');
      if (scan) { scan.focus(); if (scan.value) scan.select(); }
    });
  })();
</script>

