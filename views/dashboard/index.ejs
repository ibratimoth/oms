<%- include('../layouts/header') %>
<%
  /* ---------- helpers & derived values (no new data needed from the controller) ---------- */
  const L       = locals;
  const num     = (v) => Number(v || 0);
  const money   = (v) => num(v).toLocaleString('en-US');
  const pct     = (a, b) => b > 0 ? Math.max(0, Math.min(100, Math.round((a / b) * 100))) : 0;
  const admin   = typeof userRole !== 'undefined' && (userRole === 'superadmin' || userRole === 'admin');
  const who     = (typeof username !== 'undefined' && username) ? username : '';

  const net       = num(L.netFinancialPosition);
  const cash      = num(L.cashInHand);
  const rec       = num(L.debtsOwedToYou);
  const pay       = num(L.debtsYouOwe);
  const recShare  = (rec + pay) > 0 ? Math.round((rec / (rec + pay)) * 100) : 50;

  const ordersAll = num(L.totalOrders), ordersDone = num(L.completedOrders), ordersPend = num(L.pendingOrders);
  const donePct   = pct(ordersDone, ordersAll);

  const sales     = num(L.totalSales);
  const margin    = sales > 0 ? Math.round((num(L.totalProfit) / sales) * 1000) / 10 : 0;

  const days      = (L.dailySales || []).map(d => ({ date: d.dataValues.date, sales: num(d.dataValues.sales) }));
  const maxDay    = days.reduce((m, d) => Math.max(m, d.sales), 0);

  const statusStyle = (s) => ({
    completed: 'bg-emerald-50 text-emerald-700 ring-emerald-600/15',
    pending:   'bg-amber-50 text-amber-700 ring-amber-600/20',
    cancelled: 'bg-rose-50 text-rose-700 ring-rose-600/15'
  }[String(s || '').toLowerCase()] || 'bg-slate-100 text-slate-600 ring-slate-500/15');

  /* Performance cells: Sales is the wide one; admin-only figures are added for admins */
  const cells = [
    { label: 'Total sales', value: L.totalSales, icon: 'fa-chart-line', tint: 'bg-sky-50 text-sky-600', tone: 'text-brand-tealDark', span: 'col-span-2', big: true },
  ];
  if (admin) cells.push({ label: 'Gross profit', value: L.totalProfit, icon: 'fa-wallet', tint: 'bg-emerald-50 text-emerald-600', tone: 'text-emerald-700', span: 'col-span-2 sm:col-span-1', note: margin + '% margin' });
  cells.push({ label: 'Total expenses', value: L.totalExpenses, icon: 'fa-receipt', tint: 'bg-rose-50 text-rose-600', tone: 'text-rose-600', span: admin ? 'col-span-1' : 'col-span-2 sm:col-span-1' });
  if (admin) {
    cells.push({ label: 'Cost of goods sold', value: L.totalSoldProductsCost, icon: 'fa-tags', tint: 'bg-amber-50 text-amber-600', tone: 'text-amber-700', span: 'col-span-1' });
    cells.push({ label: 'Stock value at cost', value: L.totalRegisteredProductsCost, icon: 'fa-warehouse', tint: 'bg-teal-50 text-brand-teal', tone: 'text-brand-teal', span: 'col-span-2 sm:col-span-1' });
  }
%>

<div id="dash" class="space-y-6">

  <!-- ============ Greeting + actions ============ -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-brand-tealDark">
        <span id="greeting">Welcome</span><%= who ? ', ' + who : '' %>
      </h2>
      <p class="mt-1 text-sm text-slate-500">Here is where the business stands right now.</p>
    </div>
    <div class="flex items-center gap-2">
      <button id="privacyToggle" type="button" aria-pressed="false"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-brand-teal/40 hover:text-brand-teal">
        <i class="far fa-eye text-xs"></i><span>Hide amounts</span>
      </button>
      <a href="/products/create"
        class="inline-flex items-center gap-2 rounded-xl bg-brand-gold px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-goldHover">
        <i class="fas fa-plus text-xs"></i>Add product
      </a>
    </div>
  </div>

  <!-- ============ Hero: net position ============ -->
  <section class="overflow-hidden rounded-2xl bg-brand-tealDark text-white shadow-lg shadow-brand-tealDark/15">
    <div class="h-1 bg-brand-gold"></div>
    <div class="grid lg:grid-cols-5">
      <div class="p-6 sm:p-8 lg:col-span-3">
        <p class="text-sm font-medium text-teal-200">Net financial position</p>
        <p class="mt-3 flex flex-wrap items-baseline gap-x-3 tabular-nums">
          <span class="text-xl font-semibold text-brand-gold">TSh</span>
          <span class="amt text-4xl font-extrabold tracking-tight sm:text-6xl <%= net < 0 ? 'text-rose-200' : '' %>"><%= money(net) %></span>
        </p>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-teal-100/80">
          Cash in hand, plus what customers owe you, minus what you owe others.
          <% if (net < 0) { %><span class="mt-1 block font-medium text-rose-200">Your liabilities are currently higher than your cash and receivables.</span><% } %>
        </p>
      </div>

      <div class="border-t border-white/10 bg-black/10 p-6 sm:p-8 lg:col-span-2 lg:border-l lg:border-t-0">
        <dl class="space-y-3.5 text-sm tabular-nums">
          <div class="flex items-center justify-between gap-3">
            <dt class="flex items-center gap-2.5 text-teal-100"><span class="grid h-6 w-6 place-items-center rounded-md bg-emerald-400/20 text-emerald-300"><i class="fas fa-plus text-[10px]"></i></span>Cash in hand</dt>
            <dd class="amt font-semibold">TSh <%= money(cash) %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="flex items-center gap-2.5 text-teal-100"><span class="grid h-6 w-6 place-items-center rounded-md bg-emerald-400/20 text-emerald-300"><i class="fas fa-plus text-[10px]"></i></span>Owed to you</dt>
            <dd class="amt font-semibold">TSh <%= money(rec) %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="flex items-center gap-2.5 text-teal-100"><span class="grid h-6 w-6 place-items-center rounded-md bg-rose-400/20 text-rose-300"><i class="fas fa-minus text-[10px]"></i></span>You owe</dt>
            <dd class="amt font-semibold">TSh <%= money(pay) %></dd>
          </div>
        </dl>
        <p class="mt-5 border-t border-white/10 pt-4 text-xs leading-relaxed text-teal-200/80">
          Cash in hand is collected sales minus paid expenses. It is money you can use today.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ Performance + Orders ============ -->
  <div class="grid gap-6 lg:grid-cols-12">

    <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white lg:col-span-8">
      <div class="flex items-center justify-between px-6 pt-5">
        <h3 class="text-[15px] font-semibold text-slate-800">Performance</h3>
        <a href="/analytics" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">Full analytics</a>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-px border-t border-slate-200/80 bg-slate-200/80 sm:grid-cols-3">
        <% cells.forEach(c => { %>
          <div class="bg-white p-5 sm:p-6 <%= c.span %>">
            <div class="flex items-center gap-2.5">
              <span class="grid h-8 w-8 place-items-center rounded-lg <%= c.tint %>"><i class="fas <%= c.icon %> text-[13px]"></i></span>
              <p class="text-sm text-slate-500"><%= c.label %></p>
            </div>
            <p class="mt-3 tabular-nums <%= c.tone %>">
              <span class="text-sm font-medium opacity-70">TSh</span>
              <span class="amt <%= c.big ? 'text-3xl' : 'text-2xl' %> font-bold tracking-tight"><%= money(c.value) %></span>
            </p>
            <% if (c.note) { %><p class="mt-1.5 inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700"><%= c.note %></p><% } %>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200/80 bg-white p-6 lg:col-span-4">
      <div class="flex items-center justify-between">
        <h3 class="text-[15px] font-semibold text-slate-800">Orders</h3>
        <a href="/orders" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">View all</a>
      </div>

      <p class="mt-4 flex items-baseline gap-2 tabular-nums">
        <span class="text-4xl font-extrabold tracking-tight text-brand-tealDark"><%= ordersAll %></span>
        <span class="text-sm text-slate-500">orders in total</span>
      </p>

      <div class="mt-5 h-2.5 overflow-hidden rounded-full bg-amber-100" role="img" aria-label="<%= donePct %> percent of orders completed">
        <div class="h-full rounded-full bg-emerald-500" style="width: <%= donePct %>%"></div>
      </div>
      <p class="mt-2 text-xs text-slate-500"><%= donePct %>% completed</p>

      <dl class="mt-5 space-y-3 text-sm">
        <div class="flex items-center justify-between"><dt class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>Completed</dt><dd class="font-semibold tabular-nums text-slate-800"><%= ordersDone %></dd></div>
        <div class="flex items-center justify-between"><dt class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>Pending</dt><dd class="font-semibold tabular-nums text-slate-800"><%= ordersPend %></dd></div>
        <div class="flex items-center justify-between border-t border-slate-100 pt-3"><dt class="flex items-center gap-2 text-slate-600"><i class="fas fa-box w-2.5 text-xs text-brand-teal"></i>Products in catalog</dt><dd class="font-semibold tabular-nums text-slate-800"><%= L.totalProducts %></dd></div>
      </dl>
    </section>
  </div>

  <!-- ============ Daily sales + Debts ============ -->
  <div class="grid gap-6 lg:grid-cols-12">

    <section class="rounded-2xl border border-slate-200/80 bg-white lg:col-span-7">
      <div class="px-6 pt-5">
        <h3 class="text-[15px] font-semibold text-slate-800">Daily sales</h3>
        <p class="mt-0.5 text-sm text-slate-500">Bars are compared with your best day.</p>
      </div>
      <% if (days.length) { %>
        <ul class="mt-4 max-h-[22rem] divide-y divide-slate-100 overflow-y-auto border-t border-slate-100 px-6">
          <% days.forEach(d => { %>
            <li class="grid grid-cols-[6.5rem_1fr_auto] items-center gap-4 py-3 text-sm sm:grid-cols-[8rem_1fr_auto]">
              <span class="font-medium text-slate-600"><%= d.date %></span>
              <span class="h-2 overflow-hidden rounded-full bg-slate-100">
                <span class="block h-full rounded-full bg-brand-teal" style="width: <%= pct(d.sales, maxDay) %>%"></span>
              </span>
              <span class="amt text-right font-semibold tabular-nums text-slate-800">TSh <%= money(d.sales) %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="mt-4 border-t border-slate-100 px-6 py-10 text-center">
          <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-slate-100 text-slate-400"><i class="fas fa-chart-line"></i></span>
          <p class="mt-3 text-sm font-medium text-slate-700">No sales recorded yet</p>
          <p class="mt-1 text-sm text-slate-500">Daily totals will appear here after your first completed order.</p>
        </div>
      <% } %>
    </section>

    <section class="rounded-2xl border border-slate-200/80 bg-white p-6 lg:col-span-5">
      <div class="flex items-center justify-between">
        <h3 class="text-[15px] font-semibold text-slate-800">Debts</h3>
        <a href="/debts" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">Open ledger</a>
      </div>

      <div class="mt-5 flex h-3 overflow-hidden rounded-full bg-slate-100" role="img" aria-label="<%= recShare %> percent receivable, <%= 100 - recShare %> percent payable">
        <div class="h-full bg-brand-teal" style="width: <%= recShare %>%"></div>
        <div class="h-full bg-brand-gold" style="width: <%= 100 - recShare %>%"></div>
      </div>

      <dl class="mt-5 space-y-4">
        <div class="flex items-start justify-between gap-3">
          <dt><p class="flex items-center gap-2 text-sm font-medium text-slate-700"><span class="h-2.5 w-2.5 rounded-full bg-brand-teal"></span>Owed to you</p><p class="mt-0.5 pl-4 text-xs text-slate-500">Customers who still need to pay</p></dt>
          <dd class="amt text-right text-lg font-bold tabular-nums text-brand-teal">TSh <%= money(rec) %></dd>
        </div>
        <div class="flex items-start justify-between gap-3">
          <dt><p class="flex items-center gap-2 text-sm font-medium text-slate-700"><span class="h-2.5 w-2.5 rounded-full bg-brand-gold"></span>You owe</p><p class="mt-0.5 pl-4 text-xs text-slate-500">Suppliers and others you must pay</p></dt>
          <dd class="amt text-right text-lg font-bold tabular-nums text-amber-700">TSh <%= money(pay) %></dd>
        </div>
      </dl>

      <p class="mt-5 rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
        <% if (rec >= pay) { %>
          You are owed <span class="amt font-semibold text-slate-800">TSh <%= money(rec - pay) %></span> more than you owe.
        <% } else { %>
          You owe <span class="amt font-semibold text-slate-800">TSh <%= money(pay - rec) %></span> more than you are owed.
        <% } %>
      </p>
    </section>
  </div>

  <!-- ============ Recent orders + Low stock ============ -->
  <div class="grid gap-6 lg:grid-cols-12">

    <section class="rounded-2xl border border-slate-200/80 bg-white lg:col-span-7">
      <div class="flex items-center justify-between px-6 pt-5">
        <h3 class="text-[15px] font-semibold text-slate-800">Recent orders</h3>
        <a href="/orders" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">View all</a>
      </div>
      <div class="mt-4 overflow-x-auto border-t border-slate-100">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="text-xs font-medium text-slate-500">
              <th scope="col" class="px-6 py-3">Order</th>
              <th scope="col" class="px-6 py-3">Status</th>
              <th scope="col" class="px-6 py-3 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (L.recentOrders && L.recentOrders.length > 0) { %>
              <% L.recentOrders.forEach(o => { %>
                <tr class="transition-colors hover:bg-brand-teal/[0.03]">
                  <td class="px-6 py-3.5 font-semibold text-slate-800">#<%= o.order_number %></td>
                  <td class="px-6 py-3.5">
                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium capitalize ring-1 ring-inset <%= statusStyle(o.status) %>">
                      <span class="h-1.5 w-1.5 rounded-full bg-current"></span><%= o.status %>
                    </span>
                  </td>
                  <td class="amt px-6 py-3.5 text-right font-semibold tabular-nums text-slate-800">TSh <%= money(o.total_amount) %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="3" class="px-6 py-10 text-center">
                <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-slate-100 text-slate-400"><i class="fas fa-shopping-cart"></i></span>
                <p class="mt-3 text-sm font-medium text-slate-700">No orders yet</p>
                <p class="mt-1 text-sm text-slate-500">New orders will show up here as soon as they are created.</p>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200/80 bg-white lg:col-span-5">
      <div class="flex items-center justify-between px-6 pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800">
          Low stock
          <% if (L.lowStockProducts && L.lowStockProducts.length > 0) { %>
            <span class="rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700"><%= L.lowStockProducts.length %></span>
          <% } %>
        </h3>
        <a href="/products" class="text-sm font-medium text-brand-teal hover:text-brand-tealDark">Manage products</a>
      </div>
      <% if (L.lowStockProducts && L.lowStockProducts.length > 0) { %>
        <ul class="mt-4 max-h-[22rem] divide-y divide-slate-100 overflow-y-auto border-t border-slate-100">
          <% L.lowStockProducts.forEach(p => { const left = num(p.quantity_in_stock); %>
            <li class="flex items-center justify-between gap-3 px-6 py-3.5 text-sm">
              <span class="flex min-w-0 items-center gap-3">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg <%= left === 0 ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>"><i class="fas fa-box text-xs"></i></span>
                <span class="truncate font-medium text-slate-700"><%= p.name %></span>
              </span>
              <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold <%= left === 0 ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700' %>">
                <%= left === 0 ? 'Out of stock' : left + ' left' %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="mt-4 border-t border-slate-100 px-6 py-10 text-center">
          <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-50 text-emerald-600"><i class="fas fa-check"></i></span>
          <p class="mt-3 text-sm font-medium text-slate-700">Everything is well stocked</p>
          <p class="mt-1 text-sm text-slate-500">Products that run low will be listed here.</p>
        </div>
      <% } %>
    </section>
  </div>

</div>

<style>
  /* "Hide amounts" privacy mode */
  #dash.privacy .amt { filter: blur(9px); user-select: none; }
  .amt { transition: filter .2s ease; }
</style>

<script>
  (function () {
    /* Time-aware greeting */
    var h = new Date().getHours();
    document.getElementById('greeting').textContent = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';

    /* Hide / show amounts, remembered on this device */
    var dash = document.getElementById('dash'),
        btn  = document.getElementById('privacyToggle'),
        KEY  = 'dv_hide_amounts';

    function apply(on) {
      dash.classList.toggle('privacy', on);
      btn.setAttribute('aria-pressed', on);
      btn.querySelector('span').textContent = on ? 'Show amounts' : 'Hide amounts';
      btn.querySelector('i').className = (on ? 'far fa-eye-slash' : 'far fa-eye') + ' text-xs';
    }

    var saved = false;
    try { saved = localStorage.getItem(KEY) === '1'; } catch (e) {}
    apply(saved);

    btn.addEventListener('click', function () {
      var on = !dash.classList.contains('privacy');
      apply(on);
      try { localStorage.setItem(KEY, on ? '1' : '0'); } catch (e) {}
    });
  })();
</script>

<%- include('../layouts/footer') %>
