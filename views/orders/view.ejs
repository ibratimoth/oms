<%- include('../layouts/header') %>
<%
  /* ---------- derived values ---------- */
  const money   = (v) => Number(v || 0).toLocaleString('en-US');
  const items   = (order.OrderItems && order.OrderItems.length) ? order.OrderItems : [];
  const accts   = (typeof merchants !== 'undefined' && merchants) ? merchants : [];
  const total   = Number(order.total_amount || 0);
  const disc    = Number(order.discount || 0);
  const final   = Number(order.final_amount || (total - disc) || total);
  const done    = order.status === 'completed';
  const units   = items.reduce((s, i) => s + Number(i.quantity || 0), 0);
  const created = order.createdAt ? new Date(order.createdAt) : null;
  const iso     = (d) => (d && !isNaN(d)) ? d.toISOString() : '';
  const doneAt  = order.completed_at ? new Date(order.completed_at) : null;

  const METHODS = { CASH: 'Cash', LIPA_NUMBER: 'Lipa number', CREDIT: 'Credit' };
  const merchantName = order.Merchant ? order.Merchant.name : '';
  const merchantLabel = (m) => { const x = [m.provider, m.account_number].filter(Boolean).join(' - '); return x ? m.name + ' (' + x + ')' : m.name; };

  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const pill = (s) => {
    s = esc(s);
    if (s === 'completed') return '<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold capitalize text-emerald-700 ring-1 ring-inset ring-emerald-600/15"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>' + s + '</span>';
    if (s === 'pending')   return '<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold capitalize text-amber-700 ring-1 ring-inset ring-amber-600/20"><span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"></span></span>' + s + '</span>';
    return '<span class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1 text-sm font-semibold capitalize text-sky-700 ring-1 ring-inset ring-sky-600/15"><span class="h-2 w-2 rounded-full bg-sky-500"></span>' + (s || 'unknown') + '</span>';
  };
%>

<div class="mx-auto max-w-6xl space-y-6">

  <!-- ============ Header ============ -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-slate-500">
        <a href="/orders" class="group inline-flex items-center gap-2 font-medium transition-colors hover:text-brand-teal"><i class="fas fa-arrow-left text-xs transition-transform group-hover:-translate-x-0.5"></i>Orders</a>
        <i class="fas fa-chevron-right text-[10px] text-slate-300"></i><span class="text-slate-700">Details</span>
      </nav>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h2 class="text-3xl font-extrabold tracking-tight text-brand-tealDark">Order #<%= order.order_number %></h2>
        <%- pill(order.status) %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a href="/orders/invoice/<%= order.id %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-teal/40 hover:text-brand-teal">
        <i class="fas fa-print text-xs"></i>Print invoice
      </a>
      <% if (!done) { %>
        <a href="/orders/edit/<%= order.id %>" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-gold/50 hover:text-brand-goldHover">
          <i class="fas fa-edit text-xs"></i>Edit
        </a>
        <button type="button" data-open-complete class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-700">
          <i class="fas fa-check text-xs"></i>Complete order
        </button>
      <% } %>
    </div>
  </div>

  <div class="grid items-start gap-6 lg:grid-cols-3">

    <!-- ============ Invoice ============ -->
    <article class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white lg:col-span-2">
      <div class="h-1.5 bg-brand-teal"></div>

      <div class="flex flex-wrap items-start justify-between gap-4 px-6 pt-6 sm:px-8">
        <div class="flex items-center gap-3">
          <img src="/images/delleventures.jpeg" alt="Delle Ventures" class="h-11 w-11 rounded-xl border border-slate-200 bg-white object-contain p-1">
          <div><p class="text-base font-bold leading-tight text-brand-tealDark">Delle <span class="text-brand-gold">Ventures</span></p><p class="text-xs text-slate-500">Order summary</p></div>
        </div>
        <div class="text-right text-sm">
          <p class="text-slate-500">Placed on</p>
          <p class="font-semibold text-slate-800"><% if (created && !isNaN(created)) { %><time data-dt datetime="<%= iso(created) %>"><%= iso(created).substr(0, 10) %></time><% } else { %>-<% } %></p>
        </div>
      </div>

      <div class="mt-6 grid gap-4 px-6 sm:grid-cols-2 sm:px-8">
        <div class="rounded-xl bg-slate-50 px-4 py-3.5">
          <p class="text-xs font-medium text-slate-500">Customer</p>
          <p class="mt-1 text-sm font-semibold text-slate-800"><%= order.customer_name || 'Walk-in customer' %></p>
          <p class="mt-0.5 text-sm <%= order.customer_phone ? 'font-mono text-slate-600' : 'italic text-slate-400' %>"><%= order.customer_phone || 'No phone number' %></p>
        </div>
        <div class="rounded-xl bg-slate-50 px-4 py-3.5">
          <p class="text-xs font-medium text-slate-500">Items</p>
          <p class="mt-1 text-sm font-semibold text-slate-800"><%= items.length %> <%= items.length === 1 ? 'product' : 'products' %></p>
          <p class="mt-0.5 text-sm text-slate-600"><%= units %> <%= units === 1 ? 'unit' : 'units' %> in total</p>
        </div>
      </div>

      <!-- Items -->
      <div class="mt-6 overflow-x-auto border-t border-slate-100">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="text-xs font-medium text-slate-500">
              <th scope="col" class="hidden w-12 px-6 py-3 text-center sm:table-cell sm:pl-8">#</th>
              <th scope="col" class="px-6 py-3 sm:px-3">Product</th>
              <th scope="col" class="px-3 py-3 text-center">Qty</th>
              <th scope="col" class="hidden px-3 py-3 text-right sm:table-cell">Unit price</th>
              <th scope="col" class="px-6 py-3 text-right sm:pr-8">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (items.length) { %>
              <% items.forEach((item, i) => { %>
                <tr>
                  <td class="hidden px-6 py-4 text-center font-mono text-xs text-slate-400 sm:table-cell sm:pl-8"><%= i + 1 %></td>
                  <td class="px-6 py-4 sm:px-3">
                    <p class="font-semibold text-slate-800"><%= item.Product ? item.Product.name : 'Unknown item' %></p>
                    <p class="mt-0.5 text-xs tabular-nums text-slate-500 sm:hidden">TSh <%= money(item.unit_price) %> each</p>
                  </td>
                  <td class="px-3 py-4 text-center font-semibold tabular-nums text-slate-700"><%= item.quantity %></td>
                  <td class="hidden px-3 py-4 text-right tabular-nums text-slate-600 sm:table-cell">TSh <%= money(item.unit_price) %></td>
                  <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-900 sm:pr-8">TSh <%= money(item.subtotal) %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="px-6 py-10 text-center text-sm text-slate-500">This order has no items.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Totals -->
      <div class="border-t border-slate-100 bg-slate-50/60 px-6 py-6 sm:px-8">
        <dl class="ml-auto max-w-xs space-y-2.5 text-sm tabular-nums">
          <div class="flex items-center justify-between"><dt class="text-slate-500">Subtotal</dt><dd class="font-medium text-slate-800">TSh <%= money(total) %></dd></div>
          <% if (disc > 0) { %>
            <div class="flex items-center justify-between"><dt class="text-slate-500">Discount</dt><dd class="font-semibold text-amber-700">-TSh <%= money(disc) %></dd></div>
          <% } %>
          <div class="flex items-baseline justify-between border-t border-slate-200 pt-3">
            <dt class="font-semibold text-slate-800"><%= done ? 'Total paid' : 'Amount to collect' %></dt>
            <dd class="text-2xl font-extrabold tracking-tight text-brand-tealDark"><span class="text-sm font-semibold text-brand-gold">TSh</span> <%= money(final) %></dd>
          </div>
        </dl>
        <% if (!done) { %>
          <p class="mt-4 flex items-start gap-2 text-sm text-slate-500"><i class="fas fa-info-circle mt-0.5 text-xs text-brand-teal"></i>This order is still open. Complete it once the customer has paid, and you can apply a discount then.</p>
        <% } %>
      </div>
    </article>

    <!-- ============ Side panels ============ -->
    <aside class="space-y-6">

      <section class="rounded-2xl border border-slate-200/80 bg-white p-6">
        <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Progress</h3>
        <ol class="mt-5">
          <li class="relative flex gap-3 pb-6">
            <span class="absolute left-[0.95rem] top-8 h-[calc(100%-1.5rem)] w-px <%= done ? 'bg-emerald-300' : 'bg-slate-200' %>"></span>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-teal text-white"><i class="fas fa-receipt text-xs"></i></span>
            <div><p class="text-sm font-semibold text-slate-800">Order placed</p><p class="text-xs text-slate-500"><% if (created && !isNaN(created)) { %><time data-dt-full datetime="<%= iso(created) %>"><%= iso(created).substr(0, 10) %></time><% } %></p></div>
          </li>
          <li class="flex gap-3">
            <% if (done) { %>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-emerald-500 text-white"><i class="fas fa-check text-xs"></i></span>
              <div><p class="text-sm font-semibold text-slate-800">Completed</p><p class="text-xs text-slate-500"><% if (doneAt && !isNaN(doneAt)) { %><time data-dt-full datetime="<%= iso(doneAt) %>"><%= iso(doneAt).substr(0, 10) %></time><% } else { %>Payment recorded<% } %></p></div>
            <% } else { %>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border-2 border-dashed border-amber-400 text-amber-500"><i class="fas fa-hourglass-half text-xs"></i></span>
              <div><p class="text-sm font-semibold text-slate-800">Waiting for payment</p><p class="text-xs text-slate-500">Complete the order when the customer pays</p></div>
            <% } %>
          </li>
        </ol>
      </section>

      <% if (done && (order.payment_method || merchantName)) { %>
        <section class="rounded-2xl border border-slate-200/80 bg-white p-6">
          <h3 class="flex items-center gap-2 text-[15px] font-semibold text-slate-800"><span class="h-4 w-1 rounded-full bg-brand-gold"></span>Payment</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <% if (order.payment_method) { %><div class="flex items-center justify-between gap-3"><dt class="text-slate-500">Method</dt><dd class="font-semibold text-slate-800"><%= METHODS[order.payment_method] || order.payment_method %></dd></div><% } %>
            <% if (merchantName) { %><div class="flex items-center justify-between gap-3"><dt class="text-slate-500">Account</dt><dd class="font-semibold text-slate-800"><%= merchantName %></dd></div><% } %>
          </dl>
        </section>
      <% } %>

      <% if (!done) { %>
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white">
          <div class="h-1 bg-brand-gold"></div>
          <div class="p-6">
            <p class="text-sm font-semibold text-slate-800">Ready to collect payment?</p>
            <p class="mt-1 text-sm text-slate-500">Record how it was paid to close this order.</p>
            <button type="button" data-open-complete class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-700"><i class="fas fa-check text-xs"></i>Complete order</button>
          </div>
        </section>
      <% } %>
    </aside>
  </div>
</div>

<% if (!done) { %>
<!-- ============ Complete order dialog ============ -->
<div id="completeModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" class="!mt-0 fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm">
  <div class="max-h-[92vh] w-full max-w-md overflow-y-auto rounded-2xl bg-white shadow-2xl">
    <div class="h-1 bg-brand-gold"></div>
    <div class="flex items-start justify-between gap-4 px-6 pt-5">
      <div><h3 id="modalTitle" class="text-lg font-bold text-brand-tealDark">Complete order #<%= order.order_number %></h3><p class="mt-0.5 text-sm text-slate-500"><%= order.customer_name || 'Walk-in customer' %></p></div>
      <button type="button" data-close aria-label="Close" class="grid h-9 w-9 place-items-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600"><i class="fas fa-times"></i></button>
    </div>

    <form id="completeForm" method="POST" action="/orders/complete/<%= order.id %>" class="px-6 pb-6 pt-4">
      <div class="rounded-xl bg-teal-50 px-4 py-3">
        <p class="text-xs font-medium text-brand-teal">Amount to collect</p>
        <p class="mt-0.5 text-2xl font-extrabold tabular-nums text-brand-tealDark">TSh <span id="dueAmount"><%= money(total) %></span></p>
        <p id="discountNote" class="mt-0.5 hidden text-xs text-slate-600"></p>
      </div>

      <fieldset class="mt-5">
        <legend class="mb-2 text-sm font-medium text-slate-700">How was it paid?</legend>
        <div class="grid gap-2">
          <% [['CASH', 'fa-money-bill-wave', 'Cash', 'Paid in hand'], ['LIPA_NUMBER', 'fa-mobile-alt', 'Lipa number', 'Mobile money, till or QR'], ['CREDIT', 'fa-file-invoice-dollar', 'Credit', 'Customer pays later']].forEach((m, i) => { %>
            <label class="cursor-pointer">
              <input type="radio" name="payment_method" value="<%= m[0] %>" class="peer sr-only" <%= i === 0 ? 'checked' : '' %>>
              <span class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 transition-all peer-checked:border-brand-teal peer-checked:bg-brand-teal/5 peer-checked:ring-2 peer-checked:ring-brand-teal/15 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-gold">
                <span class="grid h-9 w-9 place-items-center rounded-lg bg-slate-100 text-slate-500"><i class="fas <%= m[1] %> text-sm"></i></span>
                <span><span class="block text-sm font-semibold text-slate-800"><%= m[2] %></span><span class="block text-xs text-slate-500"><%= m[3] %></span></span>
              </span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <div id="merchantBox" class="mt-4 hidden">
        <label for="merchantSelect" class="mb-1.5 block text-sm font-medium text-slate-700">Merchant account</label>
        <% if (accts.length) { %>
          <select id="merchantSelect" name="merchant_id" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20">
            <option value="">Select a merchant account</option>
            <% accts.forEach(m => { %><option value="<%= m.id %>"><%= merchantLabel(m) %></option><% }) %>
          </select>
        <% } else { %>
          <p class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">You have no merchant accounts yet. <a href="/merchants" class="font-semibold underline">Add one</a> before using this payment method.</p>
          <input type="hidden" id="merchantSelect" name="merchant_id" value="">
        <% } %>
      </div>

      <div class="mt-4">
        <label for="discount" class="mb-1.5 block text-sm font-medium text-slate-700">Discount <span class="font-normal text-slate-400">(optional)</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">TSh</span>
          <input type="number" id="discount" name="discount" min="0" max="<%= total %>" inputmode="numeric" placeholder="0" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-11 pr-3 text-sm tabular-nums text-slate-800 focus:border-brand-teal focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-teal/20">
        </div>
        <p class="mt-1.5 text-xs text-slate-500">It cannot be more than TSh <%= money(total) %>.</p>
      </div>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button" data-close class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50">Cancel</button>
        <button type="submit" id="confirmBtn" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60"><i class="fas fa-check text-xs"></i><span>Confirm and complete</span></button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
  (function () {
    /* Dates in the viewer's own time zone */
    document.querySelectorAll('time[data-dt], time[data-dt-full]').forEach(function (t) {
      var d = new Date(t.getAttribute('datetime')); if (isNaN(d)) return;
      var full = t.hasAttribute('data-dt-full');
      t.textContent = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) + (full ? ', ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '');
      if (!full) t.title = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    });

    var modal = document.getElementById('completeModal'); if (!modal) return;
    var form = document.getElementById('completeForm'), box = document.getElementById('merchantBox'), select = document.getElementById('merchantSelect'),
        discount = document.getElementById('discount'), confirm = document.getElementById('confirmBtn'), TOTAL = <%= total %>;

    function method() { return form.querySelector('input[name="payment_method"]:checked').value; }
    function sync() {
      var lipa = method() === 'LIPA_NUMBER';                       // a merchant account is only needed for Lipa number
      box.classList.toggle('hidden', !lipa);
      if (lipa) select.setAttribute('required', 'required'); else { select.removeAttribute('required'); select.value = ''; }
      var d = Math.min(TOTAL, Math.max(0, parseFloat(discount.value) || 0)), note = document.getElementById('discountNote');
      document.getElementById('dueAmount').textContent = Math.max(0, TOTAL - d).toLocaleString('en-US');
      note.classList.toggle('hidden', d <= 0); note.textContent = d > 0 ? 'After a discount of TSh ' + d.toLocaleString('en-US') : '';
      confirm.disabled = (lipa && select.type === 'hidden') || (parseFloat(discount.value) > TOTAL);   // no accounts to pick, or discount too large
    }
    function open() { form.reset(); sync(); confirm.querySelector('span').textContent = 'Confirm and complete'; modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); form.querySelector('input[name="payment_method"]:checked').focus(); }
    function close() { modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-open-complete]')) { open(); return; }
      if (e.target.closest('[data-close]') || e.target === modal) close();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    form.addEventListener('change', sync); discount.addEventListener('input', sync);
    form.addEventListener('submit', function () { confirm.disabled = true; confirm.querySelector('span').textContent = 'Saving'; });
  })();
</script>

<%- include('../layouts/footer') %>
